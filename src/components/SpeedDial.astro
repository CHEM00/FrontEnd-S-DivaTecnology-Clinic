---
// src/components/SpeedDial.astro
---

<div
    class="fixed bottom-6 right-6 z-[9999] flex flex-col items-end gap-3 group"
    id="speed-dial-container"
>
    <!-- Options (Hidden by default) -->
    <div
        id="speed-dial-options"
        class="flex flex-col gap-3 items-end transition-all duration-300 opacity-0 translate-y-4 pointer-events-none scale-90 origin-bottom-right"
    >
        <!-- Nuevo Paciente -->
        <div class="flex items-center gap-2">
            <span
                class="bg-gray-800 text-white text-xs py-1 px-2 rounded-md shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden sm:block"
                >Nuevo Paciente</span
            >
            <button
                onclick="window.openNewPatientModal()"
                class="w-12 h-12 rounded-full bg-white text-[#2F5D50] border border-[#2F5D50]/20 shadow-lg hover:shadow-xl hover:bg-gray-50 transition-all flex items-center justify-center transform hover:scale-110 active:scale-95"
                title="Nuevo Paciente"
            >
                <i class="fa-solid fa-user-plus text-lg"></i>
            </button>
        </div>

        <!-- Agendar Cita -->
        <div class="flex items-center gap-2">
            <span
                class="bg-gray-800 text-white text-xs py-1 px-2 rounded-md shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden sm:block"
                >Agendar Cita</span
            >
            <button
                onclick="window.openAppointmentModal()"
                class="w-12 h-12 rounded-full bg-white text-[#2F5D50] border border-[#2F5D50]/20 shadow-lg hover:shadow-xl hover:bg-gray-50 transition-all flex items-center justify-center transform hover:scale-110 active:scale-95"
                title="Agendar Cita"
            >
                <i class="fa-regular fa-calendar-plus text-lg"></i>
            </button>
        </div>
    </div>

    <!-- Main Button -->
    <button
        id="speed-dial-toggle"
        class="w-14 h-14 rounded-full bg-[#2F5D50] text-white shadow-lg shadow-[#2F5D50]/40 hover:shadow-2xl hover:bg-[#234D20] transition-all flex items-center justify-center transform hover:scale-105 active:scale-95"
    >
        <i
            class="fa-solid fa-plus text-2xl transition-transform duration-300"
            id="speed-dial-icon"></i>
    </button>
</div>

<script is:inline>
    // Logic for Speed Dial
    const container = document.getElementById("speed-dial-container");
    const toggleBtn = document.getElementById("speed-dial-toggle");
    const options = document.getElementById("speed-dial-options");
    const icon = document.getElementById("speed-dial-icon");
    let isOpen = false;

    if (toggleBtn && options && icon) {
        toggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleSpeedDial();
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (isOpen && !container.contains(e.target)) {
                closeSpeedDial();
            }
        });
    }

    function toggleSpeedDial() {
        isOpen = !isOpen;
        updateState();
    }

    function closeSpeedDial() {
        isOpen = false;
        updateState();
    }

    function updateState() {
        if (isOpen) {
            options.classList.remove(
                "opacity-0",
                "translate-y-4",
                "pointer-events-none",
                "scale-90",
            );
            options.classList.add(
                "opacity-100",
                "translate-y-0",
                "pointer-events-auto",
                "scale-100",
            );
            icon.classList.add("rotate-45");
        } else {
            options.classList.add(
                "opacity-0",
                "translate-y-4",
                "pointer-events-none",
                "scale-90",
            );
            options.classList.remove(
                "opacity-100",
                "translate-y-0",
                "pointer-events-auto",
                "scale-100",
            );
            icon.classList.remove("rotate-45");
        }
    }

    // These functions act as bridges. The actual modals should be exposed globally or handled via events.
    // For now, we'll dispatch custom events that the pages can listen to.

    window.openNewPatientModal = function () {
        window.dispatchEvent(new CustomEvent("open-new-patient-modal"));
        closeSpeedDial();
    };

    window.openAppointmentModal = function () {
        window.dispatchEvent(new CustomEvent("open-new-appointment-modal"));
        closeSpeedDial();
    };
</script>
