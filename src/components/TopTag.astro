---
interface Props {
    titulo?: string;
    nombreUsuario?: string;
}

const { titulo = "Panel", nombreUsuario = "Usuario" } = Astro.props;
---

<div
    class="w-full h-auto min-h-[3.5rem] sm:min-h-[5rem] glass-panel flex flex-col sm:flex-row items-center justify-between px-4 py-3 sm:px-6 sm:py-4 gap-2 sm:gap-4 rounded-b-2xl sm:rounded-b-3xl mb-4 sm:mb-8 border-t-0 shadow-lg z-20 relative"
>
    <div
        class="flex flex-row items-center gap-3 w-full sm:w-auto justify-center sm:justify-start"
    >
        <div
            class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-[#2F5D50]/10 flex items-center justify-center text-[#2F5D50] shadow-sm"
        >
            <i class="fa-solid fa-layer-group text-sm sm:text-xl"></i>
        </div>
        <h1
            class="font-sans text-lg sm:text-2xl text-[#2F5D50] font-bold text-center sm:text-left tracking-tight"
        >
            {titulo}
        </h1>
        <div class="hidden sm:block h-8 w-[1px] bg-[#2F5D50]/20"></div>
    </div>

    <div
        class="flex items-center gap-4 w-full sm:w-auto justify-center sm:justify-end"
    >
        <slot />
    </div>
</div>
