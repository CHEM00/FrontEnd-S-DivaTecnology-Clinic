---
interface Props {
    titulo?: string;
    nombreUsuario?: string;
}

const { titulo = "Panel", nombreUsuario = "Usuario" } = Astro.props;
---

<div
    class="w-full h-auto min-h-[2.5rem] glass-panel flex flex-col sm:flex-row items-center justify-between px-3 py-1 gap-1 rounded-b-lg mb-2 border-t-0 shadow-sm z-20 relative"
>
    <div
        class="flex flex-row items-center gap-2 w-full sm:w-auto justify-center sm:justify-start"
    >
        <h1
            class="font-sans text-sm text-[#2F5D50] font-bold text-center sm:text-left tracking-tight"
        >
            {titulo}
        </h1>
        <div class="hidden sm:block h-4 w-[1px] bg-[#2F5D50]/20"></div>
    </div>

    <div
        class="flex items-center gap-2 w-full sm:w-auto justify-center sm:justify-end scale-90 origin-right"
    >
        <slot />
    </div>
</div>
