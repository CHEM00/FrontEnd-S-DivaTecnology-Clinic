---
// Modal de confirmación genérico (una instancia por página).
// Uso desde el JS de la página:
// window.mostrarConfirmacion({ title, message, confirmText, cancelText,
//     variant: "danger" | "primary", icon: "fa-...", onConfirm: () => {} })
---

<div
	id="modalConfirmacion"
	class="fixed inset-0 z-[10001] hidden"
	role="dialog"
	aria-modal="true"
>
	<div
		class="fixed inset-0 bg-black/40 backdrop-blur-sm transition-opacity"
		data-confirm-cancel
	>
	</div>
	<div class="flex min-h-full items-center justify-center p-4">
		<div
			class="relative transform overflow-hidden rounded-2xl glass-panel text-left shadow-2xl transition-all sm:w-full sm:max-w-md p-6 text-center pointer-events-auto"
		>
			<div
				id="confirmModalIconWrapper"
				class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-red-100 mb-4"
			>
				<i
					id="confirmModalIcon"
					class="fa-solid fa-triangle-exclamation text-3xl text-red-600"
				></i>
			</div>
			<h3 id="confirmModalTitle" class="text-xl font-bold text-gray-900">
			</h3>
			<p id="confirmModalMessage" class="text-sm text-gray-500 mt-2"></p>
			<div class="mt-6 flex gap-3">
				<button
					type="button"
					id="confirmModalCancel"
					class="flex-1 px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium transition-colors"
					data-confirm-cancel>Cancelar</button
				>
				<button
					type="button"
					id="confirmModalAccept"
					class="flex-1 px-4 py-2 rounded-lg text-white font-medium shadow-lg transition-all transform hover:scale-105"
					>Confirmar</button
				>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const modal = document.getElementById("modalConfirmacion");
		if (!modal || window.mostrarConfirmacion) return;

		const VARIANTS = {
			danger: {
				accept: "bg-red-600 hover:bg-red-700 shadow-red-600/30",
				iconWrapper: "bg-red-100",
				icon: "text-red-600",
			},
			primary: {
				accept: "bg-[#2F5D50] hover:bg-[#234D20] shadow-[#2F5D50]/30",
				iconWrapper: "bg-[#2F5D50]/10",
				icon: "text-[#2F5D50]",
			},
		};

		let onConfirm = null;

		const cerrar = () => {
			modal.classList.add("hidden");
			onConfirm = null;
		};

		window.mostrarConfirmacion = (opts = {}) => {
			const variant = VARIANTS[opts.variant] || VARIANTS.danger;
			document.getElementById("confirmModalTitle").textContent =
				opts.title || "Confirmar";
			document.getElementById("confirmModalMessage").textContent =
				opts.message || "";
			document.getElementById("confirmModalIcon").className =
				`fa-solid ${opts.icon || "fa-triangle-exclamation"} text-3xl ${variant.icon}`;
			document.getElementById("confirmModalIconWrapper").className =
				`mx-auto flex h-16 w-16 items-center justify-center rounded-full mb-4 ${variant.iconWrapper}`;
			const accept = document.getElementById("confirmModalAccept");
			accept.className = `flex-1 px-4 py-2 rounded-lg text-white font-medium shadow-lg transition-all transform hover:scale-105 ${variant.accept}`;
			accept.textContent = opts.confirmText || "Confirmar";
			document.getElementById("confirmModalCancel").textContent =
				opts.cancelText || "Cancelar";
			onConfirm =
				typeof opts.onConfirm === "function" ? opts.onConfirm : null;
			modal.classList.remove("hidden");
		};

		document
			.getElementById("confirmModalAccept")
			.addEventListener("click", () => {
				const fn = onConfirm;
				cerrar();
				if (fn) fn();
			});
		modal
			.querySelectorAll("[data-confirm-cancel]")
			.forEach((el) => el.addEventListener("click", cerrar));
	})();
</script>

<style>
	.glass-panel {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.6);
	}
</style>
