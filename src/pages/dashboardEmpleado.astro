                } else {
                    const diag = document.getElementById(
                        "consultationDiagnosis",
                    ) as HTMLInputElement;
                    const note = document.getElementById(
                        "consultationNote",
                    ) as HTMLTextAreaElement;

                    // Always enable if not canceled/no-show (includes concluded)
                    if (diag) diag.disabled = false;
                    if (note) note.disabled = false;
                }

                // Auto-Start
                const serviceName =
                    app.service_name || app.servicio || app.name || "";
                const isValoracion = serviceName
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .includes("valoracion");

                // In case PDF logic is preventing it, we check if it's already signed?
                // User said "if it is a valuation appear the consent... so the patient can sign it".
                // This implies if it's NOT signed, OR maybe always?
                // Usually only if not signed. I'll stick to !hasPDF for now but ensure the Name check is robust.
                const hasPDF = patientDetails?.pdf_path;

                await loadDraft(app.idappointment || app.id);

                if (isValoracion && !hasPDF) {
