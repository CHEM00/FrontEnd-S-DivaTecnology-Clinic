                        historyList.innerHTML = `<div class="text-center py-8 text-gray-400 text-sm flex flex-col items-center gap-2"><i class="fa-regular fa-folder-open text-2xl opacity-50"></i><p>Este paciente no tiene historial registrado.</p></div>`;
