            // Helper to update UI Price immediately
            function updateTotalPriceUI() {
                const priceContainer = document.getElementById(
                    "modalPriceContainer",
                );
                if (!priceContainer) return;

                let basePrice = 0;
                if (
                    currentAppointmentDetails &&
                    currentAppointmentDetails.get_appointment_detail
                ) {
                    const packageInfo =
                        currentAppointmentDetails.get_appointment_detail
                            .package;
                    const services =
                        currentAppointmentDetails.get_appointment_detail
                            .services;

                    if (packageInfo && packageInfo.session_number) {
                        if (packageInfo.session_number === 1) {
                            basePrice = parseFloat(
                                packageInfo.package_price || "0",
                            );
                        } else {
                            basePrice = 0;
                        }
                    } else if (services && Array.isArray(services)) {
                        // Regular Appointment: Sum valid 'service' types
                        services.forEach((srv: any) => {
                            if (srv.type === "service") {
                                basePrice += parseFloat(
                                    srv.value || srv.unit_price || "0",
                                );
                            }
                        });
                    }
                }

                let additionalsPrice = 0;
                const checkedServices = document.querySelectorAll(
                    "input[name='additional_service']:checked",
                );
                checkedServices.forEach((cb: any) => {
                    const price = parseFloat(
                        cb.getAttribute("data-price") || "0",
                    );
                    additionalsPrice += price;
                });

                const total = basePrice + additionalsPrice;

                priceContainer.innerHTML = `
                    <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-tag"></i> Total a Pagar
                    </span>
                    <span class="text-xl font-black text-emerald-700">$${total.toFixed(2)}</span>
                `;
                priceContainer.classList.remove("hidden");
            }

            // Listen to Additionals checkboxes
            const addContainer = document.getElementById(
                "additionalsContainer",
            );
            if (addContainer) {
                addContainer.addEventListener("change", async (e) => {
                    const target = e.target as HTMLInputElement;
                    if (
                        target.tagName === "INPUT" &&
                        target.type === "checkbox"
                    ) {
                        if (!currentAppointment) return;
                        const id = target.value;
                        const price = target.getAttribute("data-price");

                        if (target.checked) {
                            if (
                                !savedAdditionals.has(parseInt(id)) &&
                                !savedAdditionals.has(String(id))
                            ) {
                                // Add Service
                                try {
                                    const serviceResponse = await fetch(
                                        `/api/v1/Agenda/${currentAppointment.idappointment || currentAppointment.id}/services`,
                                        {
                                            method: "POST",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                            body: JSON.stringify({
                                                serviceId: id,
                                                amount: "1",
                                                unit_price: price || "0.00",
                                            }),
                                        },
                                    );
                                    if (serviceResponse.ok) {
                                        savedAdditionals.add(id);
                                        savedAdditionals.add(Number(id));
                                        updateTotalPriceUI(); // Update UI

                                        // Visual feedback
                                        const saveIndicator =
                                            document.getElementById(
                                                "autoSaveIndicator",
                                            );
                                        if (saveIndicator) {
                                            saveIndicator.classList.remove(
                                                "opacity-0",
                                            );
                                            setTimeout(
                                                () =>
                                                    saveIndicator.classList.add(
                                                        "opacity-0",
                                                    ),
                                                2000,
                                            );
                                        }
                                    } else {
                                        console.error(
                                            "Error adding additional",
                                        );
                                        target.checked = false; // Revert
                                        alert(
                                            "Error al guardar adicional. Intente guardar manualmente o contacte soporte.",
                                        );
                                    }
                                } catch (err) {
                                    console.error(err);
                                    target.checked = false;
                                }
                            }
                        } else {
                            // Uncheck attempt -> DELETE Service
                            if (
                                savedAdditionals.has(Number(id)) ||
                                savedAdditionals.has(String(id))
                            ) {
                                try {
                                    // User confirmed behavior: "si lo quito entonces lo elimine con el nuevo endpoint"
                                    const delRes = await fetch(
                                        `/api/v1/Agenda/${currentAppointment.idappointment || currentAppointment.id}/services/${id}`,
                                        {
                                            method: "DELETE",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                        },
                                    );
                                    if (delRes.ok) {
                                        savedAdditionals.delete(Number(id));
                                        savedAdditionals.delete(String(id));
                                        updateTotalPriceUI(); // Update UI
                                        // Visual feedback
                                        const saveIndicator =
                                            document.getElementById(
                                                "autoSaveIndicator",
                                            );
                                        if (saveIndicator) {
                                            saveIndicator.classList.remove(
                                                "opacity-0",
                                            );
                                            setTimeout(
                                                () =>
                                                    saveIndicator.classList.add(
                                                        "opacity-0",
                                                    ),
                                                2000,
                                            );
                                        }
                                    } else {
                                        console.error(
                                            "Error deleting additional",
                                        );
                                        target.checked = true; // Revert
                                        alert(
                                            "Error al eliminar servicio. Intente nuevamente.",
                                        );
                                    }
                                } catch (err) {
                                    console.error(err);
                                    target.checked = true; // Revert
                                    alert("Error de conexión al eliminar.");
                                }
                            }
                        }
                    }
                });
            }

            // Modal Helpers for FormModal transitions
            function showFormModal(modalId: string) {
                const modal = document.getElementById(modalId);
                if (!modal) return;

                modal.classList.remove("hidden");
                // Trigger reflow
                void modal.offsetWidth;

                const content = modal.querySelector(".modal-content-wrapper");
                if (content) {
                    content.classList.remove("scale-95", "opacity-0");
                    content.classList.add("scale-100", "opacity-100");
                }
            }

            function hideFormModal(modalId: string) {
                const modal = document.getElementById(modalId);
                if (!modal) return;

                const content = modal.querySelector(".modal-content-wrapper");
                if (content) {
                    content.classList.remove("scale-100", "opacity-100");
                    content.classList.add("scale-95", "opacity-0");
                }

                if (content) {
                    content.classList.remove("scale-100", "opacity-100");
                    content.classList.add("scale-95", "opacity-0");
                }

                setTimeout(() => {
                    modal.classList.add("hidden");
                }, 300); // Duration match CSS
            }

