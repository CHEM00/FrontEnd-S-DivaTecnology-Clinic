                    // Use backendUrl if using external backend, or relative if proxied.
                    // The dashboard-data element provides backendUrl.
                    // Safety check for URL construction
                    const url = backendUrl.startsWith("http")
                        ? `${backendUrl}/api/v1/HistorialClinico/${patientId}`
                        : `/api/v1/HistorialClinico/${patientId}`;

                    const res = await fetch(url);

                    if (!res.ok) {
                        // If 404, maybe no history
                        if (res.status === 404) {
                            historyList.innerHTML = `<div class="text-center py-8 text-gray-400 text-sm"><p>No se encontró historial clínico.</p></div>`;
                            return;
