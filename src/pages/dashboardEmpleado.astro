            let savedAdditionals = new Set();
            let hasDetails = false;

            async function loadDraft(appointmentId: string) {
                savedAdditionals.clear();
                hasDetails = false;
                // Reset checkboxes
                const checkboxes = document.querySelectorAll(
                    "input[name='additional_service']",
                );
                checkboxes.forEach((cb: any) => (cb.checked = false));

                try {
                    const res = await fetch(`/api/v1/Agenda/${appointmentId}`);
                    if (res.ok) {
                        const data = await res.json();
                        let appData = data;
                        if (appData.body) appData = appData.body;
                        if (Array.isArray(appData)) appData = appData[0];

                        currentAppointmentDetails = appData; // Store globally for saveDraft

                        const diag = document.getElementById(
                            "consultationDiagnosis",
                        ) as HTMLInputElement;
                        const note = document.getElementById(
                            "consultationNote",
                        ) as HTMLTextAreaElement;

                        if (appData && appData.get_appointment_detail?.notes) {
                            hasDetails = true; // Mark as existing
                            const notes = appData.get_appointment_detail.notes;
                            (currentAppointment as any).detailId = notes.id; // Store Detail ID for History Update
                            if (diag) diag.value = notes.diagnostic || "";
                            if (note) note.value = notes.therapeuticnote || "";

                            // --- EVA SCALE PRE-FILL ---
                            const evaInput = document.getElementById(
                                "evaScaleInput",
                            ) as HTMLInputElement;
                            const evaDisplay =
                                document.getElementById("evaScaleDisplay");
                            if (evaInput && evaDisplay) {
                                const painVal = notes.pain_intensity;
                                if (painVal !== null && painVal !== undefined) {
                                    evaInput.value = painVal.toString();
                                    evaDisplay.innerText = painVal.toString();
                                    // Assuming updateEvaColor is defined globally or we define it later
                                    if (
                                        typeof (window as any)
                                            .updateEvaColor === "function"
                                    ) {
                                        (window as any).updateEvaColor(
                                            parseInt(painVal),
                                        );
                                    }
                                } else {
                                    evaInput.value = "0";
                                    evaDisplay.innerText = "0"; // Default
                                    if (
                                        typeof (window as any)
                                            .updateEvaColor === "function"
                                    ) {
                                        (window as any).updateEvaColor(0);
                                    }
                                }
                            }

                            // --- PRICE CALCULATION ---
                            let totalPrice = 0;
                            const services =
                                appData.get_appointment_detail?.services;
                            const packageInfo =
                                appData.get_appointment_detail?.package;

                            if (
                                (services && Array.isArray(services)) ||
                                packageInfo
                            ) {
                                let basePrice = 0;
                                let additionalsPrice = 0;

                                // 1. Determine Base Price (Package vs Regular)
                                if (packageInfo && packageInfo.session_number) {
                                    // Package Logic
                                    if (packageInfo.session_number === 1) {
                                        basePrice = parseFloat(
                                            packageInfo.package_price || 0,
                                        );
                                    } else {
                                        basePrice = 0; // Sessions > 1 are prepaid/free
                                    }
                                } else {
                                    // Regular Appointment Logic (Sum of primary services if no package info)
                                    // However, usually 'services' contains everything.
                                    // If no packageInfo, we sum everything normally.
                                    // But we need to separate this to avoid double counting if logic changes.
                                }

                                // 2. Calculate Services & Additionals
                                if (services && Array.isArray(services)) {
                                    services.forEach((curr: any) => {
                                        const type = (
                                            curr.type || ""
                                        ).toLowerCase();
                                        const val = parseFloat(
                                            curr.unit_price || curr.value || 0,
                                        );

                                        if (packageInfo) {
                                            // Inside a Package Context
                                            if (type === "package_session") {
                                                // Ignore, price handled by basePrice logic above
                                            } else {
                                                // Is Additional
                                                additionalsPrice += val;
                                            }
                                        } else {
                                            // No Package Context -> Sum everything
                                            basePrice += val;
                                        }
                                    });
                                }

                                totalPrice = basePrice + additionalsPrice;
                            }

                            // Display Price Label
                            const priceContainer = document.getElementById(
                                "modalPriceContainer",
                            );
                            if (priceContainer) {
                                priceContainer.innerHTML = `
                                    <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider flex items-center gap-2">
                                        <i class="fa-solid fa-tag"></i> Total a Pagar
                                    </span>
                                    <span class="text-xl font-black text-emerald-700">$${totalPrice.toFixed(2)}</span>
                                `;
                                priceContainer.classList.remove("hidden");
                            }
                        } else {
                            if (currentAppointment)
                                (currentAppointment as any).detailId = null; // Reset
                            hasDetails = false; // Mark as new
                            if (diag) diag.value = "";
                            if (note) note.value = "";

                            // Reset EVA Scale
                            const evaInput = document.getElementById(
                                "evaScaleInput",
                            ) as HTMLInputElement;
                            const evaDisplay =
                                document.getElementById("evaScaleDisplay");
                            if (evaInput && evaDisplay) {
                                evaInput.value = "0";
                                evaDisplay.innerText = "0";
                                // Reset color
                                if (
                                    typeof (window as any).updateEvaColor ===
                                    "function"
                                ) {
                                    (window as any).updateEvaColor(0);
                                }
                            }

                            // Reset Price Label
                            const priceContainer = document.getElementById(
                                "modalPriceContainer",
                            );
                            if (priceContainer)
                                priceContainer.classList.add("hidden");
                        }

                        // Fix: Update Reason from Detail Payload (as requested)
                        if (
                            appData &&
                            appData.get_appointment_detail &&
                            appData.get_appointment_detail.appointment &&
                            appData.get_appointment_detail.appointment.reason
                        ) {
                            const detailReason =
                                appData.get_appointment_detail.appointment
                                    .reason;
                            const reasonEl =
                                document.getElementById("modalReason");
                            if (reasonEl) reasonEl.textContent = detailReason;
                        }

                        // Load Evaluation Data
                        const evaluation =
                            appData.get_appointment_detail?.evaluation;
                        if (evaluation) {
                            const setVal = (id: string, val: any) => {
                                const el = document.getElementById(id) as
                                    | HTMLInputElement
                                    | HTMLTextAreaElement;
                                if (el) el.value = val;
                            };
                            const setCheck = (id: string, val: boolean) => {
                                const el = document.getElementById(
                                    id,
                                ) as HTMLInputElement;
                                if (el) el.checked = val;
                            };

                            setVal(
                                "evalDiagnostic",
                                evaluation.diagnostic || "",
                            );
                            setVal(
                                "evalInjuryMechanism",
                                evaluation.injury_mechanism || "",
                            );
                            setVal(
                                "evalPainOnset",
                                evaluation.pain_onset || "",
                            );
                            setVal(
                                "evalPainIntensity",
                                evaluation.pain_intensity || 0,
                            );
                            setVal(
                                "evalAggravating",
                                evaluation.pain_aggravating_factors || "",
                            );
                            setVal(
                                "evalRelief",
                                evaluation.pain_relief_factors || "",
                            );
                            setCheck(
                                "evalPreviousTherapy",
                                evaluation.previous_therapy || false,
                            );
                            setVal(
                                "evalPreviousReason",
                                evaluation.previous_therapy_reason || "",
                            );
                        } else {
                            // Clear inputs
                            const ids = [
                                "evalDiagnostic",
                                "evalInjuryMechanism",
                                "evalPainOnset",
                                "evalPainIntensity",
                                "evalAggravating",
                                "evalRelief",
                                "evalPreviousReason",
                            ];
                            ids.forEach((id) => {
                                const el = document.getElementById(
                                    id,
                                ) as HTMLInputElement;
                                if (el) el.value = "";
                            });
                            const chk = document.getElementById(
                                "evalPreviousTherapy",
                            ) as HTMLInputElement;
                            if (chk) chk.checked = false;
                        }

                        // Load Additionals (Services)
                        // Corrected path based on user payload
                        const detail = appData.get_appointment_detail;
                        if (
                            detail &&
                            detail.services &&
                            Array.isArray(detail.services)
                        ) {
                            detail.services.forEach((s: any) => {
                                savedAdditionals.add(s.id);
                                savedAdditionals.add(String(s.id));
                                // Find and check the box
                                const cb = document.querySelector(
                                    `input[name='additional_service'][value='${s.id}']`,
                                ) as HTMLInputElement;
                                if (cb) cb.checked = true;
                            });
                        }
                    }
                } catch (e) {
                    console.error(e);
                }
            }

            // --- Quick Photo Upload Logic ---
            const photoModal = document.getElementById("photoActionModal");
            const photoInput = document.getElementById(
                "photoUploadInput",
