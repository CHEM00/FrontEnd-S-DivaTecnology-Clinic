                                        "Notas guardadas. (No se encontró ID de detalle para actualizar historial)",
                                    );
                                }
                            } catch (hErr) {
                                console.error(
                                    "Error in History Sync flow:",
                                    hErr,
                                );
                            }
                        }
                        // FINISH MODE (Original Standard Flow)
                        else {
                            // --- SAFETY VALIDATION: CONSENT (New) ---
                            const serviceNameNorm = (
                                currentAppointment.service_name ||
                                currentAppointment.servicio ||
                                currentAppointment.name ||
                                ""
                            )
                                .normalize("NFD")
                                .replace(/[\u0300-\u036f]/g, "")
                                .toLowerCase();

                            // Use robust checking for "Valoracion"
                            if (serviceNameNorm.includes("valoracion")) {
