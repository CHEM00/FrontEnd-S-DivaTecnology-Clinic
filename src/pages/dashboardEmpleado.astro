                    const json = await res.json();
                    let history = [];

                    if (Array.isArray(json)) {
                        history = json;
                    } else if (json.data && Array.isArray(json.data)) {
                        history = json.data;
                    } else if (
                        json &&
                        typeof json === "object" &&
                        Object.keys(json).length > 0
                    ) {
                        // Handle single object response
                        history = [json];
                    }

