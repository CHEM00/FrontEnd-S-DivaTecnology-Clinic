---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import TopTag from "../components/TopTag.astro";
import FormModal from "../components/modals/FormModal.astro";
import { jwtVerify } from "jose";

const token = Astro.cookies.get("auth_token")?.value;
// NOTA: En producción, usa variables de entorno
const SECRET_KEY = new TextEncoder().encode("secret_dev_key_change_in_prod");

let currentUser = null;

if (token) {
    try {
        const { payload } = await jwtVerify(token, SECRET_KEY);
        currentUser = payload;
    } catch (error) {
        console.error("Error validando sesión:", error);
        return Astro.redirect("/");
    }
} else {
    return Astro.redirect("/");
}

const userName = currentUser
    ? `${currentUser.firstname} ${currentUser.lastname}`
    : "Empleado";
import { SERVER_BACKEND_URL } from "../config";
const userId = currentUser?.id;

const backendUrl = SERVER_BACKEND_URL;
// Re-use headers logic if possible, or create new headers
const headers = {
    "Content-Type": "application/json",
    ...(token && { Cookie: `auth_token=${token}` }),
};

// SSL Agent for Node fetches
const { Agent } = await import("node:https");
const agent = new Agent({ rejectUnauthorized: false });

// Fetch Data for Appointment Modal (Searchable Patient, etc.)
let pacientes = [];
let empleados = [];
let servicios = [];
let paquetes = [];
let adicionales = [];

try {
    const [
        pacientesRes,
        empleadosRes,
        serviciosRes,
        paquetesRes,
        adicionalesRes,
    ] = await Promise.all([
        fetch(`${backendUrl}/api/v1/Pacientes`, { headers, agent } as any).then(
            (res) => (res.ok ? res.json() : []),
        ),
        fetch(`${backendUrl}/api/v1/Agenda/fisio`, {
            headers,
            agent,
        } as any).then((res) => (res.ok ? res.json() : [])),
        fetch(`${backendUrl}/api/v1/Agenda/services`, {
            headers,
            agent,
        } as any).then((res) => (res.ok ? res.json() : [])),
        fetch(`${backendUrl}/api/v1/Package`, { headers, agent } as any).then(
            (res) => (res.ok ? res.json() : []),
        ),
        fetch(`${backendUrl}/api/v1/Product_Service/additional`, {
            headers,
            agent,
        } as any).then((res) => (res.ok ? res.json() : [])),
    ]);

    pacientes = pacientesRes || [];
    empleados = empleadosRes || [];
    servicios = serviciosRes || [];
    paquetes = paquetesRes || [];
    adicionales = adicionalesRes || [];
} catch (error) {
    console.error("Error fetching modal data:", error);
}
---

<Layout title="Dashboard Empleado" showSpeedDial={true}>
    <div
        class="flex h-[100dvh] overflow-hidden bg-gradient-to-br from-[#F0F4F8] via-[#E6F0EA] to-[#F0F4F8]"
    >
        <NavBar />
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
            <!-- Background Elements -->
            <div
                class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-[#2F5D50]/10 rounded-full blur-3xl pointer-events-none"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-5%] w-96 h-96 bg-[#2F5D50]/5 rounded-full blur-3xl pointer-events-none"
            >
            </div>

            <TopTag titulo="Mi Agenda" nombreUsuario={userName} />

            <main
                class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scrollbar-thin scrollbar-thumb-[#2F5D50]/20 scrollbar-track-transparent relative z-10"
            >
                <!-- Grid Principal con mayor separación -->
                <div
                    class="grid grid-cols-1 lg:grid-cols-12 gap-2 lg:h-full h-auto"
                >
                    <!-- Columna Izquierda: Gráficos y Estadísticas (8 columnas) -->
                    <!-- Mobile: Charts second (order-2), Desktop: Charts left (order-1) -->

                    <!-- Columna Derecha: Citas en Curso (4 columnas) -->
                    <!-- Mobile: Agenda first (order-1), Desktop: Agenda right (order-2) -->
                    <div class="lg:col-span-12 h-full min-h-[600px] order-1">
                        <div
                            class="glass-panel rounded-3xl flex flex-col h-full overflow-hidden border border-white/60 !bg-white shadow-xl"
                        >
                            <div
                                <div
                                class="p-2 border-b border-[#2F5D50]/10 bg-white/40 backdrop-blur-md sticky top-0 z-20"
                            >
                                <div class="flex flex-col gap-2">
                                    <div
                                        class="flex justify-between items-center"
                                    >
                                        <!-- Date Navigation -->
                                        <div
                                            class="flex items-center bg-white/80 rounded-lg p-0.5 border border-gray-100 shadow-sm"
                                        >
                                            <button
                                                id="prevDayBtn"
                                                class="w-6 h-6 flex items-center justify-center text-gray-400 hover:text-[#2F5D50] hover:bg-gray-100 rounded-md transition-colors"
                                            >
                                                <i
                                                    class="fa-solid fa-chevron-left text-xs"
                                                ></i>
                                            </button>
                                            <div
                                                class="px-2 text-center min-w-[120px] flex flex-col items-center justify-center leading-none cursor-pointer hover:bg-gray-50 rounded-md transition-colors py-1 group"
                                                id="dateDisplayContainer"
                                                title="Cambiar fecha"
                                            >
                                                <span
                                                    id="currentDateDisplay"
                                                    class="text-xs font-bold text-[#2F5D50] capitalize group-hover:text-[#236c5d] transition-colors"
                                                    >Cargando...</span
                                                >
                                                <input
                                                    type="date"
                                                    id="dateFilter"
                                                    class="absolute w-0 h-0 opacity-0 pointer-events-none bottom-0"
                                                />
                                            </div>
                                            <button
                                                id="nextDayBtn"
                                                class="w-6 h-6 flex items-center justify-center text-gray-400 hover:text-[#2F5D50] hover:bg-gray-100 rounded-md transition-colors"
                                            >
                                                <i
                                                    class="fa-solid fa-chevron-right text-xs"
                                                ></i>
                                            </button>
                                        </div>

                                        <!-- Agenda Link -->
                                        <a
                                            href="/Agenda"
                                            title="Ver Calendario Mensual"
                                            class="w-8 h-8 rounded-lg bg-[#2F5D50]/10 text-[#2F5D50] hover:bg-[#2F5D50] hover:text-white flex items-center justify-center transition-all shadow-sm"
                                        >
                                            <i
                                                class="fa-regular fa-calendar-days text-xs"
                                            ></i>
                                        </a>
                                    </div>

                                    <!-- Search Bar (Compact) -->
                                    <div class="relative group w-full">
                                        <input
                                            type="text"
                                            id="appointment-search-client"
                                            placeholder="Buscar paciente..."
                                            class="w-full glass-input rounded-lg px-2 py-1.5 text-xs font-bold text-gray-700 outline-none focus:ring-1 focus:ring-[#2F5D50]/20 transition-all border border-gray-200/50"
                                        />
                                        <div
                                            class="absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-[#2F5D50] group-hover:scale-110 transition-transform"
                                        >
                                            <i
                                                class="fa-solid fa-magnifying-glass text-[10px]"
                                            ></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar"
                            >
                                <!-- appointmentsGrid now functions as a list container -->
                                <div id="appointmentsGrid" class="space-y-4">
                                    <!-- Content injected via JS -->
                                    <div
                                        class="py-12 flex flex-col items-center justify-center text-gray-400"
                                    >
                                        <i
                                            class="fa-solid fa-circle-notch fa-spin text-4xl mb-4 text-[#2F5D50]"
                                        ></i>
                                        <p>Cargando citas...</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Appointment Detail Modal -->
    <div id="appointmentModal" class="fixed inset-0 z-50 hidden">
        <div
            class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"
            id="modalOverlay"
        >
        </div>
        <div
            class="fixed inset-0 flex items-center justify-center p-4 sm:p-6 z-[60]"
        >
            <div
                class="bg-white rounded-3xl shadow-2xl w-[95%] sm:w-full sm:max-w-lg transform transition-all scale-95 opacity-0 flex flex-col max-h-[90vh] overflow-hidden"
                id="modalContent"
            >
                <!-- Modal Header -->
                <div
                    class="p-6 border-b border-gray-100 flex justify-between items-start bg-[#2F5D50]/5"
                >
                    <div>
                        <h3
                            class="text-lg font-bold text-[#2F5D50]"
                            id="modalPatientName"
                        >
                            Nombre del Paciente
                        </h3>
                        <p
                            class="text-xs text-gray-500 flex items-center gap-2 mt-1"
                        >
                            <i class="fa-regular fa-clock"></i>
                            <span id="modalTimeRange">00:00 - 00:00</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button
                            id="historyBtn"
                            class="px-3 py-1.5 rounded-lg bg-[#2F5D50]/10 text-[#2F5D50] text-sm font-bold hover:bg-[#2F5D50] hover:text-white transition-colors flex items-center gap-2"
                        >
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <span class="hidden sm:inline">Historial</span>
                        </button>
                        <button
                            id="closeModalBtn"
                            class="w-8 h-8 rounded-full bg-white text-gray-400 hover:text-red-500 hover:bg-red-50 flex items-center justify-center transition-all shadow-sm"
                        >
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div
                    class="p-4 sm:p-6 overflow-y-auto space-y-4 sm:space-y-6 flex-1 min-h-0 custom-scrollbar"
                >
                    <!-- Info Cards -->
                    <div class="grid grid-cols-2 gap-4">
                        <div
                            class="bg-blue-50 p-4 rounded-2xl border border-blue-100"
                        >
                            <p
                                class="text-xs text-blue-600 font-bold uppercase mb-1"
                            >
                                Servicio
                            </p>
                            <p
                                class="font-semibold text-gray-800 text-sm"
                                id="modalService"
                            >
                                Valoración
                            </p>
                        </div>
                        <div
                            class="bg-purple-50 p-4 rounded-2xl border border-purple-100"
                        >
                            <p
                                class="text-xs text-purple-600 font-bold uppercase mb-1"
                            >
                                Estado
                            </p>
                            <p
                                class="font-semibold text-gray-800 text-sm capitalize"
                                id="modalStatus"
                            >
                                Pendiente
                            </p>
                        </div>
                    </div>

                    <div
                        class="bg-gray-50 p-4 rounded-2xl border border-gray-100"
                    >
                        <p
                            class="text-xs text-gray-500 font-bold uppercase mb-1"
                        >
                            Motivo de consulta
                        </p>
                        <p class="text-gray-700 text-sm" id="modalReason">
                            Dolor en la espalda baja...
                        </p>
                    </div>

                    <!-- Consultation Fields (Initially Hidden) -->
                    <div id="consultationFields" class="space-y-4 hidden">
                        <!-- New EVA Scale Input (Daily Progress) -->
                        <div
                            id="evaScaleContainer"
                            class="bg-rose-50 p-4 rounded-xl border border-rose-100"
                        >
                            <label
                                class="block text-xs font-bold text-rose-700 uppercase mb-2 flex justify-between"
                            >
                                <span>Escala de Dolor (EVA) - Progreso</span>
                                <span
                                    id="evaScaleDisplay"
                                    class="text-lg font-bold">0</span
                                >
                            </label>
                            <input
                                type="range"
                                id="evaScaleInput"
                                min="0"
                                max="10"
                                value="0"
                                step="1"
                                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-rose-600"
                                oninput="document.getElementById('evaScaleDisplay').innerText = this.value; if(typeof updateEvaColor === 'function') updateEvaColor(this.value);"
                                onchange="if(typeof debouncedSave === 'function') debouncedSave();"
                            />
                            <div
                                class="flex justify-between text-[10px] text-gray-500 mt-1 font-bold uppercase"
                            >
                                <span>Sin Dolor</span>
                                <span>Moderado</span>
                                <span>Peor Dolor</span>
                            </div>
                        </div>
                        <div
                            id="diagnosisContainer"
                            class="bg-yellow-50 p-4 rounded-2xl border border-yellow-100 hidden"
                        >
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Diagnóstico Detallado</label
                                    >
                                    <textarea
                                        id="evalDiagnostic"
                                        rows="2"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="Diagnóstico detallado..."
                                    ></textarea>
                                </div>

                                <div>
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Mecanismo de Lesión</label
                                    >
                                    <input
                                        type="text"
                                        id="evalInjuryMechanism"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="¿Cómo ocurrió?"
                                    />
                                </div>

                                <div>
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Inicio del Dolor</label
                                    >
                                    <input
                                        type="text"
                                        id="evalPainOnset"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="¿Cuándo empezó?"
                                    />
                                </div>

                                <div>
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Intensidad del Dolor (1-10)</label
                                    >
                                    <input
                                        type="number"
                                        id="evalPainIntensity"
                                        min="1"
                                        max="10"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="1-10"
                                    />
                                </div>

                                <div>
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Factores Agravantes</label
                                    >
                                    <input
                                        type="text"
                                        id="evalAggravating"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="¿Qué lo empeora?"
                                    />
                                </div>

                                <div>
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Factores de Alivio</label
                                    >
                                    <input
                                        type="text"
                                        id="evalRelief"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="¿Qué lo mejora?"
                                    />
                                </div>

                                <div class="flex items-center gap-2 pt-6">
                                    <input
                                        type="checkbox"
                                        id="evalPreviousTherapy"
                                        class="w-4 h-4 text-yellow-600 rounded focus:ring-yellow-500 border-gray-300"
                                    />
                                    <label
                                        for="evalPreviousTherapy"
                                        class="text-sm font-bold text-yellow-700 select-none cursor-pointer"
                                        >¿Terapia Previa?</label
                                    >
                                </div>

                                <div class="md:col-span-2">
                                    <label
                                        class="block text-xs font-bold text-yellow-700 uppercase mb-2"
                                        >Razón de Terapia Previa</label
                                    >
                                    <input
                                        type="text"
                                        id="evalPreviousReason"
                                        class="w-full bg-white border border-yellow-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500/20 outline-none"
                                        placeholder="Si hubo terapia, ¿por qué? (Opcional)"
                                    />
                                </div>
                            </div>
                            <!-- Hidden Legacy Input to prevent JS errors if referenced elsewhere (optional, but safe) -->
                            <input type="hidden" id="consultationDiagnosis" />
                        </div>
                        <div
                            class="bg-green-50 p-4 rounded-2xl border border-green-100"
                        >
                            <label
                                class="block text-xs font-bold text-green-700 uppercase mb-2"
                                >Nota Terapéutica</label
                            >
                            <textarea
                                id="consultationNote"
                                rows="4"
                                class="w-full bg-white border border-green-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-green-500/20 outline-none"
                                placeholder="Evolución, tratamiento aplicado..."
                            ></textarea>
                        </div>

                        <!-- Additionals Section -->
                        <div
                            class="bg-indigo-50 p-4 rounded-2xl border border-indigo-100"
                        >
                            <label
                                class="block text-xs font-bold text-indigo-700 uppercase mb-2"
                                >Adicionales</label
                            >
                            <div id="additionalsContainer" class="space-y-2">
                                <div
                                    class="w-full bg-white border border-indigo-200 rounded-xl px-3 py-2 text-sm max-h-40 overflow-y-auto custom-scrollbar"
                                >
                                    {
                                        adicionales.length > 0 ? (
                                            adicionales.map(
                                                (adicional: any) => (
                                                    <label class="flex items-center gap-2 p-2 hover:bg-indigo-50 rounded-lg cursor-pointer transition-colors border-b border-gray-50 last:border-0">
                                                        <input
                                                            type="checkbox"
                                                            value={adicional.id}
                                                            data-price={
                                                                adicional.value
                                                            }
                                                            name="additional_service"
                                                            class="w-4 h-4 rounded text-[#2F5D50] focus:ring-[#2F5D50] border-gray-300"
                                                        />
                                                        <div class="flex flex-col">
                                                            <span class="font-medium text-gray-700 text-xs">
                                                                {adicional.name}
                                                            </span>
                                                            <span class="text-[10px] text-gray-500 font-bold">
                                                                $
                                                                {
                                                                    adicional.value
                                                                }
                                                            </span>
                                                        </div>
                                                    </label>
                                                ),
                                            )
                                        ) : (
                                            <p class="text-xs text-gray-400 italic text-center py-2">
                                                No hay adicionales disponibles
                                            </p>
                                        )
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Price Container (Moved to Main Body) -->
                        <div
                            id="modalPriceContainer"
                            class="hidden w-full bg-emerald-50 p-4 rounded-xl border border-emerald-100 flex justify-between items-center shadow-sm mt-4"
                        >
                            <span
                                class="text-xs font-bold text-emerald-600 uppercase tracking-wider flex items-center gap-2"
                            >
                                <i class="fa-solid fa-tag"></i> Total a Pagar
                            </span>
                            <span class="text-xl font-black text-emerald-700"
                                >$0.00</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Consent Toggle for Valuation -->
                <div id="consentToggleContainer" class="hidden mb-4 mt-6">
                    <div
                        class="bg-yellow-50 p-4 rounded-2xl border border-yellow-100 flex items-center justify-between"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600"
                            >
                                <i class="fa-solid fa-file-signature"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 text-sm">
                                    Consentimiento Informado
                                </h4>
                                <p class="text-xs text-gray-500">
                                    Requerido para valoración
                                </p>
                            </div>
                        </div>
                        <button
                            id="toggleConsentBtn"
                            type="button"
                            class="px-4 py-2 rounded-xl bg-white text-yellow-700 text-sm font-bold shadow-sm hover:shadow-md transition-all flex items-center gap-2 border border-yellow-100"
                        >
                            <span>Mostrar</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                    </div>
                </div>

                <!-- Consent & Signature Section (Document View) -->
                <div
                    id="consentSection"
                    class="hidden flex flex-col h-full mb-4"
                >
                    <div class="flex justify-between items-center mb-2 px-1">
                        <h4 class="font-bold text-gray-800 text-sm">
                            Revisión de Documento
                        </h4>
                        <button
                            id="clearSignatureBtn"
                            class="text-xs text-red-500 hover:text-red-700 font-medium underline"
                        >
                            Limpiar firma
                        </button>
                    </div>

                    <!-- Document Container (Scrollable Paper) -->
                    <div
                        class="bg-white border border-gray-200 shadow-inner rounded-sm p-8 overflow-y-auto custom-scrollbar flex-1 text-gray-800 font-serif text-xs leading-relaxed select-none"
                        style="max-height: 500px;"
                    >
                        <h2
                            class="font-bold text-center text-sm mb-6 uppercase"
                        >
                            Documento de Consentimiento Informado y Terminos del
                            Servicio
                        </h2>

                        <p class="mb-4">
                            <strong>Clínica:</strong> JessTherapy<br />
                            <strong>Responsable sanitario:</strong>
                            {userName}
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
                            1. DECLARACIÓN DEL PACIENTE
                        </h3>
                        <p class="mb-3 text-justify">
                            Yo, <span
                                id="docPatientName"
                                class="font-bold bg-yellow-100 px-1"
                                >[Nombre Paciente]</span
                            >, declaro que he solicitado servicios de
                            fisioterapia en JessTherapy. Entiendo que la
                            fisioterapia implica el uso de medios físicos,
                            terapia manual, terapia invasiva, ondas de choque,
                            ejercicio terapéutico y/o agentes electrofísicos.
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
                            2. EXPLICACIÓN DEL PROCEDIMIENTO
                        </h3>
                        <p class="mb-3 text-justify">
                            Se me ha informado que, tras una valoración puede
                            incluir: movilizaciones, masoterapia,
                            electroterapia, ultrasonido, láser, terapia
                            invasiva, ondas de choque, termoterapia y ejercicio
                            terapéutico.
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
                            3. RIESGOS Y BENEFICIOS
                        </h3>
                        <p class="mb-3 text-justify">
                            Entiendo los riesgos inherentes (dolor muscular
                            temporal, hematomas leves, irritación cutánea) y los
                            beneficios esperados (mejora funcional, disminución
                            del dolor).
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
                            4. REVOCACIÓN Y DERECHOS
                        </h3>
                        <p class="mb-3 text-justify">
                            Entiendo que puedo revocar este consentimiento
                            médico en cualquier momento, deteniendo el
                            tratamiento clínico sin que ello afecte a mi
                            atención futura.
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
                            5. PROTECCIÓN DE DATOS
                        </h3>
                        <p class="mb-3 text-justify">
                            Autorizo el tratamiento de mis datos personales y de
                            salud con fines asistenciales y administrativos
                            conforme a la ley vigente.
                        </p>

                        <h3 class="font-bold mt-4 mb-1">
