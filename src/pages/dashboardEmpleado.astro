            // Auto-Save Logic
            function debounce(func: Function, wait: number) {
                let timeout: any;
                return function (...args: any[]) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func(...args), wait);
                };
            }

            async function saveDraft() {
                if (!currentAppointment) return { success: false };

                const diagElem = document.getElementById(
                    "consultationDiagnosis",
                ) as HTMLInputElement;
                const noteElem = document.getElementById(
                    "consultationNote",
                ) as HTMLTextAreaElement;

                // Get EVA Value (Robust lookup for duplicates)
                let evaInput = document.getElementById(
                    "evaScaleInput",
                ) as HTMLInputElement;

                // Safety check for duplicates (e.g. if mistakenly rendered twice)
                const allEvas = document.querySelectorAll("#evaScaleInput");
                if (allEvas.length > 1) {
                    for (let i = 0; i < allEvas.length; i++) {
                        const el = allEvas[i] as HTMLElement;
                        // Select the visible one (closest to user interaction)
                        if (el.offsetParent !== null) {
                            evaInput = el as HTMLInputElement;
                            break;
                        }
                    }
                }

                let pain_intensity = evaInput ? parseInt(evaInput.value) : null;

                // If EVA container is hidden (Valoración), use the specific valuation pain intensity input
                const evaContainer =
                    document.getElementById("evaScaleContainer");
                if (evaContainer && evaContainer.classList.contains("hidden")) {
                    const evalPainInput = document.getElementById(
                        "evalPainIntensity",
                    ) as HTMLInputElement;
                    if (evalPainInput && evalPainInput.value) {
                        pain_intensity = parseInt(evalPainInput.value);
                    } else {
                        pain_intensity = null;
                    }
                }

                let detailId = null;

                // --- Calculate Total for Payload ---
                let total = 0;

                // 1. Base Price (Package Logic)
                let basePrice = 0;
                if (
                    currentAppointmentDetails &&
                    currentAppointmentDetails.get_appointment_detail
                ) {
                    const packageInfo =
                        currentAppointmentDetails.get_appointment_detail
                            .package;
                    const services =
                        currentAppointmentDetails.get_appointment_detail
                            .services;

                    if (packageInfo && packageInfo.session_number) {
                        if (packageInfo.session_number === 1) {
                            basePrice = parseFloat(
                                packageInfo.package_price || 0,
                            );
                        } else {
                            basePrice = 0;
                        }
                    } else if (services && Array.isArray(services)) {
                        // Regular Appointment: Sum valid 'service' types
                        services.forEach((srv: any) => {
                            if (srv.type === "service") {
                                basePrice += parseFloat(
                                    srv.value || srv.unit_price || 0,
                                );
                            }
                        });
                    }
                }

                // 2. Additionals Price (From Live DOM)
                let additionalsPrice = 0;
                const checkedServices = document.querySelectorAll(
                    "input[name='additional_service']:checked",
                );
                checkedServices.forEach((cb: any) => {
                    const price = parseFloat(
                        cb.getAttribute("data-price") || "0",
                    );
                    additionalsPrice += price;
                });

                total = basePrice + additionalsPrice;

                try {
                    if (hasDetails) {
                        const res = await fetch(
                            `/api/v1/Citas/detalle/${currentAppointment.idappointment || currentAppointment.id}`,
                            {
                                method: "PATCH",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    therapeuticnote: noteElem?.value || "",
                                    pain_intensity: pain_intensity,
                                    total: total,
                                }),
                            },
                        );
                        if (!res.ok) throw new Error("Failed to patch detail");
                        // Try to get ID from response if available, otherwise we might validly lack it if backend doesn't return it
                        try {
                            const data = await res.json();
                            detailId = data.id || data.iddetailappointment; // Adjust based on actual response
                        } catch (e) {}
                    } else {
                        const payload = {
                            therapeuticnote: noteElem?.value || "",
                            pain_intensity: pain_intensity,
                            total: total,
                        };

                        let res = await fetch(
                            `/api/v1/Citas/detalle/${currentAppointment.idappointment || currentAppointment.id}`,
                            {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(payload),
                            },
                        );

                        // Fallback for Duplicate/Conflict (409) or "Already Exists"
                        if (
                            res.status === 409 ||
                            (res.status !== 200 && res.status !== 201)
                        ) {
                            const errText = await res.text();
                            if (
                                res.status === 409 ||
                                errText.includes("already exists") ||
                                errText.includes("duplicate")
                            ) {
                                console.warn(
                                    "Detail already exists (Backend conflict), switching to PATCH...",
                                );
                                hasDetails = true; // Correct state

                                // Retry as PATCH
                                res = await fetch(
                                    `/api/v1/Citas/detalle/${currentAppointment.idappointment || currentAppointment.id}`,
                                    {
                                        method: "PATCH",
                                        headers: {
                                            "Content-Type": "application/json",
                                        },
                                        body: JSON.stringify(payload),
                                    },
                                );
                            } else {
                                // Real Error (not conflict)
                                throw new Error(
                                    "Failed to post detail: " + errText,
                                );
                            }
                        }

                        if (res.ok) {
                            hasDetails = true;
                            const data = await res.json();
                            detailId =
                                data.id ||
                                data.insertId ||
                                (data.data && data.data.id);

                            // If PATCH returns success but no ID (sometimes happens), try to keep existing logic
                            // But usually PATCH returns the updated record or success.
                        } else {
                            const errText = await res.text();
                            console.error("Server Error Response:", errText);
                            throw new Error(
                                "Failed to save detail (Retry failed): " +
                                    errText,
                            );
                        }
                    }

                    // --- Auto-Save Evaluation (PATCH) if Valoración ---
                    try {
                        const serviceNameNorm = (
