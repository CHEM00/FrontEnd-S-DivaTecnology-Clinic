                              app.name ||
                              app.servicio ||
                              "Consulta";
                    document.getElementById("modalService")!.textContent =
                        serviceName;
                }

                if (document.getElementById("modalStatus")) {
                    const statusMap: any = {
                        wait: "En espera",
                        confirmed: "Confirmada",
                        canceled: "Cancelada",
                        concluded: "Concluida",
                        "no assisted": "No asistió",
                        pending: "Pendiente",
                    };
                    const rawStatus = (app.status || "").toLowerCase();
                    document.getElementById("modalStatus")!.textContent =
                        statusMap[rawStatus] || app.status;
                }

                if (document.getElementById("modalReason"))
                    document.getElementById("modalReason")!.textContent =
                        app.reason;

                if (document.getElementById("docPatientName"))
                    document.getElementById("docPatientName")!.textContent =
                        app.patient_name || app.nombre_paciente || "Paciente";

                if (document.getElementById("docDate"))
                    document.getElementById("docDate")!.textContent =
                        new Date().toLocaleDateString();

                // History Button Logic
                if (historyBtn) {
                    historyBtn.onclick = () => {
                        if (historyOverlay)
                            historyOverlay.classList.remove("hidden");
                        loadHistory(app.idpatient);
                    };
                }

                // UI Reset
                if (modal) modal.classList.remove("hidden");
                setTimeout(() => {
                    if (modalContent) {
                        modalContent.classList.remove("scale-95", "opacity-0");
                        modalContent.classList.add("scale-100", "opacity-100");
                    }
                }, 10);

                // Hide all sections first
                const hideIds = [
                    startBtn,
                    confirmSignBtn,
                    consentSection,
                    consultationFields,

                    finishBtn,
                    pdfPreview,
                    errorMsg,
                ];
                hideIds.forEach((el) => el?.classList.add("hidden"));

                // Ensure Toggle is hidden initially
                const consentToggleContainer = document.getElementById(
                    "consentToggleContainer",
                );
                if (consentToggleContainer)
                    consentToggleContainer.classList.add("hidden");

                if (initialsInput) initialsInput.value = "";
                const statusLower = app.status ? app.status.toLowerCase() : "";

                // Check Status (For Read-Only modes)
                // We EXCLUDE 'concluded' here because we want to allow editing (Update Mode)
                if (
                    ["canceled", "no assisted", "no asistio"].includes(
                        statusLower,
                    )
                ) {
                    if (errorMsg) {
                        errorMsg.textContent = `Consulta ${app.status}`;
                        errorMsg.classList.remove("hidden");
                    }
                    loadDraft(app.id);
                    if (consultationFields)
                        consultationFields.classList.remove("hidden");
                    const diag = document.getElementById(
                        "consultationDiagnosis",
                    ) as HTMLInputElement;
                    const note = document.getElementById(
                        "consultationNote",
                    ) as HTMLTextAreaElement;
