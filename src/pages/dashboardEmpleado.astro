    <!-- MAIN SCRIPT -->
    <script>
        import { generateConsentPDF } from "../utils/ConsentPDFGenerator";

        // Types
        interface Appointment {
            id: string;
            status: string;
            nombre_paciente: string;
            inithour: string;
            endhour: string;
            idservice: string | number;
            servicio: string;
            reason: string;
            currentday: string;
            idpatient: string;
            service_name?: string;
            [key: string]: any;
        }

        document.addEventListener("DOMContentLoaded", () => {
            // 1. Data & Elements
            const dataEl = document.getElementById("dashboard-data");
            const userId = dataEl?.dataset.userId;
            const userName = dataEl?.dataset.userName;
            const backendUrl =
                dataEl?.dataset.backendUrl || "http://localhost:3000";

            const dateInput = document.getElementById(
                "dateFilter",
            ) as HTMLInputElement;
            const grid = document.getElementById(
                "appointmentsGrid",
            ) as HTMLElement;

            // Date Interaction
            const dateDisplayContainer = document.getElementById(
                "dateDisplayContainer",
            );
            if (dateDisplayContainer && dateInput) {
                dateDisplayContainer.addEventListener("click", () => {
                    if (typeof dateInput.showPicker === "function") {
                        try {
                            dateInput.showPicker();
                        } catch (e) {
                            console.warn("showPicker failed", e);
                            dateInput.click();
                        }
                    } else {
                        dateInput.click();
                    }
                });
            }

            // Modal
            const modal = document.getElementById(
                "appointmentModal",
            ) as HTMLElement;
            const modalContent = document.getElementById(
                "modalContent",
            ) as HTMLElement;
            const modalOverlay = document.getElementById(
                "modalOverlay",
            ) as HTMLElement;
            const closeModalBtn = document.getElementById(
                "closeModalBtn",
            ) as HTMLElement;

            // Sections
            const startBtn = document.getElementById(
                "startConsultationBtn",
            ) as HTMLButtonElement;
            const confirmSignBtn = document.getElementById(
                "confirmSignatureBtn",
            ) as HTMLElement;

            const finishBtn = document.getElementById(
                "finishConsultationBtn",
            ) as HTMLButtonElement;
            const consentSection = document.getElementById(
                "consentSection",
            ) as HTMLElement;
            const consultationFields = document.getElementById(
                "consultationFields",
            ) as HTMLElement;
            const initialsInput = document.getElementById(
                "patientInitials",
            ) as HTMLInputElement;
            const errorMsg = document.getElementById(
                "timeValidationError",
            ) as HTMLElement;
            const pdfPreview = document.getElementById(
                "pdfPreview",
            ) as HTMLElement;

            // Signature
            const canvas = document.getElementById(
                "signatureCanvas",
            ) as HTMLCanvasElement;
            const clearBtn = document.getElementById(
                "clearSignatureBtn",
            ) as HTMLElement;
            const placeholder = document.getElementById(
                "signaturePlaceholder",
            ) as HTMLElement;

            // History
            const historyOverlay = document.getElementById("historyOverlay");
            const historyBtn = document.getElementById("historyBtn");
            const closeHistoryBtn = document.getElementById("closeHistoryBtn");
            const historyList = document.getElementById("historyList");

            // State
            let isEditMode = false;
            let editingAppointmentId: string | null = null;
            let isDrawing = false;
            let currentAppointment: Appointment | null = null;
            let patientDetails: any = null;
            let currentPdfBlob: Blob | null = null;
            let ctx: CanvasRenderingContext2D | null = null;

            // ... (keep existing elements) ...

            // --- INICIAR EDICIÓN (Full Modal) ---
            function iniciarEdicion(app: Appointment) {
                isEditMode = true;
                editingAppointmentId = String(app.idappointment || app.id);

                // 1. Update Modal Title & Button
                const modalTitle = document.querySelector(
                    "#modalAgregarCita h2",
                );
                if (modalTitle) modalTitle.textContent = "EDITAR CITA";
                const submitBtn = document.querySelector(
                    "#formAgregarCita button[type='submit']",
                );
                if (submitBtn) submitBtn.textContent = "ACTUALIZAR";

                // 2. Pre-fill Fields
                const idPatientEl = document.getElementById(
                    "agregarIdPatient",
                ) as HTMLInputElement;
                const searchInput = document.getElementById(
                    "patientSearchInput",
                ) as HTMLInputElement;
                const currentDayEl = document.getElementById(
                    "agregarCurrentday",
                ) as HTMLInputElement;
                const idEmployedEl = document.getElementById(
                    "agregarIdEmployed",
                ) as HTMLSelectElement;
                const statusEl = document.getElementById(
                    "agregarStatus",
                ) as HTMLSelectElement;
                const reasonEl = document.getElementById(
                    "agregarReason",
                ) as HTMLInputElement;
                const serviceSelect = document.getElementById(
                    "agregarIdService",
                ) as HTMLSelectElement;
                const initHourEl = document.getElementById(
                    "agregarInitHour",
                ) as HTMLSelectElement;

                // Patient
                if (idPatientEl) idPatientEl.value = app.idpatient || "";
                // Note: We might not have patient name here if 'app' doesn't contain it fully formatted.
                // Using app.patient_name from card data if available.
                if (searchInput)
                    searchInput.value =
                        app.patient_name || app.nombre_paciente || "";

                // Date
                if (currentDayEl && app.currentday) {
                    // Ensure YYYY-MM-DD
                    currentDayEl.value = app.currentday.substring(0, 10);
                }

                // Employed
                // Employed (Reverse Lookup if ID missing)
                if (idEmployedEl) {
                    if (app.idemployed) {
                        idEmployedEl.value = String(app.idemployed);
                    } else if (app.employed_name) {
                        // Try to find ID by name
                        const allEmps = (window as any).empleadosData || [];
                        const foundEmp = allEmps.find(
                            (e: any) =>
                                (e.firstname + " " + e.lastname)
                                    .trim()
                                    .toLowerCase() ===
                                    app.employed_name.trim().toLowerCase() ||
                                e.firstname.trim().toLowerCase() ===
                                    app.employed_name.trim().toLowerCase(),
                        );
                        if (foundEmp) idEmployedEl.value = String(foundEmp.id);
                    }
                }

                // Status
                if (statusEl && app.status) statusEl.value = app.status;

                // Reason
                if (reasonEl) reasonEl.value = app.reason || "";

                // Service (Robust Selection)
                const sId = app.idservice || app.service_id;
                let serviceFound = false;

                if (serviceSelect) {
                    // 1. Try direct ID match
                    if (sId) {
                        serviceSelect.value = String(sId);
                        if (
                            serviceSelect.selectedIndex >= 0 &&
                            serviceSelect.value === String(sId)
                        ) {
                            serviceFound = true;
                        }
                    }

                    // 2. Fallback: Name Match
                    if (!serviceFound) {
                        const targetName = (
                            app.service_name ||
                            app.servicio ||
                            app.name ||
                            ""
                        )
                            .toLowerCase()
                            .trim();
                        // Sometimes 'app.name' holds the service name
                        if (targetName) {
                            for (
                                let i = 0;
                                i < serviceSelect.options.length;
                                i++
                            ) {
                                const opt = serviceSelect.options[i];
                                const optText = opt.text.toLowerCase().trim();
                                // Loose match
                                if (
                                    optText.includes(targetName) ||
                                    targetName.includes(optText)
                                ) {
                                    serviceSelect.selectedIndex = i;
                                    serviceFound = true;
                                    break;
                                }
                            }
                        }
                    }

                    if (serviceFound) {
                        serviceSelect.dispatchEvent(new Event("change"));
                    }
                }

                // Package Population
                const packageSelect = document.getElementById(
                    "agregarIdPackage",
                ) as HTMLSelectElement;
                if (packageSelect) {
                    if (app.idpackage) {
                        packageSelect.value = String(app.idpackage);
                        // Trigger UI Change
                        if (typeof handlePackageUI === "function")
                            handlePackageUI(true);
                        // Should we hide service? Yes if mutually exclusive
                        if (serviceSelect) serviceSelect.value = "";
                    } else {
                        packageSelect.value = "";
                        if (typeof handlePackageUI === "function")
                            handlePackageUI(false);
                    }
                }

                // Time (Complex part: needs to fetch available slots OR just inject the current time as a valid option)
                // Since this is editing, we should likely just Set the value if it exists in the list (already fetched?)
                // OR we have to allow the user to keep the current time even if "taken" (by self).
                // Simplification for now: Set value, user changes if needed.
                // Note: The helper 'updateHours' (if ported) would handle fetching.
                // If we don't fetch, the select might be empty.
                // We should probably rely on user interaction or trigger a fetch.
                // Triggering fetch logic:
                if (currentDayEl && idEmployedEl) {
                    // Manually trigger slot fetch, then select (async issue).
                    // Ideally, we just open the modal. User re-selects if changing date/time.
                    // To preserve current time display:
                    if (initHourEl && app.inithour) {
                        const time = app.inithour.substring(0, 5);
                        // Check if option exists
                        let exists = false;
                        for (let i = 0; i < initHourEl.options.length; i++) {
                            if (initHourEl.options[i].value === time)
                                exists = true;
                        }
                        if (!exists) {
                            const opt = document.createElement("option");
                            opt.value = time;
                            opt.textContent = time;
                            initHourEl.appendChild(opt);
                        }
                        initHourEl.value = time;
                        initHourEl.disabled = false;

                        // Update End Hour
                        const endHourEl = document.getElementById(
                            "agregarEndHour",
                        ) as HTMLInputElement;
                        if (endHourEl && app.endhour)
                            endHourEl.value = app.endhour.substring(0, 5);
                    }
                }

                // Show Modal
                showFormModal("modalAgregarCita");

                // Store Edit ID on form for robustness
                const form = document.getElementById("formAgregarCita");
                if (form) {
                    form.setAttribute(
                        "data-edit-id",
                        String(app.idappointment || app.id),
                    );
                    form.setAttribute(
                        "data-original-service-id",
                        String(sId || ""),
                    );
                }
            }

            // --- New Appointment Logic (Updated for Edit) ---
            const formAgregarCita = document.getElementById("formAgregarCita");
            if (formAgregarCita) {
                // Reset state on close? Handled by hidden listener usually, or manual reset.
                // We'll add a 'reset' listener to form to clear global state.
                formAgregarCita.addEventListener("reset", () => {
                    setTimeout(() => {
                        editingAppointmentId = null;
                        formAgregarCita.removeAttribute("data-edit-id"); // Clear Edit ID
                        formAgregarCita.removeAttribute(
                            "data-original-service-id",
                        ); // Clear Original Service ID

                        const modalTitle = document.querySelector(
                            "#modalAgregarCita h2",
                        );
                        if (modalTitle) modalTitle.textContent = "NUEVA CITA";
                        const submitBtn = document.querySelector(
                            "#formAgregarCita button[type='submit']",
                        );
                        if (submitBtn) submitBtn.textContent = "GUARDAR";

                        // Reset Package UI
                        if (typeof handlePackageUI === "function")
                            handlePackageUI(false);
                    }, 0);
                });

                formAgregarCita.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    const currentday = (
                        document.getElementById(
                            "agregarCurrentday",
                        ) as HTMLInputElement
                    ).value;
                    const inithour = (
                        document.getElementById(
                            "agregarInitHour",
                        ) as HTMLSelectElement
                    ).value;
                    const endhour = (
                        document.getElementById(
                            "agregarEndHour",
                        ) as HTMLInputElement
                    ).value;
                    const reason = (
                        document.getElementById(
                            "agregarReason",
                        ) as HTMLInputElement
                    ).value;
                    const status = (
                        document.getElementById(
                            "agregarStatus",
                        ) as HTMLSelectElement
                    ).value;
                    const idpatient = (
                        document.getElementById(
                            "agregarIdPatient",
                        ) as HTMLInputElement
                    ).value;
                    const idemployed = (
                        document.getElementById(
                            "agregarIdEmployed",
                        ) as HTMLSelectElement
                    ).value;
                    const idservice = (
                        document.getElementById(
                            "agregarIdService",
                        ) as HTMLSelectElement
                    ).value;
                    const idPackage = (
                        document.getElementById(
                            "agregarIdPackage",
                        ) as HTMLSelectElement
                    ).value;

                    if (
                        !currentday ||
                        !inithour ||
                        !idpatient ||
                        // !idemployed || // Physio optional
                        !status
                    ) {
                        alert("Por favor complete los campos obligatorios");
                        return;
                    }

                    try {
                        // Check attribute for robust edit detection
                        const editId =
                            formAgregarCita.getAttribute("data-edit-id");

                        // Auto-assign Random Physio if missing
                        let finalPhysioId = idemployed;
                        if (!finalPhysioId) {
                            // Try to find in cached slots
                            const matchingSlot = latestSlots.find(
                                (s: any) =>
                                    s.inithour.substring(0, 5) === inithour,
                            );
                            if (matchingSlot && matchingSlot.random_physio_id) {
                                finalPhysioId = matchingSlot.random_physio_id;
                            } else {
                                // Fallback? Or maybe user is using extended hours where no slots are fetched?
                                // If extended hours, we don't have random physio logic defined by user.
                                // But if standard flow, we should have it.
                            }
                        }

                        const payload: any = {
                            currentday,
                            inithour,
                            endhour: endhour || inithour,
                            reason,
                            status,
                            idpatient,
                            idemployed: finalPhysioId || null,
                        };

                        // Logic: Consume Existing Package Session
                        const usePackageCheckbox = document.getElementById(
                            "usePackageCheckbox",
                        ) as HTMLInputElement;
                        if (
                            !editId &&
                            usePackageCheckbox &&
                            usePackageCheckbox.checked
                        ) {
                            if (idPackage) {
                                alert(
                                    "No puedes comprar un paquete nuevo y usar uno existente al mismo tiempo.",
                                );
                                return;
                            }
                            // Fix: Fetch patient details to get package ID without consuming
                            // Fix: Fetch active package details to get ID
                            try {
                                const pkgRes = await fetch(
                                    `${backendUrl}/api/v1/Pacientes/${idpatient}/paquete/activo`,
                                );
                                if (pkgRes.ok) {
                                    const pkgData = await pkgRes.json();
                                    // User confirmed: "se toma el id solamente y es el que se manda en el payload"
                                    if (pkgData && pkgData.id) {
                                        payload.idpatientpackage = pkgData.id;
                                        console.log(
                                            "Paquete activo encontrado, ID asignado:",
                                            pkgData.id,
                                        );
                                    } else {
                                        console.warn(
                                            "El endpoint retornó OK pero sin ID válido:",
                                            pkgData,
                                        );
                                    }
                                } else {
                                    console.error(
                                        "Error fetching active package:",
                                        pkgRes.status,
                                    );
                                    // Optional: Alert user if package was expected but not found?
                                    // For now, logging error.
                                }
                            } catch (e) {
                                console.error(
                                    "Error fetching active package details",
                                    e,
                                );
                            }
                        }

                        // Handle Package Assignment FIRST (if new appointment and package selected)
                        if (!editId && idPackage) {
                            try {
                                // Find package data to get total sessions
                                const allPackages =
                                    (window as any).paquetesData || [];
                                const selectedPkg = allPackages.find(
                                    (p: any) =>
                                        String(p.id) === String(idPackage),
                                );
                                const totalSessions = selectedPkg
                                    ? selectedPkg.numsession
                                    : 1;

                                const pkgRes = await fetch(
                                    `/api/v1/Pacientes/${idpatient}/paquete`,
                                    {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/json",
                                        },
                                        body: JSON.stringify({
                                            idpackage: idPackage,
                                        }),
                                    },
                                );

                                if (pkgRes.ok) {
                                    const pkgData = await pkgRes.json();
                                    // User said: "ese lo retornará el endpoint... deberá ir el idpatientpackage"
                                    // Use 'id' from response as 'idpatientpackage'
                                    if (pkgData.id) {
                                        payload.idpatientpackage = pkgData.id;
                                    }
                                } else {
                                    throw new Error("Failed to assign package");
                                }
                            } catch (pkgErr) {
                                console.error(
                                    "Error asignando paquete:",
                                    pkgErr,
                                );
                                alert(
                                    "Error: No se pudo asignar el paquete. La cita no se creará.",
                                );
                                return; // Stop execution
                            }
                        }

                        // Also check global vars as backup or sync
                        const res = await fetch(
                            `${backendUrl}/api/v1/Citas${editId ? "/" + editId : ""}`,
                            {
                                method: editId ? "PATCH" : "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                },
                                body: JSON.stringify(payload),
                            },
                        );

                        if (res.ok) {
                            alert(
                                editId
                                    ? "Cita actualizada correctamente."
                                    : "Cita creada correctamente.",
                            );

                            // Auto-close Modal
                            hideFormModal("modalAgregarCita");

                            // Update Patient Status (havepackage: true) if new package assigned
                            if (!editId && idPackage) {
                                try {
                                    await fetch(
                                        `/api/v1/Pacientes/${idpatient}`,
                                        {
                                            method: "PATCH",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                            body: JSON.stringify({
                                                havepackage: true,
                                            }),
                                        },
                                    );
                                } catch (ptErr) {
                                    console.error(
                                        "Error updating patient package status:",
                                        ptErr,
                                    );
                                    // Non-critical, appointment continues
                                }
                            }

                            const result = await res.json();

                            // Extract ID exactly like Agenda.astro
                            let citaId = editId ? editId : null;

                            if (!citaId && result) {
                                if (result.id) {
                                    citaId = result.id;
                                } else if (result.insertId) {
                                    citaId = result.insertId;
                                }
                            }

                            // Update Service (Separate Endpoint)
                            if (citaId && idservice) {
                                try {
                                    await fetch(
                                        `${backendUrl}/api/v1/Agenda/${citaId}/services`,
                                        {
                                            method: editId ? "PATCH" : "POST",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                            body: JSON.stringify({
                                                serviceId: idservice,
                                            }),
                                        },
                                    );
                                } catch (svcErr) {
                                    console.error(
                                        "Error updating service:",
                                        svcErr,
                                    );
                                }
                            }

                            if (result && result.data && result.data.id) {
                                citaId = result.data.id;
                            } else if (
                                Array.isArray(result) &&
                                result.length > 0 &&
                                result[0].id
                            ) {
                                citaId = result[0].id;
                            }

                            // Close details modal if open
                            const detailsModal =
                                document.getElementById("appointmentModal");
                            if (
                                detailsModal &&
                                !detailsModal.classList.contains("hidden")
                            ) {
                                closeModalBtn?.click();
                            }

                            // Refresh Appointments
                            const currentdayInput = document.getElementById(
                                "agregarCurrentday",
                            ) as HTMLInputElement;
                            const dateToFetch =
                                currentdayInput?.value ||
                                new Date().toLocaleDateString("en-CA");
                            fetchAppointments(dateToFetch);
                        } else {
                            const err = await res.text();
                            console.error(err);
                            alert("Error al procesar la cita");
                        }
                    } catch (error) {
                        console.error(error);
                        alert("Error de conexión");
                    }
                });
            }

            // Edit Mode Elements
            const editAppointmentBtn =
                document.getElementById("editAppointmentBtn");
            const viewModeContainer =
                document.getElementById("viewModeContainer");
            const editModeContainer =
                document.getElementById("editModeContainer");
            const editDateInput = document.getElementById(
                "editDateInput",
            ) as HTMLInputElement;
            const editTimeInput = document.getElementById(
                "editTimeInput",
            ) as HTMLInputElement;
            const editServiceInput = document.getElementById(
                "editServiceInput",
            ) as HTMLSelectElement;
            const cancelEditBtn = document.getElementById("cancelEditBtn");
            const saveEditBtn = document.getElementById(
                "saveEditBtn",
            ) as HTMLButtonElement;

            // Edit Mode Logic (REPLACED by Full Modal)
            if (editAppointmentBtn) {
                editAppointmentBtn.addEventListener("click", () => {
                    if (!currentAppointment) return;
                    iniciarEdicion(currentAppointment);
                    // Close Details Modal (Optional, but usually better UX to switch)
                    // The `iniciarEdicion` will open the top modal.
                    // We might want to close the details modal.
                    // Let's assume user wants to switch context.
                    // But maybe allow viewing details while editing?
                    // No, modals overlap. Close details.
                    closeModalBtn?.click();
                });
            }

            // --- Toggle Consent Section Listener ---
            const toggleConsentBtn =
                document.getElementById("toggleConsentBtn");
            if (toggleConsentBtn) {
                toggleConsentBtn.addEventListener("click", () => {
                    const consentSection =
                        document.getElementById("consentSection");
                    const confirmSignBtn = document.getElementById(
                        "confirmSignatureBtn",
                    );

                    if (!consentSection) return;

                    const isHidden =
                        consentSection.classList.contains("hidden");

                    if (isHidden) {
                        consentSection.classList.remove("hidden");
                        confirmSignBtn?.classList.remove("hidden");

                        // Update Button UI
                        toggleConsentBtn.innerHTML = `<span>Ocultar</span><i class="fa-solid fa-chevron-up"></i>`;

                        // Init Canvas if needed
                        setTimeout(initCanvas, 100);
                    } else {
                        consentSection.classList.add("hidden");
                        confirmSignBtn?.classList.add("hidden");

                        // Update Button UI
                        toggleConsentBtn.innerHTML = `<span>Mostrar</span><i class="fa-solid fa-chevron-down"></i>`;
                    }
                });
            }

            if (cancelEditBtn) {
                cancelEditBtn.addEventListener("click", () => {
                    viewModeContainer?.classList.remove("hidden");
                    editModeContainer?.classList.add("hidden");
                    editAppointmentBtn?.classList.remove("hidden");
                });
            }

            if (saveEditBtn) {
                saveEditBtn.addEventListener("click", async () => {
                    if (!currentAppointment) return;

                    const newDate = editDateInput?.value;
                    const newTime = editTimeInput?.value;
                    const newService = editServiceInput?.value;

                    if (!newDate || !newTime || !newService) {
                        alert("Por favor complete todos los campos");
                        return;
                    }

                    const originalBtnText = saveEditBtn.innerHTML;
                    saveEditBtn.disabled = true;
                    saveEditBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Guardando...`;

                    const headers = { "Content-Type": "application/json" };

                    try {
                        // Using PATCH to maintain consistency with status update if possible, or PUT.
                        // Assuming PATCH /api/v1/Citas/${id} handles these fields.
                        const res = await fetch(
                            `/api/v1/Citas/${currentAppointment.idappointment || currentAppointment.id}`,
                            {
                                method: "PATCH",
                                headers,
                                body: JSON.stringify({
                                    date: newDate,
                                    inithour: newTime,
                                    idservice: newService,
                                    // We might need to send other fields to avoid erasing them if the backend expects full object.
                                    // But typically PATCH is partial.
                                    // Also 'status' might be needed if the backend checks it.
                                }),
                            },
                        );

                        if (res.ok) {
                            viewModeContainer?.classList.remove("hidden");
                            editModeContainer?.classList.add("hidden");
                            editAppointmentBtn?.classList.remove("hidden");

                            // Refresh
                            if (dateInput) fetchAppointments(dateInput.value);
                            closeModalBtn?.click(); // Or just close
                        } else {
                            const err = await res.json();
                            alert(
                                `Error: ${err.message || "No se pudo actualizar"}`,
                            );
                        }
                    } catch (error) {
                        console.error(error);
                        alert("Error de conexión");
                    } finally {
                        saveEditBtn.disabled = false;
                        saveEditBtn.innerHTML = originalBtnText;
                    }
                });
            }

            // --- Initialization ---
            if (dateInput) {
                // --- Date Navigation Logic ---
                const prevDayBtn = document.getElementById("prevDayBtn");
                const nextDayBtn = document.getElementById("nextDayBtn");
                const currentDateDisplay =
                    document.getElementById("currentDateDisplay");

                const updateDateDisplay = (dateStr: string) => {
                    // Create date object treating input as local time
                    const [y, m, d] = dateStr.split("-").map(Number);
                    const date = new Date(y, m - 1, d);

                    const options: Intl.DateTimeFormatOptions = {
                        day: "numeric",
                        month: "long",
                        weekday: "short",
                    };

                    if (currentDateDisplay) {
                        const str = date.toLocaleDateString("es-ES", options);
                        currentDateDisplay.textContent =
                            str.charAt(0).toUpperCase() + str.slice(1);
                    }
                };

                const changeDateBy = (days: number) => {
                    const [y, m, d] = dateInput.value.split("-").map(Number);
                    const current = new Date(y, m - 1, d);
                    current.setDate(current.getDate() + days);
                    const newDate = current.toLocaleDateString("en-CA");
                    dateInput.value = newDate;
                    updateDateDisplay(newDate);
                    fetchAppointments(newDate);
                };

                // Initialize
                const today = new Date().toLocaleDateString("en-CA");
                dateInput.value = today;
                updateDateDisplay(today);
                fetchAppointments(today);

                // Event Listeners
                prevDayBtn?.addEventListener("click", () => changeDateBy(-1));
                nextDayBtn?.addEventListener("click", () => changeDateBy(1));

                dateInput.addEventListener("change", (e) => {
                    const target = e.target as HTMLInputElement;
                    updateDateDisplay(target.value);
                    fetchAppointments(target.value);
                });

                const clientSearchInput = document.getElementById(
                    "appointment-search-client",
                );
                if (clientSearchInput) {
                    clientSearchInput.addEventListener("input", (e) => {
                        const term = (
                            e.target as HTMLInputElement
                        ).value.toLowerCase();
                        filterAppointments(term);
                    });
                }
            }

            // Globals
            let currentAppointments: Appointment[] = [];
            let currentAppointmentDetails: any = null; // Re-adding global
            const physioColors = [
                "#eab308", // yellow-500 - fisio nayeli
                "#3b82f6", // blue-500 - fisio jessika
                "#0d9488", // teal-600 (Was bright green) - fisio
                "#a855f7", // purple-500
                "#f97316", // orange-500
                "#14b8a6", // teal-500
                "#ec4899", // pink-500
                "#6366f1", // indigo-500
                "#16a34a", // green-600 (Verde intenso)
                "#06b6d4", // cyan-500
            ];

            const getPhysioColor = (id: string | number) => {
                if (!id) return "#9ca3af"; // gray-400 fallback
                const numId = typeof id === "string" ? parseInt(id, 10) : id;
                if (isNaN(numId)) return "#9ca3af";
                return physioColors[numId % physioColors.length];
            };

            // --- EVA Scale Helper ---
            (window as any).updateEvaColor = function (val: number) {
                const display = document.getElementById("evaScaleDisplay");
                const input = document.getElementById(
                    "evaScaleInput",
                ) as HTMLInputElement;

                if (display) display.innerText = val.toString();
                if (input) {
                    // Gradient Logic
                    // 0-3 Green, 4-6 Yellow, 7-10 Red
                    let color = "#10B981"; // Green
                    if (val >= 4 && val <= 6) color = "#F59E0B"; // Yellow
                    if (val >= 7) color = "#EF4444"; // Red

                    input.style.accentColor = color;
                    if (display) display.style.color = color;
                }
            };

            function filterAppointments(term: string) {
                if (!currentAppointments) return;
                const filtered = currentAppointments.filter((app) => {
                    const name = (app.patient_name || "").toLowerCase();
                    return name.includes(term);
                });
                renderAppointments(filtered);
            }

            // --- History Events ---
            if (closeHistoryBtn && historyOverlay) {
                closeHistoryBtn.addEventListener("click", () =>
                    historyOverlay.classList.add("hidden"),
                );
            }

            // --- Appointments Logic ---
            async function fetchAppointments(date: string) {
                if (!userId || !grid) return;

                grid.innerHTML = `<div class="col-span-full py-12 flex flex-col items-center justify-center text-gray-400"><i class="fa-solid fa-circle-notch fa-spin text-4xl mb-4 text-[#2F5D50]"></i><p>Cargando citas...</p></div>`;

                try {
                    const res = await fetch(
                        `/api/v1/Appointments?date=${date}`,
                    );
                    if (!res.ok) throw new Error("Error fetching");
                    currentAppointments = await res.json();

                    const clientSearchInput = document.getElementById(
                        "appointment-search-client",
                    ) as HTMLInputElement;
                    if (clientSearchInput && clientSearchInput.value) {
                        filterAppointments(
                            clientSearchInput.value.toLowerCase(),
                        );
                    } else {
                        renderAppointments(currentAppointments);
                    }
                } catch (error) {
                    console.error(error);
                    grid.innerHTML = `<div class="p-4 text-red-500 text-center">Error al cargar citas</div>`;
                }
            }

            function renderAppointments(appointments: Appointment[]) {
                if (!grid) return;
                if (!appointments || appointments.length === 0) {
                    grid.innerHTML = `<div class="py-12 flex flex-col items-center justify-center text-gray-400"><i class="fa-regular fa-calendar-xmark text-4xl mb-3 opacity-50"></i><p>No tienes citas para este día</p></div>`;
                    return;
                }
                grid.innerHTML = "";
                appointments.sort((a, b) => (a.inithour > b.inithour ? 1 : -1));

                appointments.forEach((app) => {
                    grid.appendChild(createAppointmentCard(app));
                });
            }

            function createAppointmentCard(app: Appointment) {
                const div = document.createElement("div");
                div.className =
                    "bg-white/60 hover:bg-white/90 backdrop-blur-sm p-2 rounded-lg border border-white/50 shadow-sm hover:shadow-md transition-all duration-300 group cursor-pointer relative overflow-hidden flex flex-col sm:flex-row justify-between items-start gap-1.5";

                const statusConfig: any = {
                    confirmed: {
                        bgClass: "bg-green-500",
                        icon: "fa-thumbs-up",
                        label: "Confirmada",
                    },
                    pending: {
                        bgClass: "bg-yellow-500",
                        icon: "fa-clock",
                        label: "Pendiente",
                    },
                    canceled: {
                        bgClass: "bg-gray-500",
                        icon: "fa-xmark",
                        label: "Cancelada",
                    },
                    concluded: {
                        bgClass: "bg-blue-500",
                        icon: "fa-check",
                        label: "Concluida",
                    },
                    wait: {
                        bgClass: "bg-orange-500",
                        icon: "fa-clock",
                        label: "En espera",
                    },
                    "no assisted": {
                        bgClass: "bg-red-500",
                        icon: "fa-user-xmark",
                        label: "No asistió",
                    },
                };
                const status =
                    statusConfig[app.status?.toLowerCase()] ||
                    statusConfig.wait;

                // Check for missing notes (Visual Indicator)
                const notes = app.notes || {};
                const diag = app.diagnostic || notes.diagnostic || "";
                const note = app.therapeuticnote || notes.therapeuticnote || "";
                const isConcluded = app.status?.toLowerCase() === "concluded";

                const missingNotes =
                    typeof app.has_therapeutic_note === "boolean"
                        ? isConcluded && !app.has_therapeutic_note
                        : isConcluded && (!diag || !note);

                const hasPhoto =
                    app.photo &&
                    app.photo !== "default.png" &&
                    !String(app.photo).includes("default.png");
                let photoContent;

                if (hasPhoto) {
                    let finalUrl = app.photo;
                    if (!finalUrl.startsWith("http")) {
                        if (
                            finalUrl.startsWith("uploads") ||
                            finalUrl.startsWith("/uploads")
                        ) {
                            finalUrl = `${backendUrl}/${finalUrl.startsWith("/") ? finalUrl.slice(1) : finalUrl}`;
                        } else {
                            finalUrl = `${backendUrl}/uploads/images/${finalUrl}`;
                        }
                    }
                    // On error fallback to initials
                    const fallbackHtml = `<div class='w-full h-full flex items-center justify-center text-[#2F5D50] font-bold text-xs bg-[#2F5D50]/10'>${(app.patient_name || "?").charAt(0).toUpperCase()}</div>`;
                    photoContent = `<img src="${finalUrl}" alt="${app.patient_name}" class="w-full h-full object-cover" onerror="this.parentNode.innerHTML=\`${fallbackHtml}\`">`;
                } else {
                    photoContent = `<div class="w-full h-full flex items-center justify-center text-[#2F5D50] font-bold text-xs bg-[#2F5D50]/10">
                                        ${(app.patient_name || "?").charAt(0).toUpperCase()}
                                     </div>`;
                }

                // Physio Color
                const pColor = getPhysioColor(app.idemployed);

                // Initialize Card Colors (Default to Physio Color)
                let cardBgColor = `${pColor}08`; // Light tint of physio color
                let cardStripColor = pColor;

                // Override for Canceled Status
                if (app.status?.toLowerCase() === "canceled") {
                    cardBgColor = "#FEF2F2"; // red-50
                    cardStripColor = "#EF4444"; // red-500
                }

                // Apply styles directly
                div.style.backgroundColor = cardBgColor;
                div.style.borderLeftColor = cardStripColor;

                div.innerHTML = `
                   <div class="absolute left-0 top-0 bottom-0 w-1" style="background-color: ${cardStripColor};"></div>
                   ${app.status?.toLowerCase() === "canceled" ? `<div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0 user-select-none"><i class="fa-solid fa-xmark text-red-600/10 text-5xl"></i></div>` : ""}
                    <div class="flex flex-col gap-1 pl-2 flex-1 min-w-0 pr-1 relative z-10 w-full">
                        <div class="flex items-start gap-2 w-full">
                            <div class="relative w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform overflow-hidden cursor-pointer flex-shrink-0 border border-gray-100 patient-avatar-btn">
                                 ${photoContent}
                            </div>
                            <div class="flex-1 min-w-0 py-0.5">
                                 <h4 class="font-bold text-gray-800 text-xs group-hover:text-[#2F5D50] transition-colors leading-tight break-words">${app.patient_name || "Sin Nombre"} <span class="text-[9px] text-gray-400 font-normal whitespace-nowrap">(${app.birthday ? calcularEdad(app.birthday) : "?"} años)</span></h4>
                                 <div class="flex flex-col gap-0.5 text-[10px] text-gray-500 mt-0.5">
                                     <div class="flex items-center gap-1.5">
                                        <i class="fa-solid fa-notes-medical text-[#2F5D50]/60 min-w-[10px]"></i>
                                        <span class="truncate">${app.service_name || app.servicio || app.name || "Consulta"}</span>
                                     </div>
                                     <div class="flex items-center gap-1.5" style="color: ${pColor}">
                                        <i class="fa-solid fa-user-doctor min-w-[10px]"></i>
                                        <span class="truncate font-bold">${app.employed_name || "Fisio"}</span>
                                     </div>
                                 </div>
                            </div>
                            <!-- Time moved to top-right for compactness -->
                            <div class="flex flex-col items-end">
                                <span class="text-xs font-bold text-gray-700 font-mono tracking-tight">${app.inithour?.substring(0, 5) || "--:--"}</span>
                            </div>
                        </div>
                        
                        ${
                            app.last_diagnostic
                                ? `<div class="w-full px-1.5 py-1 bg-amber-50/50 border border-amber-100/50 rounded text-[9px] text-gray-600 whitespace-normal break-words shadow-sm leading-snug mt-1" title="Diagnóstico">
                                      <p class="font-bold text-amber-600 text-[8px] uppercase tracking-wider mb-0.5 flex items-center gap-1"><i class="fa-solid fa-stethoscope text-[8px]"></i> Dx</p>
                                      <span class="line-clamp-2">${app.last_diagnostic}</span>
                                    </div>`
                                : ""
                        }

                         <div class="flex items-center justify-between w-full mt-1 border-t border-black/5 pt-1">
                            <div class="flex items-center gap-2">
                                <!-- Note Alert -->
                                ${
                                    missingNotes
                                        ? `<span class="px-1.5 py-0.5 bg-red-50 text-red-600 text-[8px] font-bold rounded-md border border-red-200 shadow-sm flex items-center gap-1 animate-pulse" title="Falta Nota">
                                                <i class="fa-solid fa-circle-exclamation"></i> Nota
                                           </span>`
                                        : ""
                                }

                                <!-- Session Pkg -->
                                ${
                                    app.session_label
                                        ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[8px] font-bold bg-purple-50 text-purple-700 border border-purple-200 shadow-sm" title="Sesión">
                                             <i class="fa-solid fa-layer-group text-[8px] text-purple-500"></i> ${app.session_label}
                                           </span>`
                                        : ""
                                }
                            </div>
                            
                            <!-- Edit Icon -->
                            <button class="w-5 h-5 rounded flex items-center justify-center text-gray-400 hover:text-[#2F5D50] hover:bg-gray-100 transition-all quick-edit-btn" title="Editar">
                                <i class="fa-solid fa-pen-to-square text-[10px]"></i>
                            </button>
                         </div>
                    </div>
                `;

                // Click listener for the CARD (opens details)
                div.addEventListener("click", (e) => {
                    // Prevent if clicked on quick edit
                    if ((e.target as HTMLElement).closest(".quick-edit-btn"))
                        return;
                    openModal(app);
                });

                // Click listener for Quick Edit (now Full Edit)
                const qBtn = div.querySelector(".quick-edit-btn");
                if (qBtn) {
                    qBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        // Open Full Edit Modal
                        iniciarEdicion(app);
                    });
                }

                // Click listener for Avatar
                const avBtn = div.querySelector(".patient-avatar-btn");
                if (avBtn) {
                    avBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        handleAvatarClick(app);
                    });
                }

                return div;
            }

            // --- Consultation Logic ---
            async function openModal(app: Appointment) {
                currentAppointment = app;

                // Reset View Mode
                const viewMode = document.getElementById("viewModeContainer");
                const editMode = document.getElementById("editModeContainer");
                const editBtn = document.getElementById("editAppointmentBtn");
                viewMode?.classList.remove("hidden");
                editMode?.classList.add("hidden");
                editBtn?.classList.remove("hidden");

                // Fetch Patient Details
                // Reset first
                patientDetails = null;
                try {
                    const res = await fetch(
                        `/api/v1/Pacientes/${app.idpatient}`,
                    );
                    if (res.ok) {
                        const data = await res.json();
                        patientDetails = Array.isArray(data) ? data[0] : data;
                    }
                } catch (e) {
                    console.error(e);
                }

                // Retrieve history? (Optional, if we want to show it in the modal or sidebar)
                // For now, assume history is a separate button?
                // Actually the history overlay is separate. We could add a button in the modal to Open History.
                // Or just keep it separate.

                // Populate Modal Header
                const age = app.birthday
                    ? calcularEdad(app.birthday)
                    : patientDetails?.birthday
                      ? calcularEdad(patientDetails.birthday)
                      : "?";

                const modalPatientName =
                    document.getElementById("modalPatientName");
                if (modalPatientName)
                    modalPatientName.innerHTML = `${app.patient_name || app.nombre_paciente || "Paciente"} <span class="text-xs text-gray-500 font-normal">(${age} años)</span>`;

                if (document.getElementById("modalTimeRange"))
                    document.getElementById("modalTimeRange")!.textContent =
