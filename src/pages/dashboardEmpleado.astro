                                    );
                                    finishBtn.disabled = false;
                                    return; // STOP execution
                                }
                            }

                            // Save FIRST. Be strict.
                            const result = await saveDraft();
                            if (!result.success) {
                                alert(
                                    "No se pudieron guardar las notas. No se finalizará la cita.",
                                );
                                return;
                            }
                            const detailId = result.detailId;

                            if (!detailId) {
                                console.error(
                                    "Critical: No detailId returned from saveDraft. History cannot be linked.",
                                );
                                alert(
                                    "Advertencia: No se pudo obtener el ID del detalle. El historial podría no guardarse correctamente.",
                                );
                            }

                            // 1. EVALUATION POST (If Valoración)
                            try {
                                const serviceNameNorm = (
                                    currentAppointment.service_name ||
                                    currentAppointment.servicio ||
                                    ""
                                )
                                    .normalize("NFD")
                                    .replace(/[\u0300-\u036f]/g, "")
                                    .toLowerCase();

                                if (serviceNameNorm.includes("valoracion")) {
                                    const evalPayload = {
                                        diagnostic:
                                            (
                                                document.getElementById(
                                                    "evalDiagnostic",
                                                ) as HTMLTextAreaElement
                                            )?.value || "",
                                        injury_mechanism:
                                            (
                                                document.getElementById(
                                                    "evalInjuryMechanism",
                                                ) as HTMLInputElement
                                            )?.value || "",
                                        pain_onset:
                                            (
                                                document.getElementById(
                                                    "evalPainOnset",
                                                ) as HTMLInputElement
                                            )?.value || "",
                                        pain_intensity: parseInt(
                                            (
                                                document.getElementById(
                                                    "evalPainIntensity",
                                                ) as HTMLInputElement
                                            )?.value || "0",
                                        ),
                                        pain_aggravating_factors:
                                            (
                                                document.getElementById(
                                                    "evalAggravating",
                                                ) as HTMLInputElement
                                            )?.value || "",
                                        pain_relief_factors:
                                            (
                                                document.getElementById(
                                                    "evalRelief",
                                                ) as HTMLInputElement
                                            )?.value || "",
                                        previous_therapy:
                                            (
                                                document.getElementById(
                                                    "evalPreviousTherapy",
                                                ) as HTMLInputElement
                                            )?.checked || false,
                                        previous_therapy_reason:
                                            (
                                                document.getElementById(
