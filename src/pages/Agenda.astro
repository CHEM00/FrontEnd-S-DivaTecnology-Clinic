            ?.addEventListener("submit", async (e) => {
                e.preventDefault();

                const form = e.target as HTMLFormElement;
                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                const originalBtnText = submitBtn
                    ? submitBtn.textContent
                    : "GUARDAR";

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
                }

                try {
                    const idPatientEl = document.getElementById(
                        "agregarIdPatient",
                    ) as HTMLSelectElement;
                    const idEmployedEl = document.getElementById(
                        "agregarIdEmployed",
                    ) as HTMLSelectElement;
                    const currentDayEl = document.getElementById(
                        "agregarCurrentday",
                    ) as HTMLInputElement;
                    const initHourEl = document.getElementById(
                        "agregarInitHour",
                    ) as HTMLSelectElement;
                    const endHourEl = document.getElementById(
                        "agregarEndHour",
                    ) as HTMLSelectElement;
                    const statusEl = document.getElementById(
                        "agregarStatus",
                    ) as HTMLSelectElement;
                    const reasonEl = document.getElementById(
                        "agregarReason",
                    ) as HTMLInputElement;

                    if (
                        !idPatientEl ||
                        !idEmployedEl ||
                        !currentDayEl ||
                        !initHourEl ||
                        !endHourEl
                    ) {
                        alert(
                            "Error interno: Elementos del formulario no encontrados",
                        );
                        return;
                    }

                    const serviceSelect = document.getElementById(
                        "agregarIdService",
                    ) as HTMLSelectElement;
                    const selectedServiceOption =
                        serviceSelect?.options[serviceSelect.selectedIndex];
                    const serviceId = serviceSelect?.value;
                    const servicePrice =
                        selectedServiceOption?.getAttribute("data-price");

                    const data = {
                        idpatient: idPatientEl.value.toString(),
                        idemployed: idEmployedEl.value.toString(), // May be empty
                        currentday: currentDayEl.value,
                        inithour: initHourEl.value,
                        endhour: endHourEl.value,
                        status: statusEl?.value || "wait",
                        reason: reasonEl?.value || "",
                    };

                    // Validar que se hayan seleccionado horas
                    if (!data.inithour || !data.endhour) {
                        alert("Por favor seleccione hora de inicio y fin");
                        return;
                    }

                    // Package Check
                    const usePackage = (
                        document.getElementById(
                            "usePackageCheckbox",
                        ) as HTMLInputElement
                    )?.checked;
                    const idPackage = (
                        document.getElementById(
                            "agregarIdPackage",
                        ) as HTMLSelectElement
                    )?.value;

                    // Service is only required if NO package logic is active
                    if (!serviceId && !usePackage && !idPackage) {
                        alert("Por favor seleccione un servicio o un paquete");
                        return;
                    }

                    // Logic to handle Package Checks
                    const form = document.getElementById(
                        "formAgregarCita",
                    ) as HTMLFormElement;
                    const isEdit = form.dataset.mode === "edit";
                    const editId = form.dataset.editId;

                    // --- LOGIC: CREATE vs EDIT ---
                    let citaId = editId;

                    if (isEdit && editId) {
                        // PATCH
                        // 1. Update Appointment Details
                        console.log("Enviando actualización (PATCH)...", data);
                        const res = await fetch(`/api/v1/Citas/${editId}`, {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(data),
                        });
                        if (!res.ok)
                            throw new Error("Error al actualizar la cita");

                        // 2. Update Service (Separate Endpoint)
                        if (serviceId) {
                            await fetch(`/api/v1/Agenda/${editId}/services`, {
                                method: "PATCH",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    serviceId: serviceId,
                                }),
                            });
                        }

                        alert("Cita actualizada correctamente");
                    } else {
                        // POST
                        // Handle Package Logic First
                        // Extend payload if package used
                        const payload: any = { ...data };

                        if (usePackage) {
                            // Consume session
                            const resCons = await fetch(
                                `/api/v1/Pacientes/${data.idpatient}/paquete/consumir`,
                                { method: "POST" },
                            );
                            if (resCons.ok) {
                                const d = await resCons.json();
                                if (d.packageId)
                                    payload.idpatientpackage = d.packageId;
                            }
                        } else if (idPackage) {
                            // Assign New Package
                            const pkg = window.paquetesData?.find(
                                (p: any) => p.id == idPackage,
                            );
                            const total = pkg ? pkg.numsession : 1;
                            const resAsig = await fetch(
                                `/api/v1/Pacientes/${data.idpatient}/paquete`,
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({
                                        idpackage: idPackage,
                                    }),
                                },
                            );
                            if (resAsig.ok) {
                                const d = await resAsig.json();
                                if (d.id) payload.idpatientpackage = d.id;
                                // Set ACTIVE in Patient
                                await fetch(
                                    `/api/v1/Pacientes/${data.idpatient}`,
                                    {
                                        method: "PATCH",
                                        headers: {
                                            "Content-Type": "application/json",
                                        },
                                        body: JSON.stringify({
                                            havepackage: true,
                                        }),
                                    },
                                ).catch((err) => console.error(err));
                            }
                        }

                        const response = await fetch("/api/v1/Citas", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload),
                        });

                        if (!response.ok)
                            throw new Error("Error al crear la cita");

                        const result = await response.json();
                        citaId =
                            result.id ||
                            result.insertId ||
                            (result.data && result.data.id);

                        if (citaId) {
                            // Assign Service
                            let price = "0.00";
                            if (!usePackage && serviceId) {
                                const sel = document.getElementById(
                                    "agregarIdService",
                                ) as HTMLSelectElement;
                                price =
                                    sel.options[sel.selectedIndex].getAttribute(
                                        "data-price",
                                    ) || "0";
                            }

                            await fetch(`/api/v1/Agenda/${citaId}/services`, {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    serviceId: serviceId,
                                    amount: 1,
                                    unit_price: price,
                                }),
                            });
                        }
                        alert("Cita creada exitosamente");
                    }

                    window.cerrarModal("modalAgregarCita");
                    form.reset();
                    if (initHourEl) {
                        initHourEl.innerHTML =
                            '<option value="">Seleccionar fecha primero</option>';
                        initHourEl.disabled = true;
                    }
                    if (endHourEl) endHourEl.value = "";

                    // Recargar Agenda (Existing functions)
                    renderCalendario();
                    cargarCitasMes();
                } catch (error) {
                    console.error(error);
                    alert("Error: " + (error as Error).message);
                } finally {
                    // Re-enable button if modal is still open (error case)
                    // If success, modal closes and button state resets on next open
                    if (
                        submitBtn &&
                        document
                            .getElementById("modalAgregarCita")
                            ?.classList.contains("hidden") === false
                    ) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = originalBtnText || "GUARDAR";
                    }
                }
            });

        // --- PROTECCIÓN NUEVO PACIENTE ---
        // Buscar el formulario y adjuntar listener si no tiene uno robusto
        const formPaciente = document.getElementById("formCrearPaciente");
        if (formPaciente && !formPaciente.dataset.listenerAttached) {
            formPaciente.dataset.listenerAttached = "true";
            formPaciente.addEventListener("submit", async (e) => {
                e.preventDefault();
                const form = e.target as HTMLFormElement;
                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                const originalText = submitBtn
                    ? submitBtn.textContent
                    : "Guardar";

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
                }

                // Recopilar datos
                const formData = new FormData(form);
                const payload: any = {};
                formData.forEach((value, key) => (payload[key] = value));

                try {
                    // Photo Handling logic (simplified for protection demo)
                    // Replicar la lógica de envío original o llamar a una función existente si la hay via 'onsubmit'
                    // Problema: Si había un 'onsubmit' inline o listener previo, este prevenDefault lo bloquea?
                    // Si no lo encontramos antes, es probable que se maneje genericamente o falte.
                    // Asumiremos lógica estándar de POST /api/v1/Pacientes

                    // Lógica específica de foto (si existe input file)
                    /* IMPLEMENTACIÓN COMPLETA DE CREAR PACIENTE AQUÍ PARA ASEGURAR CONTROL */

                    // 1. Crear Paciente
                    const res = await fetch("/api/v1/Pacientes", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload),
                    });

                    if (!res.ok) throw new Error("Error al crear paciente");
                    const data = await res.json();
                    const newId = data.id || data.insertId;

                    // 2. Foto (si hay)
                    const photoInput = document.getElementById(
                        "newPatientPhotoInput",
                    ) as HTMLInputElement;
                    if (
                        photoInput &&
                        photoInput.files &&
                        photoInput.files[0] &&
                        newId
                    ) {
                        const formDataPhoto = new FormData();
                        formDataPhoto.append("photo", photoInput.files[0]);
                        await fetch(`/api/v1/Pacientes/${newId}`, {
                            method: "PATCH",
                            body: formDataPhoto, // No Content-Type header manually
                        });
                    }

                    alert("Paciente creado exitosamente");
                    window.cerrarModal("modalCrearPaciente");
                    form.reset();

                    // Recargar lista global para búsqueda
                    if (window.pacientesData) {
                        // Fetch optimista o recarga completa?
                        // Recarga completa simple
                        const resP = await fetch("/api/v1/Pacientes");
                        if (resP.ok) window.pacientesData = await resP.json();
                    }
                } catch (err) {
                    console.error(err);
                    alert("Error al crear paciente: " + (err as Error).message);
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = originalText;
                    }
                }
            });
        }

        // --- Búsqueda de Pacientes ---
        window.filterPatients = () => {
            const input = document.getElementById(
                "patientSearchInput",
            ) as HTMLInputElement;
            const results = document.getElementById("patientSearchResults");
            const filter = input.value.toLowerCase();

            if (!results) return;
            results.innerHTML = "";

            if (filter.length < 2) {
                results.classList.add("hidden");
                return;
            }

            const filtered = window.pacientesData?.filter(
                (p: any) =>
                    (p.firstname + " " + p.lastname)
                        .toLowerCase()
                        .includes(filter) ||
                    p.email?.toLowerCase().includes(filter),
            );

            if (filtered && filtered.length > 0) {
                filtered.forEach((p: any) => {
                    const div = document.createElement("div");
                    div.className =
                        "p-2 hover:bg-gray-100 cursor-pointer border-b border-gray-100 last:border-0";
                    // Modified to hide ID and just show Name + Email or just Name
                    div.innerHTML = `<div class="font-medium text-gray-800">${p.firstname} ${p.lastname}</div>`;

                    // @ts-ignore
                    div.onclick = () =>
                        window.selectPatient(
                            p.id,
                            `${p.firstname} ${p.lastname}`,
                        );
                    results.appendChild(div);
                });
                results.classList.remove("hidden");
            } else {
                results.classList.add("hidden");
            }
        };

        window.selectPatient = (id: string, name: string) => {
            const input = document.getElementById(
                "patientSearchInput",
            ) as HTMLInputElement;
            const hiddenId = document.getElementById(
                "agregarIdPatient",
            ) as HTMLInputElement;
            const results = document.getElementById("patientSearchResults");

            if (input) input.value = name;
            if (hiddenId) hiddenId.value = id;
            if (results) results.classList.add("hidden");

            // Check Package Logic
            const pData = window.pacientesData?.find((p: any) => p.id == id);
            if (pData && window.handlePackageUI) {
                window.handlePackageUI(pData.havepackage);
            }
        };

        // --- UI Helper: Package Visibility ---
        window.handlePackageUI = (hasPackage: boolean) => {
            const container = document.getElementById("packageOptionContainer");
            const checkbox = document.getElementById(
                "usePackageCheckbox",
            ) as HTMLInputElement;

            if (hasPackage) {
                container?.classList.remove("hidden");
            } else {
                container?.classList.add("hidden");
                if (checkbox) checkbox.checked = false;
            }
        };

        // --- EDICIÓN ROBUSTA ---
        window.openEditModal = async (app: any) => {
            console.log("Abriendo Modal Edición:", app);
            const modal = document.getElementById("modalAgregarCita");
            const form = document.getElementById(
                "formAgregarCita",
            ) as HTMLFormElement;
            const title = modal?.querySelector("h2");
            const submitBtn = form?.querySelector('button[type="submit"]');

            if (!modal || !form) return;

            form.reset();
            form.dataset.mode = "edit";
            form.dataset.editId = app.id || app.idappointment;

            // UI Updates
            if (title) title.innerText = "EDITAR CITA";
            if (submitBtn) submitBtn.textContent = "ACTUALIZAR";

            // Mapeo de Campos
            const idpatient =
                app.idpatient || (app.patient ? app.patient.id : "");
            const patientName =
                app.patientname ||
                (app.patient
                    ? app.patient.firstname + " " + app.patient.lastname
                    : "");

            const idPatientEl = document.getElementById(
                "agregarIdPatient",
            ) as HTMLInputElement;
            const patientSearchEl = document.getElementById(
                "patientSearchInput",
            ) as HTMLInputElement;

            if (idPatientEl) idPatientEl.value = idpatient;
            if (patientSearchEl) patientSearchEl.value = patientName;

            // Populate Date
            const dateInput = document.getElementById(
                "agregarCurrentday",
            ) as HTMLInputElement;
            const dateVal = app.currentday
                ? app.currentday.toString().substring(0, 10)
                : "";
            if (dateInput) dateInput.value = dateVal;

            // Populate Empleado
            const empEl = document.getElementById(
                "agregarIdEmployed",
            ) as HTMLSelectElement;
            if (empEl && app.idemployed) empEl.value = app.idemployed;

            // Populate Status
            const statusEl = document.getElementById(
                "agregarStatus",
            ) as HTMLSelectElement;
            if (statusEl && app.status)
                statusEl.value = app.status.toLowerCase();

            // Populate Reason
            const reasonEl = document.getElementById(
                "agregarReason",
            ) as HTMLInputElement;
            if (reasonEl) reasonEl.value = app.reason || "";

            // Populate Service
            const serviceEl = document.getElementById(
                "agregarIdService",
            ) as HTMLSelectElement;

            let serviceId = app.idservice;
            if (!serviceId && app.services && app.services.length > 0) {
                serviceId = app.services[0].id;
            }
            // Also check 'services' from detailed object if passed differently
            // (The 'app' object here is a mix of appointment + other fields constructed in initiating function)

            if (serviceEl && serviceId) serviceEl.value = serviceId;

            // Package UI Check
            const pData = window.pacientesData?.find(
                (p: any) => p.id == idpatient,
            );
            if (pData) window.handlePackageUI(pData.havepackage);

            // Time Slots & Selection
            const timeVal = app.inithour ? app.inithour.substring(0, 5) : "";
            if (dateVal && window.buscarHorariosDisponibles) {
                // Important: Await the slots loading so the value can be set
                await window.buscarHorariosDisponibles(timeVal);
            }

            // Re-set initHour just in case (buscarHorariosDisponibles handles it, but safety check)
            if (timeVal) {
                const initHourEl = document.getElementById(
                    "agregarInitHour",
                ) as HTMLSelectElement;
                if (initHourEl) initHourEl.value = timeVal;
            }

            // Populate End Hour
            const endTimeVal = app.endhour
                ? app.endhour.toString().substring(0, 5)
                : "";
            const endHourEl = document.getElementById(
                "agregarEndHour",
            ) as HTMLInputElement;
            if (endHourEl && endTimeVal) {
                endHourEl.value = endTimeVal;
            } else if (endHourEl && timeVal) {
                // Fallback: Calculate +1 hour if endhour missing but inithour exists
                const [h, m] = timeVal.split(":").map(Number);
                const date = new Date();
                date.setHours(h);
                date.setMinutes(m);
                date.setHours(date.getHours() + 1);
                endHourEl.value = `${String(date.getHours()).padStart(2, "0")}:${String(date.getMinutes()).padStart(2, "0")}`;
            }

            window.abrirModalAgregar();
        };

        // Alias para compatibilidad
        window.iniciarEdicion = (id: any, detalle: any) => {
            const app = {
                ...detalle.appointment,
                patient: detalle.patient,
                employed: detalle.employed,
                services: detalle.services, // Pass services for auto-selection
                idpatient: detalle.patient.id,
                patientname:
                    detalle.patient.firstname + " " + detalle.patient.lastname,
                idemployed: detalle.employed.id,
            };
            window.openEditModal(app);
        };

        // Global Event for Speed Dial
        window.addEventListener("open-new-appointment-modal", () => {
            const form = document.getElementById(
                "formAgregarCita",
            ) as HTMLFormElement;
            const modal = document.getElementById("modalAgregarCita");
            const title = modal?.querySelector("h2");
            const submitBtn = form?.querySelector('button[type="submit"]');

            if (form) {
                form.reset();
                delete form.dataset.mode;
                delete form.dataset.editId;
            }
            if (title) title.innerText = "NUEVA CITA";
            if (submitBtn) submitBtn.textContent = "GUARDAR";
            window.handlePackageUI(false);

            // Reset date picker if needed or kept empty
            const dateInput = document.getElementById(
                "agregarCurrentday",
            ) as HTMLInputElement;
            if (dateInput) dateInput.value = "";

            window.abrirModalAgregar();
        });

        // Exponer funciones globales para el modal
        window.abrirModalAgregar = () => {
            const modal = document.getElementById("modalAgregarCita");
            if (modal) {
                modal.classList.remove("hidden");
                // Animar entrada
                const content = modal.querySelector(".modal-content-wrapper");
                if (content) {
                    setTimeout(() => {
                        content.classList.remove("scale-95", "opacity-0");
                        content.classList.add("scale-100", "opacity-100");
                    }, 10);
                }
            }
        };

        window.cerrarModal = (id: string) => {
            const modal = document.getElementById(id);
            if (modal) {
                const content = modal.querySelector(".modal-content-wrapper");
                if (content) {
                    content.classList.remove("scale-100", "opacity-100");
                    content.classList.add("scale-95", "opacity-0");

                    // Esperar a que termine la transición antes de ocultar
                    setTimeout(() => {
                        modal.classList.add("hidden");
                    }, 300);
                } else {
                    modal.classList.add("hidden");
                }
            }
        };
    </script>
</Layout>
