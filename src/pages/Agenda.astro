        // --- Lógica del Panel Lateral ---
        const prevDayPanelBtn = document.getElementById("prevDayPanelBtn");
        const nextDayPanelBtn = document.getElementById("nextDayPanelBtn");

        function updateSidePanelDate(offset: number) {
            // @ts-ignore
            if (!window.fechaSeleccionada) return;

            // @ts-ignore
            const [year, month, day] = window.fechaSeleccionada
                .split("-")
                .map(Number);
            const dateObj = new Date(year, month - 1, day);
            dateObj.setDate(dateObj.getDate() + offset);

            const newYear = dateObj.getFullYear();
            const newMonth = dateObj.getMonth();
            const newDay = dateObj.getDate();

            const newFechaStr = getYYYYMMDDFromParts(newYear, newMonth, newDay);
            seleccionarDia(newFechaStr, newDay);
        }

        prevDayPanelBtn?.addEventListener("click", () =>
            updateSidePanelDate(-1),
        );
        nextDayPanelBtn?.addEventListener("click", () =>
