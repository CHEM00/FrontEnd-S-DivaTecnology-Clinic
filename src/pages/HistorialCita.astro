	</div>

	<!-- Script Cliente para Paginación y Filtro -->
	<script define:vars={{ historial, backendUrl }}>
		// Datos iniciales desde el servidor
		let allData = historial || [];
		// Ensure allData is an array
		if (!Array.isArray(allData) && allData.body) {
			allData = allData.body;
		} else if (!Array.isArray(allData)) {
			allData = [];
		}

		let filteredData = [...allData];

		// Estado de la paginación
		let currentPage = 1;
		let rowsPerPage = 10;

		// Elementos DOM
		const tableBody = document.getElementById("tableBody");
		const emptyState = document.getElementById("emptyState");
		const searchInput = document.getElementById("searchInput");
		const rowsPerPageSelect = document.getElementById("rowsPerPage");
		const prevBtn = document.getElementById("prevBtn");
		const nextBtn = document.getElementById("nextBtn");
		const showingStart = document.getElementById("showingStart");
		const showingEnd = document.getElementById("showingEnd");
		const totalRecords = document.getElementById("totalRecords");

		// Modal Elements
		const modalDetail = document.getElementById("modalDetail");
		const modalBackdrop = document.getElementById("modalBackdrop");
		const modalPanel = document.getElementById("modalPanel");
		const closeModalBtn = document.getElementById("closeModalBtn");
		const modalLoading = document.getElementById("modalLoading");
		const modalContent = document.getElementById("modalContent");

		const formatDate = (dateString, timeString) => {
			if (!dateString) return "-";
			const d = new Date(dateString);
			const dateStr = d.toLocaleDateString("es-MX", {
				day: "2-digit",
				month: "2-digit",
				year: "numeric",
			});

			let timeStr = "";
			if (timeString) {
				const [h, m] = timeString.split(":");
				timeStr = `${h}:${m}`;
			}
			return `${dateStr} ${timeStr}`;
		};

		// --- Modal Logic ---
		function toggleModal(show) {
			if (show) {
				modalDetail.classList.remove("hidden");
				// Animate in
				setTimeout(() => {
					modalBackdrop.classList.remove("opacity-0");
					modalPanel.classList.remove(
						"opacity-0",
						"translate-y-4",
						"sm:translate-y-0",
						"sm:scale-95",
					);
				}, 10);
			} else {
				// Animate out
				modalBackdrop.classList.add("opacity-0");
				modalPanel.classList.add(
					"opacity-0",
					"translate-y-4",
					"sm:translate-y-0",
					"sm:scale-95",
				);
				setTimeout(() => {
					modalDetail.classList.add("hidden");
				}, 300);
			}
		}

		closeModalBtn.addEventListener("click", () => toggleModal(false));
		modalBackdrop.addEventListener("click", () => toggleModal(false));

		async function openDetailModal(id) {
			toggleModal(true);
			modalLoading.classList.remove("hidden");
			modalContent.classList.add("hidden");

			try {
				// Determine endpoint based on known patterns or user hint.
				// Assuming /api/v1/Citas/detalle/:id or similar.
				// Using a fallback/test URL or the most likely one.
				const response = await fetch(
					`${backendUrl}/api/v1/Agenda/${id}`,
				);
				if (!response.ok) throw new Error("Error fetching details");

				const json = await response.json();
				// Support array wrapper if present
				const data = Array.isArray(json) ? json[0] : json;
				// Handle both potential keys or fallback
				const detail =
					data.get_appointment_full_detail ||
					data.get_appointment_detail;

				if (detail) {
					populateModal(detail);
					// ... (rest of function)
					modalLoading.classList.add("hidden");
					modalContent.classList.remove("hidden");
				} else {
					console.error("Invalid payload structure", data);
					alert("Error: Estructura de datos inválida");
					toggleModal(false);
				}
			} catch (error) {
				console.error(error);
				alert("No se pudo cargar el detalle de la cita.");
				toggleModal(false);
			}
		}

		function populateModal(data) {
			const p = data.patient || {};
			const a = data.appointment || {};
			const emp = data.employed || {};
			const pkg = data.package || {};
			const ev = data.evaluation || {};
			const sn = data.notes || data.session_notes || {}; // 'notes' in actual payload
			const services = data.services || [];
			const ctx = data.context || {};

			// 1. Patient Info
			const pName =
				p.full_name ||
				`${p.firstname || ""} ${p.lastname || ""} ${p.motherlastname || ""}`.trim();
			document.getElementById("detailPatientName").textContent =
				pName || "Sin nombre";

			// Age/Phone (Check if keys exist, otherwise generic)
			let age = p.age;
			if (!age && p.birthday) {
				const birthDate = new Date(p.birthday);
				const today = new Date();
				let calculatedAge =
					today.getFullYear() - birthDate.getFullYear();
				const m = today.getMonth() - birthDate.getMonth();
				if (
					m < 0 ||
					(m === 0 && today.getDate() < birthDate.getDate())
				) {
					calculatedAge--;
				}
				age = calculatedAge;
			}
			document.getElementById("detailAge").textContent = age || "--";
			document.getElementById("detailPhone").textContent =
				p.phone || "--";

			// Photo (if available) - for now just Initial
			const init = (pName || "?").charAt(0).toUpperCase();
			document.getElementById("detailPhotoContainer").innerHTML = p.photo
				? `<img src="${p.photo}" class="w-full h-full object-cover">`
				: `<span class="text-2xl">${init}</span>`;

			// 2. Session Info
			// Date: 'currentday' or 'date'
			const dateRaw = a.currentday || a.date;
			const d = new Date(dateRaw);
			// Format YYYY-MM-DD -> DD/MM/YYYY
			const dateParts = (dateRaw || "").split("-");
			const dateFormatted =
				dateParts.length === 3
					? `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`
					: dateRaw;

			document.getElementById("detailDate").textContent =
				dateFormatted || "--";

			// Time: 'inithour' or 'start_time'
			const timeRaw = a.inithour || a.start_time || "";
			document.getElementById("detailTime").textContent =
				timeRaw.substring(0, 5) || "--";

			// Physio: 'firstname' + 'lastname'
			const empName =
				emp.full_name ||
				`${emp.firstname || ""} ${emp.lastname || ""}`.trim();
			document.getElementById("detailPhysio").textContent =
				empName || "No asignado";

			// 3. Clinical Data
			document.getElementById("detailNote").textContent =
				sn.therapeuticnote ||
				sn.therapeutic_note ||
				"Sin nota registrada.";

			// Diagnostics
			const diag =
				ev?.diagnostic ||
				ctx?.diagnostic_inherited ||
				a.reason ||
				"Sin diagnóstico"; // Fallback to reason if no diag
			document.getElementById("detailDiagnostic").textContent = diag;

			// EVA Logic
			const evaVal = sn.pain_intensity ?? ev?.pain_intensity;
			const evaCard = document.getElementById("detailEvaCard");
			const evaLabel = document.getElementById("detailEvaLabel");

			if (evaVal !== null && evaVal !== undefined) {
				const val = parseInt(evaVal);
				document.getElementById("detailEvaVal").textContent = val;

				let bgClass = "bg-white",
					borderClass = "border-gray-200",
					textClass = "text-gray-900";
				let label = "Sin Dolor";

				if (val >= 1 && val <= 3) {
					bgClass = "bg-green-50";
					borderClass = "border-green-200";
					textClass = "text-green-700";
					label = "Leve";
				} else if (val >= 4 && val <= 6) {
					bgClass = "bg-yellow-50";
					borderClass = "border-yellow-200";
					textClass = "text-yellow-700";
					label = "Moderado";
				} else if (val >= 7) {
					bgClass = "bg-red-50";
					borderClass = "border-red-200";
					textClass = "text-red-700";
					label = "Intenso";
				}

				evaCard.className = `rounded-2xl shadow-sm border p-4 flex flex-col items-center justify-center relative overflow-hidden transition-colors duration-300 ${bgClass} ${borderClass} ${textClass}`;
				evaLabel.textContent = label;
			} else {
				document.getElementById("detailEvaVal").textContent = "--";
				evaLabel.textContent = "N/A";
				evaCard.className =
					"bg-gray-50 rounded-2xl shadow-sm border border-gray-200 p-4 flex flex-col items-center justify-center relative overflow-hidden text-gray-400";
			}

			// Evaluation Data (Show only if exists and has useful data)
			if (ev && ev.exists && (ev.injury_mechanism || ev.pain_onset)) {
				document
					.getElementById("detailEvaluationBlock")
					.classList.remove("hidden");
				document.getElementById("evalInjury").textContent =
					ev.injury_mechanism || "No registrado";
				document.getElementById("evalOnset").textContent =
					ev.pain_onset || "No registrado";
				document.getElementById("evalAggravating").textContent =
					ev.pain_aggravating_factors || "No registrado";
			} else {
				document
					.getElementById("detailEvaluationBlock")
					.classList.add("hidden");
			}

			// 4. Services & Costs
			const table = document.getElementById("detailServicesTable");
			table.innerHTML = "";
			let grandTotal = 0;

			services.forEach((svc) => {
				const tr = document.createElement("tr");
				tr.className = "hover:bg-gray-50/50";
				tr.innerHTML = `
					<td class="px-5 py-3 font-medium text-gray-700">
                        ${svc.name || svc.nombre_servicio || "Servicio"}
                        ${svc.type === "additional" ? '<span class="text-[9px] bg-yellow-100 text-yellow-700 px-1.5 py-0.5 rounded ml-1">ADICIONAL</span>' : ""}
                    </td>
					<td class="px-5 py-3 text-center text-gray-500">x${svc.amount || 1}</td>
					<td class="px-5 py-3 text-right font-medium text-gray-900">$${Number(svc.subtotal || svc.unit_price || 0).toFixed(2)}</td>
				`;
				table.appendChild(tr);
				grandTotal += Number(svc.subtotal || svc.unit_price || 0);
			});

			document.getElementById("detailTotal").textContent =
				`$${grandTotal.toFixed(2)}`;

			// 5. Package Logic
			// Payload: { session_number: 3, total_sessions: 5, package_price: 2200 }
			// Or: { has_package: true, ... }
			const hasPkg = pkg.total_sessions > 0 || pkg.has_package;

			const pkgBlock = document.getElementById("detailPackageBlock");
			if (hasPkg) {
				pkgBlock.classList.remove("hidden");
				const current =
					pkg.session_number ||
					pkg.current_session ||
					pkg.sessions_used ||
					0;
				const total = pkg.total_sessions;
				const pct = Math.min((current / total) * 100, 100);

				document.getElementById("detailPackageLabel").textContent =
					`Sesión ${current} de ${total}`;
				document.getElementById("detailPackageBar").style.width =
					`${pct}%`;
			} else {
				pkgBlock.classList.add("hidden");
			}
		}

		// --- End Modal Logic ---

		// Función Principal de Renderizado
		function renderTable() {
			// Calcular índices
			const startIndex = (currentPage - 1) * rowsPerPage;
			const endIndex = Math.min(
				startIndex + rowsPerPage,
				filteredData.length,
			);
			const pageData = filteredData.slice(startIndex, endIndex);

			// Limpiar tabla
			tableBody.innerHTML = "";

			if (pageData.length === 0) {
				emptyState.classList.remove("hidden");
				showingStart.textContent = 0;
				showingEnd.textContent = 0;
				totalRecords.textContent = 0;
				updatePaginationControls();
				return;
			}

			emptyState.classList.add("hidden");

			// Generar filas
			pageData.forEach((item) => {
				const isValuation =
					item.servicios &&
					item.servicios
						.toLowerCase()
						.normalize("NFD")
						.replace(/[\u0300-\u036f]/g, "")
						.includes("valoracion");

				const row = document.createElement("tr");

				const valStyles =
					"bg-violet-50 border-l-[4px] border-l-violet-500 hover:bg-violet-100/80 cursor-pointer";
				const stdStyles =
					"bg-white border-l-[4px] border-l-transparent hover:bg-gray-50 border-b border-gray-100/50 cursor-pointer";

				row.className = `transition-all duration-200 group text-sm text-gray-700 ${isValuation ? valStyles : stdStyles}`;

				// Add Click Handler
				row.onclick = () => {
					const id = item.idappointment;
					if (id) openDetailModal(id);
					else console.warn("No ID found for item", item);
				};

				const initial = item.paciente
					? item.paciente.charAt(0).toUpperCase()
					: "?";

				const fullDateTime = formatDate(item.fecha, item.hora_inicio);

				const serviciosTags = item.servicios
					? item.servicios
							.split(",")
							.map(
								(s) =>
									`<span class="text-[10px] bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full border border-gray-200 truncate max-w-full inline-block m-0.5">${s.trim()}</span>`,
							)
							.join("")
					: '<span class="text-xs text-gray-400 italic">Sin servicios</span>';

				const sesionActual = item.sesion_en_paquete;
				const totalSesiones = item.total_sesiones_paquete;
				const isPaquete = totalSesiones != null;

				// EVA Badge Logic
				let evaBadge = "-";
				if (item.pain_intensity != null) {
					const val = parseInt(item.pain_intensity);
					let colorClass =
						"bg-green-100 text-green-700 border-green-200";
					if (val >= 4)
						colorClass =
							"bg-yellow-100 text-yellow-700 border-yellow-200";
					if (val >= 7)
						colorClass = "bg-red-100 text-red-700 border-red-200";
					evaBadge = `
						<div class="flex flex-col items-center justify-center px-3 py-1.5 rounded-xl border ${colorClass} bg-opacity-50">
							<span class="text-[8px] font-bold uppercase tracking-wider opacity-60">EVA</span>
							<span class="text-xl font-black leading-none">${val}</span>
						</div>
					`;
				}

				row.innerHTML = `
					<!-- Paciente -->
                    <td class="p-4 align-top">
                        <div class="flex items-start gap-3">
                             <div class="w-8 h-8 rounded-full bg-[#2F5D50]/10 flex items-center justify-center text-[#2F5D50] font-bold text-xs shadow-sm flex-shrink-0 mt-1">
                                ${initial}
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 text-sm">${item.paciente || "Desconocido"}</h4>
                                <span class="text-xs text-gray-400">#${item.numero_sesion || "-"}</span>
                            </div>
                        </div>
                    </td>

					<!-- Fecha & Fisioterapeuta -->
                    <td class="p-4 align-top">
						<div class="flex flex-col gap-1">
							<div class="flex items-center gap-2 text-gray-700 font-medium text-sm">
								<i class="fa-regular fa-calendar text-[#2F5D50]/60"></i>
								${fullDateTime}
							</div>
							<div class="mt-2 flex items-center gap-1.5 p-1.5 bg-gray-50 rounded-lg border border-gray-100 w-fit">
								<i class="fa-solid fa-user-doctor text-xs text-gray-400"></i>
								<span class="text-xs font-semibold text-gray-600">${item.fisioterapeuta || "N/A"}</span>
							</div>
						</div>
                    </td>

					<!-- Información Clínica (Diagnostico, Servicios, Notas) -->
                    <td class="p-4 align-top">
                        <div class="space-y-3">
							<!-- Servicios -->
							<div class="flex flex-wrap gap-1">
								${serviciosTags}
							</div>
							
							<!-- Diagnostico -->
							${
								item.diagnostico
									? `
							<div class="bg-indigo-50/50 rounded-lg p-2.5 border border-indigo-100/50">
								<p class="text-[10px] font-extrabold text-indigo-800 uppercase tracking-widest mb-1 flex items-center gap-1">
									<i class="fa-solid fa-stethoscope"></i> Diagnóstico
								</p>
								<p class="text-xs text-gray-700 leading-relaxed font-medium">
									${item.diagnostico}
								</p>
							</div>`
									: ""
							}

							<!-- Nota -->
							${
								item.nota_terapeutica
									? `
							<div class="relative pl-3 border-l-2 border-gray-200">
								<p class="text-xs text-gray-500 italic">"${item.nota_terapeutica}"</p>
							</div>`
									: ""
							}
                        </div>
                    </td>

					<!-- Estado y EVA -->
                    <td class="p-4 align-top">
						<div class="flex flex-col items-center gap-3">
							${evaBadge !== "-" ? evaBadge : ""}
							
							${
								isPaquete
									? `
							<div class="flex flex-col items-center">
								<div class="px-2.5 py-1 rounded-full bg-purple-50 border border-purple-100 shadow-sm">
									<span class="text-[9px] font-bold text-purple-700 tracking-wide uppercase">
										Sesión ${sesionActual} / ${totalSesiones}
									</span>
								</div>
								<div class="w-16 h-1 bg-gray-100 rounded-full mt-1.5 overflow-hidden">
									<div class="bg-purple-500 h-full rounded-full" style="width: ${(sesionActual / totalSesiones) * 100}%"></div>
								</div>
							</div>
							`
									: ""
							}
						</div>
                    </td>
                `;
				tableBody.appendChild(row);
			});

			// Actualizar info de paginación
			showingStart.textContent = startIndex + 1;
			showingEnd.textContent = endIndex;
			totalRecords.textContent = filteredData.length;

			updatePaginationControls();
		}

		function updatePaginationControls() {
			const totalPages = Math.ceil(filteredData.length / rowsPerPage);

			prevBtn.disabled = currentPage === 1;
			nextBtn.disabled = currentPage === totalPages || totalPages === 0;
		}

		// Event Listeners
		searchInput.addEventListener("input", (e) => {
			const term = e.target.value.toLowerCase();
			filteredData = allData.filter((item) => {
				return (
					(item.paciente &&
						item.paciente.toLowerCase().includes(term)) ||
					(item.fisioterapeuta &&
						item.fisioterapeuta.toLowerCase().includes(term)) ||
					(item.servicios &&
						item.servicios.toLowerCase().includes(term))
				);
			});
			currentPage = 1; // Resetear a primera página
			renderTable();
		});

		rowsPerPageSelect.addEventListener("change", (e) => {
			rowsPerPage = parseInt(e.target.value);
			currentPage = 1;
			renderTable();
		});

		prevBtn.addEventListener("click", () => {
			if (currentPage > 1) {
				currentPage--;
				renderTable();
			}
		});

		nextBtn.addEventListener("click", () => {
			const totalPages = Math.ceil(filteredData.length / rowsPerPage);
			if (currentPage < totalPages) {
				currentPage++;
				renderTable();
			}
		});

		// Inicializar
		renderTable();
	</script>
</Layout>
