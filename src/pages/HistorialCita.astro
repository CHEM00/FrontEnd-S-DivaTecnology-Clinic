---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import TopTag from "../components/TopTag.astro";

let historial = [];

import { SERVER_BACKEND_URL } from "../config";
const backendUrl = SERVER_BACKEND_URL;
const token = Astro.cookies.get("auth_token")?.value;
const headers = {
	"Content-Type": "application/json",
	...(token && { Cookie: `auth_token=${token}` }),
};

const { Agent } = await import("node:https");
const agent = new Agent({ rejectUnauthorized: false });

try {
	// @ts-ignore
	// @ts-ignore
	const response = await fetch(`${backendUrl}/api/v1/HistorialClinico`, {
		headers,
		agent,
	} as any);
	if (response.ok) {
		historial = await response.json();
	} else {
		console.error("Error fetching historial:", response.status);
	}
} catch (error) {
	console.error("Error fetching historial:", error);
}
---

