---
export const prerender = false;
import NavBar from "../components/NavBar.astro";
import Layout from "../layouts/Layout.astro";
import TopTag from "../components/TopTag.astro";

let clinicData = {};
let scheduleData = [];

import { SERVER_BACKEND_URL } from "../config";
const backendUrl = SERVER_BACKEND_URL;
const token = Astro.cookies.get("auth_token")?.value;
const headers = {
    "Content-Type": "application/json",
    ...(token && { Cookie: `auth_token=${token}` }),
};

const { Agent } = await import("node:https");
const agent = new Agent({ rejectUnauthorized: false });

try {
    const [clinicRes, scheduleRes] = await Promise.all([
        // @ts-ignore
        fetch(`${backendUrl}/api/v1/Clinicas`, { headers, agent }),
        // @ts-ignore
        fetch(`${backendUrl}/api/v1/Horarios`, { headers, agent }),
    ]);

    if (clinicRes.ok) {
        const clinics = await clinicRes.json();
        clinicData = clinics[0] || {}; // Assuming we want the first clinic
    }

    if (scheduleRes.ok) {
        scheduleData = await scheduleRes.json();
    }
} catch (error) {
    console.error("Error fetching data:", error);
}

const daysMap = {
    0: "Domingo",
    1: "Lunes",
    2: "Martes",
    3: "Miércoles",
    4: "Jueves",
    5: "Viernes",
    6: "Sábado",
};

const weekDays = [1, 2, 3, 4, 5, 6, 0].map((day) => ({
    day,
    schedule: scheduleData.find((s) => Number(s.dayofweek) === day) || null,
}));

const hhmm = (t) => (t ? String(t).substring(0, 5) : "");
---

<Layout title="Configuración">
    <div
        class="flex h-[100dvh] overflow-hidden bg-gradient-to-br from-[#F0F4F8] via-[#E6F0EA] to-[#F0F4F8]"
    >
        <NavBar />
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
            <!-- Background Elements -->
            <div
                class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-[#2F5D50]/10 rounded-full blur-3xl pointer-events-none"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-5%] w-96 h-96 bg-[#2F5D50]/5 rounded-full blur-3xl pointer-events-none"
            >
            </div>

            <TopTag
                titulo="Configuración del Sistema"
                nombreUsuario="Administrador"
            />

            <main
                class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scrollbar-thin scrollbar-thumb-[#2F5D50]/20 scrollbar-track-transparent relative z-10"
            >
                <div class="flex flex-col lg:flex-row gap-8">
                    <!-- Menú lateral -->
                    <div
                        class="lg:w-1/4 glass-panel rounded-3xl p-6 h-fit animate-fade-in-up stagger-2 border border-white/40 shadow-xl"
                    >
                        <h3 class="text-lg font-bold text-[#2F5D50] mb-4 px-2">
                            Menú
                        </h3>
                        <ul class="space-y-2">
                            <li
                                class="p-3 bg-[#2F5D50]/10 text-[#2F5D50] font-bold rounded-xl cursor-pointer border border-[#2F5D50]/20 flex items-center transition-all"
                            >
                                <div
                                    class="w-8 h-8 rounded-lg bg-[#2F5D50]/20 flex items-center justify-center mr-3"
                                >
                                    <i class="fas fa-building"></i>
                                </div>
                                Información de la Clínica
                            </li>
                        </ul>
                    </div>

                    <!-- Panel de configuración -->
                    <div
                        class="lg:w-3/4 space-y-8 animate-fade-in-up stagger-3"
                    >
                        <!-- Información de la Clínica -->
                        <div
                            class="glass-panel rounded-3xl p-8 border border-white/40 shadow-xl relative overflow-hidden"
                        >
                            <div
                                class="absolute top-0 right-0 p-8 opacity-5 pointer-events-none"
                            >
                                <i
                                    class="fas fa-building text-9xl text-[#2F5D50]"
                                ></i>
                            </div>

                            <div
                                class="flex justify-between items-center mb-8 border-b border-[#2F5D50]/10 pb-4"
                            >
                                <h2
                                    class="text-xl font-bold text-[#2F5D50] flex items-center gap-3"
                                >
                                    <div
                                        class="w-10 h-10 rounded-xl bg-[#2F5D50]/10 flex items-center justify-center"
                                    >
                                        <i class="fas fa-building"></i>
                                    </div>
                                    Información de la Clínica
                                </h2>
                                <button
                                    id="btnActualizar"
                                    class="glass-button px-4 py-2 rounded-xl flex items-center gap-2 text-white bg-[#2F5D50] hover:bg-[#234D20] transition-all shadow-lg hover:shadow-[#2F5D50]/30 transform hover:-translate-y-1"
                                >
                                    <i class="fa-solid fa-save"></i>
                                    <span class="font-semibold text-sm"
                                        >Actualizar Datos</span
                                    >
                                </button>
                            </div>

                            <form
                                id="formClinica"
                                class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10"
                            >
                                <input
                                    type="hidden"
                                    id="clinicId"
                                    value={clinicData.id || ""}
                                />
                                <div class="space-y-2">
                                    <label
                                        class="block text-sm font-bold text-gray-700 ml-1"
                                        >Nombre de la Clínica</label
                                    >
                                    <input
                                        type="text"
                                        id="name"
                                        class="glass-input w-full px-4 py-3 rounded-xl focus:ring-2 focus:ring-[#2F5D50]/20 outline-none transition-all"
                                        value={clinicData.name || ""}
                                    />
                                </div>

                                <div class="space-y-2">
                                    <label
                                        class="block text-sm font-bold text-gray-700 ml-1"
                                        >Correo Electrónico</label
                                    >
                                    <input
                                        type="email"
                                        id="email"
                                        class="glass-input w-full px-4 py-3 rounded-xl focus:ring-2 focus:ring-[#2F5D50]/20 outline-none transition-all"
                                        value={clinicData.email || ""}
                                    />
                                </div>

                                <div class="space-y-2">
                                    <label
                                        class="block text-sm font-bold text-gray-700 ml-1"
                                        >Teléfono</label
                                    >
                                    <input
                                        type="tel"
                                        id="phone"
                                        class="glass-input w-full px-4 py-3 rounded-xl focus:ring-2 focus:ring-[#2F5D50]/20 outline-none transition-all"
                                        value={clinicData.phone || ""}
                                    />
                                </div>

                                <div class="space-y-2 md:col-span-2">
                                    <label
                                        class="block text-sm font-bold text-gray-700 ml-1"
                                        >Dirección</label
                                    >
                                    <input
                                        type="text"
                                        id="address"
                                        class="glass-input w-full px-4 py-3 rounded-xl focus:ring-2 focus:ring-[#2F5D50]/20 outline-none transition-all"
                                        value={clinicData.address || ""}
                                    />
                                </div>

                                <div class="space-y-2">
                                    <label
                                        class="block text-sm font-bold text-gray-700 ml-1"
                                        >Código Postal</label
                                    >
                                    <input
                                        type="text"
                                        id="postalcode"
                                        class="glass-input w-full px-4 py-3 rounded-xl focus:ring-2 focus:ring-[#2F5D50]/20 outline-none transition-all"
                                        value={clinicData.postalcode || ""}
                                    />
                                </div>
                            </form>
                        </div>

                        <!-- Configuración de Horarios -->
                        <div
                            class="glass-panel rounded-3xl p-8 border border-white/40 shadow-xl relative overflow-hidden"
                        >
                            <div
                                class="absolute top-0 right-0 p-8 opacity-5 pointer-events-none"
                            >
                                <i class="fas fa-clock text-9xl text-[#2F5D50]"
                                ></i>
                            </div>

                            <div
                                class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 border-b border-[#2F5D50]/10 pb-4 gap-2"
                            >
                                <h2
                                    class="text-xl font-bold text-[#2F5D50] flex items-center gap-3"
                                >
                                    <div
                                        class="w-10 h-10 rounded-xl bg-[#2F5D50]/10 flex items-center justify-center"
                                    >
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    Horarios de Atención
                                </h2>
                                <span class="text-xs text-gray-500"
                                    >Este horario define la disponibilidad
                                    general de la agenda</span
                                >
                            </div>

                            <div class="space-y-4 relative z-10">
                                {
                                    weekDays.map(({ day, schedule }) => (
                                        <div
                                            class="flex flex-col lg:flex-row lg:items-center justify-between p-5 bg-white/40 rounded-2xl border border-white/50 hover:bg-white/60 transition-colors gap-4"
                                            data-day={day}
                                        >
                                            <label class="flex items-center gap-3 w-full lg:w-40 cursor-pointer select-none">
                                                <input
                                                    type="checkbox"
                                                    class="day-open accent-[#2F5D50] w-4 h-4"
                                                    checked={!!schedule}
                                                />
                                                <span class="font-bold text-gray-700">
                                                    {daysMap[day]}
                                                </span>
                                            </label>
                                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-xs font-bold text-gray-500 uppercase">
                                                        Abre
                                                    </span>
                                                    <input
                                                        type="time"
                                                        class="day-openhour glass-input px-3 py-2 rounded-lg text-sm font-medium"
                                                        value={
                                                            hhmm(
                                                                schedule?.openhour,
                                                            ) || "09:00"
                                                        }
                                                    />
                                                    <span class="text-gray-400">
                                                        a
                                                    </span>
                                                    <input
                                                        type="time"
                                                        class="day-closehour glass-input px-3 py-2 rounded-lg text-sm font-medium"
                                                        value={
                                                            hhmm(
                                                                schedule?.closehour,
                                                            ) || "18:00"
                                                        }
                                                    />
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <span class="text-xs font-bold text-gray-500 uppercase">
                                                        Descanso
                                                    </span>
                                                    <input
                                                        type="time"
                                                        class="day-breakstart glass-input px-3 py-2 rounded-lg text-sm font-medium"
                                                        value={hhmm(
                                                            schedule?.break_start,
                                                        )}
                                                    />
                                                    <span class="text-gray-400">
                                                        a
                                                    </span>
                                                    <input
                                                        type="time"
                                                        class="day-breakend glass-input px-3 py-2 rounded-lg text-sm font-medium"
                                                        value={hhmm(
                                                            schedule?.break_end,
                                                        )}
                                                    />
                                                </div>
                                                <button
                                                    type="button"
                                                    class="day-save glass-button px-4 py-2 rounded-xl text-white bg-[#2F5D50] hover:bg-[#234D20] transition-all text-sm font-semibold"
                                                >
                                                    Guardar
                                                </button>
                                            </div>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </main>
        </div>
    </div>

    <div
        id="toast"
        class="hidden fixed bottom-6 right-6 z-[60] px-5 py-3 rounded-2xl shadow-2xl text-sm font-semibold text-white"
    >
    </div>

    <script>
        function toast(mensaje: string, esError = false) {
            const el = document.getElementById("toast");
            if (!el) return;
            el.textContent = mensaje;
            el.className = `fixed bottom-6 right-6 z-[60] px-5 py-3 rounded-2xl shadow-2xl text-sm font-semibold text-white ${esError ? "bg-red-600" : "bg-[#2F5D50]"}`;
            el.classList.remove("hidden");
            setTimeout(() => el.classList.add("hidden"), 3500);
        }

        document.addEventListener("DOMContentLoaded", function () {
            const btnActualizar = document.getElementById("btnActualizar");
            const clinicId = (
                document.getElementById("clinicId") as HTMLInputElement
            ).value;

            const inputValue = (id: string) =>
                (document.getElementById(id) as HTMLInputElement).value;

            btnActualizar?.addEventListener("click", async () => {
                const data = {
                    name: inputValue("name"),
                    email: inputValue("email"),
                    phone: inputValue("phone"),
                    address: inputValue("address"),
                    postalcode: inputValue("postalcode"),
                };

                const targetId = clinicId || "1";

                try {
                    const response = await fetch(
                        `/api/v1/Clinicas/${targetId}`,
                        {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(data),
                        },
                    );

                    if (response.ok) {
                        toast("Datos de la clínica actualizados");
                    } else {
                        const err = await response.json().catch(() => ({}));
                        toast(
                            err.error ||
                                err.message ||
                                "Error al actualizar los datos",
                            true,
                        );
                    }
                } catch (error) {
                    toast("Error de conexión al actualizar los datos", true);
                }
            });

            document
                .querySelectorAll<HTMLElement>("[data-day]")
                .forEach((row) => {
                    const day = row.dataset.day;
                    const openChk = row.querySelector(
                        ".day-open",
                    ) as HTMLInputElement;
                    const timeInputs =
                        row.querySelectorAll<HTMLInputElement>(
                            "input[type=time]",
                        );
                    const saveBtn = row.querySelector(
                        ".day-save",
                    ) as HTMLButtonElement;

                    const syncState = () => {
                        timeInputs.forEach(
                            (input) => (input.disabled = !openChk.checked),
                        );
                    };
                    openChk.addEventListener("change", syncState);
                    syncState();

                    saveBtn.addEventListener("click", async () => {
                        saveBtn.disabled = true;
                        try {
                            let res;
                            if (openChk.checked) {
                                const value = (selector: string) =>
                                    (
                                        row.querySelector(
                                            selector,
                                        ) as HTMLInputElement
                                    ).value;
                                res = await fetch(`/api/v1/Horarios/${day}`, {
                                    method: "PUT",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({
                                        openhour: value(".day-openhour"),
                                        closehour: value(".day-closehour"),
                                        break_start:
                                            value(".day-breakstart") || null,
                                        break_end:
                                            value(".day-breakend") || null,
                                    }),
                                });
                            } else {
                                res = await fetch(`/api/v1/Horarios/${day}`, {
                                    method: "DELETE",
                                });
                                if (res.status === 404) {
                                    toast("Día guardado como cerrado");
                                    return;
                                }
                            }

                            if (res.ok) {
                                toast(
                                    openChk.checked
                                        ? "Horario guardado"
                                        : "Día guardado como cerrado",
                                );
                            } else {
                                const err = await res
                                    .json()
                                    .catch(() => ({}) as any);
                                toast(
                                    err.error || "Error al guardar el horario",
                                    true,
                                );
                            }
                        } catch (error) {
                            toast("Error de conexión al guardar", true);
                        } finally {
                            saveBtn.disabled = false;
                        }
                    });
                });
        });
    </script>
</Layout>
