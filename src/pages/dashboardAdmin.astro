				<h3
					id="photoModalTitle"
					class="text-lg font-bold text-gray-800"
				>
					Foto del Paciente
				</h3>
			</div>
			<div class="bg-gray-100 flex items-center justify-center h-96">
				<img
					id="photoModalImg"
					src=""
					alt="Paciente"
					class="h-full w-full object-contain"
				/>
			</div>
		</div>
	</div>
	<!-- Script para Agenda Dinámica y Lógica de Modales -->
	<script is:inline>
		document.addEventListener("DOMContentLoaded", () => {
			// --- Referencias DOM ---
			const agendaDateInput = document.getElementById(
				"appointment-date-calendar",
			);
			const agendaContainer = document.getElementById(
				"agenda-list-container",
			);
			const clientSearchInput = document.getElementById(
				"appointment-search-client",
			);
			const backendUrl = window.location.origin; // O usar variable de entorno si está expuesta

			// Globals
			let currentAppointments = [];
			const physioColors = [
				"#ef4444", // red-500
				"#3b82f6", // blue-500
				"#22c55e", // green-500
				"#a855f7", // purple-500
				"#f97316", // orange-500
				"#14b8a6", // teal-500
				"#ec4899", // pink-500
				"#6366f1", // indigo-500
				"#84cc16", // lime-500
				"#06b6d4", // cyan-500
			];

			const getPhysioColor = (id) => {
				if (!id) return "#9ca3af"; // gray-400 fallback
				const numId = parseInt(id, 10);
				if (isNaN(numId)) return "#9ca3af";
				return physioColors[numId % physioColors.length];
			};

			// --- Modales ---
			const modalAgregar = document.getElementById("modalAgregarCita");
			const formAgregar = document.getElementById("formAgregarCita");
			const modalPaciente = document.getElementById("modalCrearPaciente");
			const formPaciente = document.getElementById("formCrearPaciente");
			const modalReschedule = document.getElementById("modalReschedule");
			const formReschedule = document.getElementById("formReschedule");

			// --- Funciones de Modal ---
			window.showFormModal = (modalId) => {
				const modal = document.getElementById(modalId);
				const content = modal?.querySelector("div[class*='transform']");
				if (modal && content) {
					modal.classList.remove("hidden");
					// Pequeño delay para la animación
					setTimeout(() => {
						content.classList.remove("scale-95", "opacity-0");
						content.classList.add("scale-100", "opacity-100");
					}, 10);
				}
			};

			window.hideFormModal = (modalId) => {
				const modal = document.getElementById(modalId);
				const content = modal?.querySelector("div[class*='transform']");
				if (modal && content) {
					content.classList.remove("scale-100", "opacity-100");
					content.classList.add("scale-95", "opacity-0");
					setTimeout(() => {
						modal.classList.add("hidden");
					}, 300);
				}
			};

			// Exponer cerrarModal globalmente
			window.cerrarModal = window.hideFormModal;

			// Listeners de Cierre de Modales
			document.querySelectorAll('[id$="-cancel"]').forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const modalId = e.target.closest('div[id^="modal"]').id;
					window.hideFormModal(modalId);
				});
			});

			// --- Speed Dial Listeners ---
			window.addEventListener("open-new-appointment-modal", () => {
				if (formAgregar) formAgregar.reset();
				window.showFormModal("modalAgregarCita");
				// Resetear UI de paquete
				handlePackageUI(false);
			});

			window.addEventListener("open-new-patient-modal", () => {
				if (formPaciente) formPaciente.reset();
				window.showFormModal("modalCrearPaciente");
			});

			// --- Lógica de Agenda ---
			if (agendaDateInput && agendaContainer) {
				const today = new Date(
					Date.now() - new Date().getTimezoneOffset() * 60000,
				)
					.toISOString()
					.split("T")[0];
				agendaDateInput.value = today;

				fetchAgenda(today);

				agendaDateInput.addEventListener("change", (e) => {
					fetchAgenda(e.target.value);
				});

				if (clientSearchInput) {
					clientSearchInput.addEventListener("input", (e) => {
						const term = e.target.value.toLowerCase();
						filterAgenda(term);
					});
				}
			}

			function filterAgenda(term) {
				if (!currentAppointments) return;
				const filtered = currentAppointments.filter((app) => {
					const name = (app.patient_name || "").toLowerCase();
					return name.includes(term);
				});
				renderAgenda(filtered);
			}

			async function fetchAgenda(date) {
				if (!agendaContainer) return;

				agendaContainer.innerHTML = `<div class="col-span-full py-12 flex flex-col items-center justify-center text-gray-400"><i class="fa-solid fa-circle-notch fa-spin text-4xl mb-4 text-[#2F5D50]"></i><p>Cargando citas...</p></div>`;

				try {
					const res = await fetch(
						`/api/v1/Appointments?date=${date}`,
					);
					if (!res.ok) throw new Error("Failed to fetch agenda");
					currentAppointments = await res.json();
					// Si hay filtro activo, aplicar
					if (clientSearchInput && clientSearchInput.value) {
						filterAgenda(clientSearchInput.value.toLowerCase());
					} else {
						renderAgenda(currentAppointments);
					}
				} catch (error) {
					console.error("Error loading agenda:", error);
					agendaContainer.innerHTML = `<div class="p-4 text-red-500 text-center">Error al cargar citas</div>`;
				}
			}

			function renderAgenda(appointments) {
				const container = document.getElementById(
					"agenda-list-container",
				);
				if (!container) return;

				// Filtrar canceladas (Solicitud Usuario)
				if (appointments && Array.isArray(appointments)) {
					appointments = appointments.filter(
						(a) => a.status !== "canceled",
					);
				}

				container.innerHTML = "";

				if (!appointments || appointments.length === 0) {
					container.innerHTML = `
                        <div class="text-center py-8 text-gray-500">
                            <p>No hay citas para esta fecha.</p>
                        </div>
                    `;
					return;
				}

				// Ordenar por hora
				appointments.sort((a, b) => (a.inithour > b.inithour ? 1 : -1));

				appointments.forEach((cita) => {
					container.appendChild(createAppointmentCard(cita));
				});
			}

			function createAppointmentCard(app) {
				const div = document.createElement("div");

				// --- REFINED DESIGN (Physio Color + Photo Focus) ---
				const normalize = (str) =>
					(str || "")
						.normalize("NFD")
						.replace(/[\u0300-\u036f]/g, "")
						.toLowerCase();
				const status = normalize(app.status);

				// 1. Get Physio Color
				let pColor = "#9ca3af"; // Default Gray
				if (typeof getPhysioColor === "function") {
					pColor = getPhysioColor(app.idemployed);
				}

				// 2. Photo Logic
				const hasPhoto =
					app.photo &&
					app.photo !== "default.png" &&
					!String(app.photo).includes("default.png");
				let photoContent;
				if (hasPhoto) {
					let finalUrl = app.photo;
					if (!finalUrl.startsWith("http")) {
						if (
							finalUrl.startsWith("uploads") ||
							finalUrl.startsWith("/uploads")
						) {
							finalUrl = `${backendUrl}/${finalUrl.startsWith("/") ? finalUrl.slice(1) : finalUrl}`;
						} else {
							finalUrl = `${backendUrl}/uploads/images/${finalUrl}`;
						}
					}
					// Fallback to Initial with Physio Color
					const fallbackHtml = `<div class='w-full h-full flex items-center justify-center font-bold text-xl' style='background-color: ${pColor}20; color: ${pColor}'>${(app.patient_name || "?").charAt(0).toUpperCase()}</div>`;
					photoContent = `<img src="${finalUrl}" alt="${app.patient_name}" class="w-full h-full object-cover" onerror="this.parentNode.innerHTML=\`${fallbackHtml}\`">`;
				} else {
					// Initial with Physio Color
					photoContent = `<div class="w-full h-full flex items-center justify-center font-bold text-xl" style="background-color: ${pColor}20; color: ${pColor}">
                        ${(app.patient_name || "?").charAt(0).toUpperCase()}
                    </div>`;
				}

				const calcularEdad = (fechaNacimiento) => {
					if (!fechaNacimiento) return "?";
					const hoy = new Date();
					const nacimiento = new Date(fechaNacimiento);
					let edad = hoy.getFullYear() - nacimiento.getFullYear();
					const mes = hoy.getMonth() - nacimiento.getMonth();
					if (
						mes < 0 ||
						(mes === 0 && hoy.getDate() < nacimiento.getDate())
					)
						edad--;
					return edad;
				};

				const appData = JSON.stringify(app).replace(/"/g, "&quot;");

				// --- CONTAINER STYLE (Border left matches physio color) ---
				div.className = `p-4 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 group cursor-pointer relative overflow-hidden flex items-start gap-4 mb-3 bg-white`;
				div.style.borderLeft = `4px solid ${pColor}`;
				div.style.backgroundColor = `${pColor}05`; // Subtle tint

				div.onclick = () => {
					console.log("Click en cita:", app.id);
				};

				// Status Label Text (No Icon)
				let statusLabel = app.status || "Programada";
				if (status === "confirmed") statusLabel = "Confirmada";
				if (status === "wait") statusLabel = "En Espera";
				if (status === "canceled") statusLabel = "Cancelada";

				div.innerHTML = `
                    
                    <!-- Avatar Area -->
                    <div class="relative z-10 flex-shrink-0">
                        <div class="w-12 h-12 rounded-full overflow-hidden border border-white shadow-sm flex items-center justify-center cursor-pointer transition-transform group-hover:scale-105"
                             style="border-color: ${pColor}40"
                             onclick="event.stopPropagation(); window.openPhoto('${hasPhoto ? app.photo : ""}', '${app.patient_name}')">
                             ${photoContent}
                        </div>
                    </div>

                    <!-- Info Area -->
                    <div class="flex-1 relative z-10 min-w-0">
                        <div class="flex justify-between items-start">
                            <div class="min-w-0">
                                <h4 class="font-bold text-sm truncate text-gray-800">
                                    ${app.patient_name || "Sin Nombre"}
                                </h4>
                                <div class="text-xs text-gray-500 font-medium flex items-center gap-1 mt-0.5">
                                    <span>${calcularEdad(app.birthday)} años</span>
                                    <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                                    <span>${app.service_name || app.servicio || "Consulta"}</span>
                                </div>
                            </div>
                            
                            <!-- Simple Text Badge (No Icon) -->
                             <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-white/50 border border-gray-100 text-gray-500 flex-shrink-0 ml-2">
                                ${statusLabel}
                                    <i class="fa-solid fa-user-doctor" style="color: ${pColor}"></i>
                                    <span class="truncate font-medium" style="color: ${pColor}">${app.employed_name || "Fisio"}</span>
                                 </div>
                             </div>

                             <!-- Edit Button -->
                             <div class="flex items-center">
                                <button class="w-7 h-7 rounded-lg bg-white text-gray-400 hover:text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 border border-gray-100"
                                        style="--hover-color: ${pColor}"
                                        onmouseover="this.style.backgroundColor=this.style.getPropertyValue('--hover-color')"
                                        onmouseout="this.style.backgroundColor='white'"
                                        onclick='event.stopPropagation(); window.openEditModal(${appData})'
                                        title="Editar Cita">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                             </div>
                        </div>
                    </div>
                `;

				return div;
			}

			// --- Lógica del Formulario Crear Paciente (Con Foto) ---
			if (formPaciente) {
				formPaciente.addEventListener("submit", async (e) => {
					e.preventDefault();
					const formData = new FormData(formPaciente);
					const photoFile = formData.get("photo");
					formData.delete("photo");

					const data = Object.fromEntries(formData.entries());
					data.is_active = true;
					// if (!data.photo) data.photo = "uploads/images/default.png"; // Removed per user request

					try {
						const res = await fetch("/api/v1/Pacientes", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify(data),
						});

						if (res.ok) {
							const result = await res.json();
							// Subir foto si existe
							if (photoFile && photoFile.size > 0 && result.id) {
								try {
									const photoData = new FormData();
									photoData.append("photo", photoFile);
									await fetch(
										`/api/v1/Pacientes/${result.id}`,
										{
											method: "PATCH",
											body: photoData,
										},
									);
								} catch (e) {
									console.error("Error subiendo foto", e);
								}
							}

							alert("Paciente registrado correctamente");
							window.hideFormModal("modalCrearPaciente");
							formPaciente.reset();

							// Actualizar cache local (window.pacientesData)
							if (window.pacientesData) {
								window.pacientesData.push({
									...data,
									id: result.id,
									havepackage: false,
								});
							}

							// Abrir modal de cita y pre-seleccionar
							setTimeout(() => {
								window.showFormModal("modalAgregarCita");
								window.selectPatient(
									result.id,
									`${data.firstname} ${data.lastname}`,
									false,
								);
							}, 500);
						} else {
							alert("Error al registrar paciente");
						}
					} catch (e) {
						console.error(e);
						alert("Error de conexión");
					}
				});
			}

			// --- Lógica de Formulario Agregar/Editar Cita ---
			// --- Lógica de Formulario Agregar/Editar Cita ---
			// Cache for available slots (Moved here for scope access)
			let latestSlots = [];

			if (formAgregar) {
				formAgregar.addEventListener("submit", async (e) => {
					e.preventDefault();

					const isEdit = formAgregar.dataset.mode === "edit";
					const editId = formAgregar.dataset.editId;

					// Obtener valores (usando Ids directos)
					const idpatient =
						document.getElementById("agregarIdPatient").value;
					const currentday =
						document.getElementById("agregarCurrentday").value;
					const inithour =
						document.getElementById("agregarInitHour").value;
					const endhour =
						document.getElementById("agregarEndHour").value; // Opcional
					const idemployed =
						document.getElementById("agregarIdEmployed").value;
					const idservice =
						document.getElementById("agregarIdService").value;
					const status =
						document.getElementById("agregarStatus").value;
					const reason =
						document.getElementById("agregarReason").value;
					const idpackage =
						document.getElementById("agregarIdPackage").value;
					const usePackage =
						document.getElementById("usePackageCheckbox")?.checked;

					if (!idpatient || !currentday || !inithour || !status) {
						alert("Complete los campos obligatorios");
						return;
					}

					// Auto-assign Random Physio if missing (Logic from Empleado)
					let finalPhysioId = idemployed;

					if (!finalPhysioId) {
						// 1. Try Cache
						const matchingSlot = latestSlots.find(
							(s) =>
								s.inithour?.substring(0, 5) === inithour ||
								s.hora_disponible?.substring(0, 5) === inithour,
						);

						if (matchingSlot && matchingSlot.random_physio_id) {
							finalPhysioId = matchingSlot.random_physio_id;
						}

						// 2. Try DOM Attribute Fallback
						if (!finalPhysioId) {
							const hourSelect =
								document.getElementById("agregarInitHour");
							if (
								hourSelect &&
								hourSelect.selectedOptions.length > 0
							) {
								finalPhysioId =
									hourSelect.selectedOptions[0].getAttribute(
										"data-random-physio",
									);
							}
						}
					}

					if (!finalPhysioId) {
						alert(
							"Error: No se puede agendar. Por favor selecciona un fisioterapeuta manualmente o verifica que la hora tenga cupo.",
						);
						return;
					}
					// If still no physio in Admin, it might represent "Any" or backend handles it,
					// or we should alert. Admin allows manual selection, so if they leave it blank
					// and no random slot, maybe we send null? Backend likely requires it.
					// But we proceed as is.

					const payload = {
						idpatient,
						currentday,
						inithour,
						endhour: endhour || inithour,
						idemployed: finalPhysioId,
						status,
						reason,
						// idservice is handled separately in PATCH, do not include in main payload
					};

					try {
						let citaId = editId;

						if (isEdit) {
							// --- EDIT MODE (PATCH) ---
							const res = await fetch(`/api/v1/Citas/${editId}`, {
								method: "PATCH",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify(payload),
							});

							if (!res.ok)
								throw new Error("Error al actualizar cita");
							citaId = editId;

							// Update Service if changed
							if (idservice) {
								// For updates, we usually PATCH service separate
								let price = "0.00";
								if (!usePackage) {
									const sel =
										document.getElementById(
											"agregarIdService",
										);
									if (sel && sel.selectedIndex >= 0) {
										price =
											sel.options[
												sel.selectedIndex
											].getAttribute("data-price") || "0";
									}
								}
								await fetch(
									`/api/v1/Agenda/${citaId}/services`,
									{
										method: "PATCH",
										headers: {
											"Content-Type": "application/json",
										},
										body: JSON.stringify({
											serviceId: idservice,
											amount: 1,
											unit_price: price,
										}),
									},
								).catch((e) =>
									console.error("Service update warn:", e),
								);
							}

							alert("Cita actualizada correctamente");
						} else {
							// --- CREATE MODE (POST) ---

							// Lógica Paquete (Synced with Empleado)
							if (usePackage) {
								if (idpackage) {
									alert(
										"No puedes comprar un paquete nuevo y usar uno existente al mismo tiempo.",
									);
									return;
								}
								// Retrieve Active Package ID instead of consuming logic
								try {
									const pkgRes = await fetch(
										`/api/v1/Pacientes/${idpatient}/paquete/activo`,
									);
									if (pkgRes.ok) {
										const pkgData = await pkgRes.json();
										if (pkgData && pkgData.id) {
											payload.idpatientpackage =
												pkgData.id;
											console.log(
												"Paquete activo encontrado (Admin), ID:",
												pkgData.id,
											);
										}
									} else {
										console.warn(
											"No se encontró paquete activo o error",
										);
									}
								} catch (err) {
									console.error(err);
								}
							} else if (idpackage) {
								// Asignar nuevo paquete (Compra)
								const resAsig = await fetch(
									`/api/v1/Pacientes/${idpatient}/paquete`,
									{
										method: "POST",
										headers: {
											"Content-Type": "application/json",
										},
										body: JSON.stringify({
											idpackage,
										}),
									},
								);
								if (resAsig.ok) {
									const d = await resAsig.json();
									if (d.id) payload.idpatientpackage = d.id;
									// Update patient status local
									await fetch(
										`/api/v1/Pacientes/${idpatient}`,
										{
											method: "PATCH",
											headers: {
												"Content-Type":
													"application/json",
											},
											body: JSON.stringify({
												havepackage: true,
											}),
										},
									).catch(() => {});
								}
							}

							// Crear Cita
							const res = await fetch("/api/v1/Citas", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify(payload),
							});

							if (!res.ok) {
								const errText = await res.text();
								throw new Error(
									errText || "Error al crear cita",
								);
							}

							const data = await res.json();
							citaId =
								data.id ||
								data.insertId ||
								(data.data && data.data.id);

							// Asignar Servicio
							if (idservice && citaId) {
								// Calcular precio (0 si paquete)
								let price = "0.00";
								if (!usePackage) {
									const sel =
										document.getElementById(
											"agregarIdService",
										);
									price =
										sel.options[
											sel.selectedIndex
										].getAttribute("data-price") || "0";
								}

								await fetch(
									`/api/v1/Agenda/${citaId}/services`,
									{
										method: "POST",
										headers: {
											"Content-Type": "application/json",
										},
										body: JSON.stringify({
											serviceId: idservice,
											amount: 1,
											unit_price: price,
										}),
									},
								);
							}
							alert("Cita creada correctamente");
						}

						window.hideFormModal("modalAgregarCita");
						formAgregar.reset();
						// Refrescar Agenda
						if (typeof fetchAgenda === "function") {
							fetchAgenda(agendaDateInput.value);
						} else {
							window.location.reload();
						}
					} catch (e) {
						console.error(e);
						alert("Error: " + e.message);
					}
				});
			}

			// --- Lógica de Búsqueda de Pacientes ---
			const patientInput = document.getElementById("patientSearchInput");
			const patientResults = document.getElementById(
				"patientSearchResults",
			);
			const patientHiddenId = document.getElementById("agregarIdPatient");

			if (patientInput && patientResults) {
				const filterPatients = (query) => {
					const list = (window.pacientesData || [])
						.filter((p) =>
							(p.firstname + " " + p.lastname)
								.toLowerCase()
								.includes(query.toLowerCase()),
						)
						.slice(0, 20);

					if (list.length > 0) {
						patientResults.innerHTML = list
							.map(
								(p) => `
                            <div class="px-4 py-2 hover:bg-gray-100 cursor-pointer transition-colors border-b border-gray-50 last:border-0"
                                onclick="selectPatient('${p.id}', '${p.firstname} ${p.lastname}', ${p.havepackage === true}, '${p.idemployed || ""}')">
                                <div class="font-bold text-sm text-gray-800 flex items-center gap-2">
                                    ${p.firstname} ${p.lastname} ${p.motherlastname || ""}
                                    ${p.havepackage ? '<span class="px-1.5 py-0.5 bg-purple-100 text-purple-700 text-[10px] rounded-full border border-purple-200"><i class="fa-solid fa-box-open mr-1"></i>Paquete</span>' : ""}
                                </div>
                                <div class="text-xs text-gray-500">${p.email || "Sin email"}</div>
                            </div>
                        `,
							)
							.join("");
						patientResults.classList.remove("hidden");
					} else {
						patientResults.innerHTML =
							'<div class="p-2 text-sm text-gray-500">No encontrado</div>';
						patientResults.classList.remove("hidden");
					}
				};

				patientInput.addEventListener("input", (e) =>
					filterPatients(e.target.value),
				);
				// Ocultar al click fuera
				document.addEventListener("click", (e) => {
					if (
						!patientInput.contains(e.target) &&
						!patientResults.contains(e.target)
					) {
						patientResults.classList.add("hidden");
					}
				});
			}

			window.selectPatient = (id, name, hasPackage, idEmployed) => {
				if (patientHiddenId) {
					patientHiddenId.value = id;
					patientHiddenId.setAttribute(
						"data-id-employed",
						idEmployed || "",
					);
				}
				if (patientInput) patientInput.value = name;
				if (patientResults) patientResults.classList.add("hidden");
				handlePackageUI(hasPackage);

				// Auto-assign Employee
				if (
					idEmployed &&
					document.getElementById("agregarIdEmployed")
				) {
					document.getElementById("agregarIdEmployed").value =
						idEmployed;
				}

				updateHours();
			};

			window.handlePackageUI = (hasPackage) => {
				const badge = document.getElementById("packageBadge");
				const container = document.getElementById(
					"packageOptionContainer",
				);
				const checkbox = document.getElementById("usePackageCheckbox");

				if (hasPackage) {
					badge?.classList.remove("hidden");
					container?.classList.remove("hidden");
				} else {
					badge?.classList.add("hidden");
					container?.classList.add("hidden");
					if (checkbox) checkbox.checked = false;
				}
			};

			// --- Photo Modal ---
			window.openPhoto = (photo, name) => {
				const modal = document.getElementById("photoModal");
				const img = document.getElementById("photoModalImg");
				const title = document.getElementById("photoModalTitle");
				if (modal && img) {
					!photo || photo.includes("default")
						? "/default.png"
						: photo.startsWith("http")
							? photo
							: photo.startsWith("uploads") ||
								  photo.startsWith("/uploads")
								? photo.startsWith("/")
									? photo
									: "/" + photo
								: `/images/${photo}`;
					if (title) title.textContent = name;
					modal.classList.remove("hidden");
				}
			};
			window.closePhoto = () => {
				document.getElementById("photoModal")?.classList.add("hidden");
			};

			// --- Update Hours Logic (Fisioterapeuta / Fecha) ---
			const agendaPhysio = document.getElementById("agregarIdEmployed");
			const agendaCurrentDay =
				document.getElementById("agregarCurrentday");
			const agendaHour = document.getElementById("agregarInitHour");
			let isManualPhysioSearch = false;

			// Modified to accept an optional selectedTime to preserve/set value after load
			async function updateHours(selectedTime = null) {
				if (!agendaPhysio || !agendaCurrentDay || !agendaHour) return;

				const checkExtendido = document.getElementById(
					"checkHorarioExtendido",
				);
				if (checkExtendido && checkExtendido.checked) {
					agendaHour.innerHTML =
						'<option value="">Seleccionar hora</option>';
					agendaHour.disabled = false;

					for (let i = 1; i <= 23; i++) {
						const h = String(i).padStart(2, "0");
						const t1 = `${h}:00`;

						const opt1 = document.createElement("option");
						opt1.value = t1;
						opt1.textContent = t1;
						agendaHour.appendChild(opt1);
					}
					if (selectedTime) agendaHour.value = selectedTime;
					return;
				}

				const date = agendaCurrentDay.value;
				const physioId = agendaPhysio.value;
				const patientId =
					document.getElementById("agregarIdPatient")?.value;

				if (!date) {
					if (agendaHour) {
						agendaHour.innerHTML =
							'<option value="">Seleccione una fecha</option>';
						agendaHour.disabled = true;
					}
					return;
				}

				// Patient Dependency
				if (!patientId) {
					if (agendaHour) {
						agendaHour.innerHTML =
							'<option value="">Seleccione un paciente</option>';
						agendaHour.disabled = true;
					}
					return;
				}

				// Save current selection if not provided
				if (!selectedTime) selectedTime = agendaHour.value;

				agendaHour.innerHTML = "<option>Cargando...</option>";
				agendaHour.disabled = true;

				try {
					// Split Logic
					let url = "";
					if (physioId) {
						isManualPhysioSearch = true;
						url = `/api/v1/Agenda/${physioId}/${date}`;
					} else {
						isManualPhysioSearch = false;
						url = `/api/v1/Agenda/slots/${date}?idPatient=${patientId}`;
					}

					const res = await fetch(url);
					if (res.ok) {
						const slots = await res.json();
						latestSlots = Array.isArray(slots) ? slots : []; // Update cache
						agendaHour.innerHTML =
							'<option value="">Seleccionar hora</option>';

						// Add options
						latestSlots.forEach((slot) => {
							const time = slot.hora_disponible
								? slot.hora_disponible.substring(0, 5)
								: slot.inithour
									? slot.inithour.substring(0, 5)
									: null;

							// Availability check (Agenda uses is_available !== false)
							// Admin previously didn't check?
							const disponible = slot.is_available !== false;

							if (time && disponible) {
								const opt = document.createElement("option");
								opt.value = time;
								opt.textContent = time;

								// Metadata
								if (slot.idemployed) {
									opt.setAttribute(
										"data-idemployed",
										String(slot.idemployed),
									);
								}
								if (slot.endhour) {
									opt.setAttribute(
										"data-endhour",
										slot.endhour.substring(0, 5),
									);
								}

								// Compatibility with old logic if needed
								if (slot.random_physio_id) {
									opt.setAttribute(
										"data-random-physio",
										slot.random_physio_id,
									);
								}

								agendaHour.appendChild(opt);
							}
						});

						// Restore selection
						if (selectedTime) {
							let exists = Array.from(agendaHour.options).some(
								(o) => o.value === selectedTime,
							);
							if (!exists) {
								const opt = document.createElement("option");
								opt.value = selectedTime;
								opt.textContent = selectedTime + " (Actual)";
								agendaHour.appendChild(opt);
							}
							agendaHour.value = selectedTime;
						}

						if (agendaHour.options.length === 1 && !selectedTime) {
							agendaHour.innerHTML =
								'<option value="">Sin disponibilidad</option>';
						} else {
							agendaHour.disabled = false;
						}
					} else {
						agendaHour.innerHTML =
							'<option value="">Error al cargar</option>';
					}
				} catch (e) {
					console.error(e);
					agendaHour.innerHTML = "<option>Error</option>";
				}
			}

			if (agendaPhysio)
				agendaPhysio.addEventListener("change", () => updateHours());
			if (agendaCurrentDay)
				agendaCurrentDay.addEventListener("change", () =>
					updateHours(),
				);

			const checkExtendido = document.getElementById(
				"checkHorarioExtendido",
			);
			if (checkExtendido)
				checkExtendido.addEventListener("change", () => updateHours());

			// Listener para asignar automaticamente el fisio cuando se selecciona una hora
			// (Solo si la opcion tiene un data-random-physio y estamos en el contexto adecuado)
			// Listener para asignar automaticamente el fisio cuando se selecciona una hora
			if (agendaHour) {
				agendaHour.addEventListener("change", function () {
					const horaInicio = this.value;
					const selectedOption = this.options[this.selectedIndex];
					const datasetPhysio =
						selectedOption?.getAttribute("data-idemployed"); // or data-random-physio
					const datasetEndHour =
						selectedOption?.getAttribute("data-endhour");
					// Legacy/Fallback
					const randomPhysioId =
						selectedOption?.getAttribute("data-random-physio");

					const finalPhysio = datasetPhysio || randomPhysioId;

					if (finalPhysio && agendaPhysio && !isManualPhysioSearch) {
						agendaPhysio.value = finalPhysio;
					}

					// Auto-calc EndHour
					const horaFinInput =
						document.getElementById("agregarEndHour");

					if (horaInicio && horaFinInput) {
						if (datasetEndHour) {
							horaFinInput.value = datasetEndHour;
						} else {
							// Default + 1h
							const [h, m] = horaInicio.split(":").map(Number);
							const d = new Date();
							d.setHours(h);
							d.setMinutes(m);
							d.setHours(d.getHours() + 1);
							const hf =
								String(d.getHours()).padStart(2, "0") +
								":" +
								String(d.getMinutes()).padStart(2, "0");
							horaFinInput.value = hf;
						}
					}
				});
			}

			window.openEditModal = async (app) => {
				const modal = document.getElementById("modalAgregarCita");
				const form = document.getElementById("formAgregarCita");
				const submitBtn = form?.querySelector('button[type="submit"]');
				const title = document.getElementById("modalAgregarCita-title");

				if (!modal || !form) return;

				// Reset Form
				form.reset();
				form.dataset.mode = "edit";
				// Fix: Use correct ID property from app object (id or idappointment)
				form.dataset.editId = app.id || app.idappointment;

				// UI Updates
				if (title) title.innerText = "Editar Cita";
				if (submitBtn) submitBtn.innerText = "Actualizar Cita";

				// Populate Fields
				document.getElementById("agregarIdPatient").value =
					app.idpatient;
				document.getElementById("patientSearchInput").value =
					app.patient_name || "";

				// Date & Time
				const dateVal = app.currentday
					? app.currentday.substring(0, 10)
					: "";
				document.getElementById("agregarCurrentday").value = dateVal;

				// Physio
				if (app.idemployed) {
					document.getElementById("agregarIdEmployed").value =
						app.idemployed;
				} else if (app.employed_name && window.empleadosData) {
					// Fallback: Buscar por nombre completo
					// Nota: la comparación de strings es sensible.
					// Intentamos match con el formato "{firstname} {lastname}"
					const found = window.empleadosData.find(
						(e) =>
							`${e.firstname} ${e.lastname}`
								.toLowerCase()
								.trim() ===
							app.employed_name.toLowerCase().trim(),
					);
					if (found) {
						document.getElementById("agregarIdEmployed").value =
							found.id;
					}
				}

				// Status
				if (app.status) {
					document.getElementById("agregarStatus").value = app.status; // Ensure lowercase match
				}

				// Reason
				document.getElementById("agregarReason").value =
					app.reason || "";

				// Service
				if (app.idservice) {
					document.getElementById("agregarIdService").value =
						app.idservice;
				} else if (app.service_name && window.serviciosData) {
					// Fallback: Buscar por nombre
					const found = window.serviciosData.find(
						(s) =>
							s.name.toLowerCase().trim() ===
							app.service_name.toLowerCase().trim(),
					);
					if (found) {
						document.getElementById("agregarIdService").value =
							found.id;
					}
				}

				// Package UI (Assume no package logic change for edit currently, simplified)
				handlePackageUI(false);

				// Trigger Hours Update (and select current hour)
				const timeVal = app.inithour
					? app.inithour.substring(0, 5)
					: "";
				const endTimeVal = app.endhour
					? app.endhour.substring(0, 5)
					: "";

				if (dateVal) {
					// Await to ensure options are ready
					await updateHours(timeVal);

					const endHourInput =
						document.getElementById("agregarEndHour");
					if (endHourInput && endTimeVal) {
						endHourInput.value = endTimeVal;
					}
				} else {
					document.getElementById("agregarInitHour").value = timeVal;
					if (endTimeVal)
						document.getElementById("agregarEndHour").value =
							endTimeVal;
				}

				// Show Modal
				window.showFormModal("modalAgregarCita");
			};

			// Hook for Speed Dial New Appointment to reset to Create Mode
			window.addEventListener("open-new-appointment-modal", () => {
				if (formAgregar) {
					formAgregar.reset();
					formAgregar.dataset.mode = "create";
					delete formAgregar.dataset.editId;

					const submitBtn = formAgregar.querySelector(
						'button[type="submit"]',
					);
					const title = document.getElementById(
						"modalAgregarCita-title",
					);
					if (title) title.innerText = "Nueva Cita";
					if (submitBtn) submitBtn.innerText = "Agendar Cita";
				}
				window.showFormModal("modalAgregarCita");
				handlePackageUI(false);
			});

			window.addEventListener("open-new-patient-modal", () => {
				if (formPaciente) formPaciente.reset();
				window.showFormModal("modalCrearPaciente");
			});
		});
	</script>
</Layout>
