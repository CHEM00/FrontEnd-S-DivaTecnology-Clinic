---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import TopTag from "../components/TopTag.astro";
import FormModal from "../components/modals/FormModal.astro";
import { SERVER_BACKEND_URL } from "../config";
const today = new Date().toISOString().split("T")[0];
const backendUrl = SERVER_BACKEND_URL;
const token = Astro.cookies.get("auth_token")?.value;
const userRole = Astro.cookies.get("user_role")?.value;

// RBAC: If Employee (3) tries to access Admin Dashboard, redirect to their dashboard
if (userRole === "3") {
	return Astro.redirect("/dashboardEmpleado");
}

const headers = {
	"Content-Type": "application/json",
	...(token && { Cookie: `auth_token=${token}` }),
};

// We need to use a custom agent for self-signed certs if needed, similar to the proxy
// But native fetch in Node 18 might need 'rejectUnauthorized: false' via an agent if the backend is https self-signed
// However, for simplicity, let's try standard fetch first. If it fails with SSL error, we'll add the agent.
// Actually, since we had to add the agent in the proxy, we probably need it here too if the backend is the same.

const { Agent } = await import("node:https");
const agent = new Agent({ rejectUnauthorized: false });

let benefit = [];
let appointmentStatus = [{ citas: {} }];

// Fetch Data for Appointment Modal (Searchable Patient, etc.)
let pacientes = [];
let empleados = [];
let servicios = [];
let paquetes = [];
let adicionales = [];

try {
	const [
		pacientesRes,
		empleadosRes,
		serviciosRes,
		paquetesRes,
		adicionalesRes,
		resBenefit,
		resStatus,
	] = await Promise.all([
		fetch(`${backendUrl}/api/v1/Pacientes`, { headers, agent }).then(
			(res) => (res.ok ? res.json() : []),
		),
		fetch(`${backendUrl}/api/v1/Agenda/fisio`, { headers, agent }).then(
			(res) => (res.ok ? res.json() : []),
		),
		fetch(`${backendUrl}/api/v1/Agenda/services`, {
			headers,
			agent,
		}).then((res) => (res.ok ? res.json() : [])),
		fetch(`${backendUrl}/api/v1/Package`, { headers, agent }).then((res) =>
			res.ok ? res.json() : [],
		),
		fetch(`${backendUrl}/api/v1/Product_Service/additional`, {
			headers,
			agent,
		}).then((res) => (res.ok ? res.json() : [])),
		fetch(`${backendUrl}/api/v1/Benefit?date=${today}`, {
			headers,
			agent,
		}).then((res) => (res.ok ? res.json() : [])),
		fetch(`${backendUrl}/api/v1/AppointmentStatus?date=${today}`, {
			headers,
			agent,
		}).then((res) => (res.ok ? res.json() : [{ citas: {} }])),
	]);

	pacientes = pacientesRes || [];
	empleados = empleadosRes || [];
	servicios = serviciosRes || [];
	paquetes = paquetesRes || [];
	adicionales = adicionalesRes || [];
	benefit = resBenefit || [];
	appointmentStatus = resStatus || [{ citas: {} }];
} catch (error) {
	console.error("Error fetching dashboard data:", error);
}
---

<Layout title="Dashboard Administrador" showSpeedDial={true}>
	<div
		class="flex h-[100dvh] overflow-hidden bg-gradient-to-br from-[#F0F4F8] via-[#E6F0EA] to-[#F0F4F8]"
	>
		<NavBar />
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
			<!-- Background Elements for depth -->
			<div
				class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-[#2F5D50]/10 rounded-full blur-3xl pointer-events-none"
			>
			</div>
			<div
				class="absolute bottom-[-10%] left-[-5%] w-96 h-96 bg-[#2F5D50]/5 rounded-full blur-3xl pointer-events-none"
			>
			</div>

			<TopTag
				titulo="Dashboard Administrador"
				nombreUsuario="Administrador"
			/>

			<main
				class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scrollbar-thin scrollbar-thumb-[#2F5D50]/20 scrollbar-track-transparent relative z-10"
			>
				<!-- Grid Principal con mayor separación -->
				<div
					class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:h-full h-auto"
				>
					<!-- Columna Izquierda: Gráficos y Estadísticas (9 columnas) -->
					<div class="lg:col-span-9 flex flex-col gap-8 h-full">
						<!-- Fila Superior: Gráfico Principal -->
						<div
							class="glass-panel rounded-3xl p-8 h-[400px] lg:h-[32rem] flex flex-col relative overflow-hidden group hover:shadow-2xl transition-all duration-500 border border-white/60 !bg-white shadow-sm"
						>
							<div
								class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 z-10 gap-4 sm:gap-0 flex-shrink-0"
							>
								<div>
									<h2
										class="text-2xl font-bold text-[#2F5D50] tracking-tight flex items-center gap-3"
									>
										<div
											class="w-10 h-10 rounded-xl bg-[#2F5D50]/10 flex items-center justify-center"
										>
											<i
												class="fa-solid fa-chart-column text-[#2F5D50]"
											></i>
										</div>
										Venta de Adicionales
									</h2>
									<p class="text-sm text-gray-500 mt-1 ml-14">
										Rendimiento del equipo en tiempo real
									</p>
								</div>
								<div class="relative z-20 w-full sm:w-auto">
									<div
										class="flex flex-wrap sm:flex-nowrap gap-2"
									>
										<div
											class="relative group flex-1 sm:flex-none"
										>
											<input
												type="date"
												id="chart-date-start"
												class="glass-input rounded-xl px-4 py-2 text-sm font-bold text-[#2F5D50] outline-none focus:ring-2 focus:ring-[#2F5D50]/20 bg-white/50 w-full sm:w-36"
												title="Fecha Inicio"
											/>
											<div
												class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-[#2F5D50]"
											>
												<i
													class="fa-regular fa-calendar"
												></i>
											</div>
										</div>
										<div
											class="relative group flex-1 sm:flex-none"
										>
											<input
												type="date"
												id="chart-date-end"
												class="glass-input rounded-xl px-4 py-2 text-sm font-bold text-[#2F5D50] outline-none focus:ring-2 focus:ring-[#2F5D50]/20 bg-white/50 w-full sm:w-36"
												title="Fecha Fin (Opcional)"
											/>
											<div
												class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-[#2F5D50]"
											>
												<i
													class="fa-regular fa-calendar"
												></i>
											</div>
										</div>
										<div
											class="relative group w-full sm:w-auto"
										>
											<select
												id="chart-additional-filter"
												class="glass-input rounded-xl px-4 py-2 text-sm font-bold text-[#2F5D50] outline-none focus:ring-2 focus:ring-[#2F5D50]/20 bg-white/50 w-full sm:w-48 appearance-none cursor-pointer"
												title="Filtrar por Adicional"
											>
												<option value=""
													>Todos los Adicionales</option
												>
											</select>
										</div>
									</div>
								</div>
							</div>
							<div
								class="w-full flex-grow overflow-x-auto overflow-y-hidden z-10 min-h-0"
							>
								<div
									id="columnchart_material"
									class="w-full h-full min-w-[300px]"
								>
								</div>
							</div>
						</div>

						<!-- Nueva Sección: Tabla de Transacciones -->
						<div
							class="glass-panel rounded-3xl p-6 border border-white/60 !bg-white shadow-lg min-h-[18rem] flex flex-col flex-1"
						>
							<!-- Header with Stats -->
							<div
								class="flex flex-wrap justify-between items-center mb-6 gap-4 flex-shrink-0"
							>
								<div>
									<h2
										class="text-xl font-bold text-[#2F5D50] flex items-center gap-2"
									>
										<i class="fa-solid fa-table-list"></i>
										Detalle de Movimientos
									</h2>
									<p class="text-xs text-gray-500 ml-7">
										Transacciones del día
									</p>
								</div>

								<!-- Status Indicators (moved from Resumen) -->
								<div class="flex flex-wrap gap-3">
									{
										[
											{
												label: "Concluidas",
												count:
													appointmentStatus[0].citas
														.concluida || 0,
												color: "green",
												icon: "fa-check",
												id: "account-appointment-concluidas",
											},
											{
												label: "Confirmadas",
												count:
													appointmentStatus[0].citas
														.confirmada || 0,
												color: "blue",
												icon: "fa-thumbs-up",
												id: "account-appointment-confirmadas",
											},
											{
												label: "Pendientes",
												count:
													appointmentStatus[0].citas
														.espera || 0,
												color: "yellow",
												icon: "fa-clock",
												id: "account-appointment-pendientes",
											},
											{
												label: "Canceladas",
												count:
													appointmentStatus[0].citas
														.cancelada || 0,
												color: "red",
												icon: "fa-xmark",
												id: "account-appointment-canceladas",
											},
										].map((item) => (
											<div
												class={`px-3 py-1.5 rounded-lg bg-${item.color}-50 border border-${item.color}-100 flex items-center gap-2`}
											>
												<div
													class={`w-2 h-2 rounded-full bg-${item.color}-500`}
												/>
												<div
													class={`text-xs font-bold text-${item.color}-700 flex gap-1`}
												>
													<span>{item.label}:</span>
													<span id={item.id}>
														{item.count}
													</span>
												</div>
											</div>
										))
									}

									<!-- Vertical Divider -->
									<div class="h-6 w-px bg-gray-200 mx-1">
									</div>

									<!-- Total del Día Badge -->
									<div
										class="px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-100 flex items-center gap-2"
									>
										<div
											class="w-2 h-2 rounded-full bg-emerald-500"
										>
										</div>
										<div
											class="text-xs font-bold text-emerald-700 flex gap-1"
										>
											<span>Total:</span>
											<span id="total-income-display"
												>$0.00</span
											>
										</div>
									</div>

									<!-- Date Filter Input Replacement -->
									<div
										class="px-2 py-0.5 rounded-lg bg-gray-50 border border-gray-200 flex items-center gap-2 shadow-sm focus-within:ring-2 focus-within:ring-[#2F5D50]/20 transition-all"
									>
										<i
											class="fa-regular fa-calendar text-xs text-gray-400"
										></i>
										<input
											type="date"
											id="filter-date-stats"
											class="bg-transparent border-none outline-none text-xs font-bold text-gray-700 w-24 p-0 cursor-pointer"
										/>
									</div>
								</div>
							</div>

							<!-- Table -->
							<div
								class="overflow-x-auto custom-scrollbar rounded-2xl border border-[#2F5D50]/10"
							>
								<table class="w-full text-left border-collapse">
									<thead>
										<tr
											class="bg-[#2F5D50]/5 text-[#2F5D50] border-b border-[#2F5D50]/10 text-xs uppercase"
										>
											<th class="p-3 font-bold"
												>Paciente</th
											>
											<th class="p-3 font-bold"
												>Servicio</th
											>
											<th class="p-3 font-bold"
												>Adicionales</th
											>
											<th class="p-3 font-bold">Fisio</th>
											<th class="p-3 font-bold text-right"
												>Subtotal</th
											>
											<th class="p-3 font-bold text-right"
												>Desc.</th
											>
											<th class="p-3 font-bold text-right"
												>Total</th
											>
											<th
												class="p-3 font-bold text-center"
												>Pago</th
											>
										</tr>
									</thead>
									<tbody
										id="transaction-table-body"
										class="divide-y divide-[#2F5D50]/5 text-sm text-gray-600"
									>
										<!-- Content will be injected via JS -->
									</tbody>
								</table>
							</div>
						</div>
					</div>

					<script is:inline>
						// Global function to save transaction (called from inline onchange)
						function saveTransaction(element, field, id) {
							const container = element.parentElement;
							const indicator =
								container.querySelector(".save-indicator");

							// 1. Show Loading State (Spinner)
							if (indicator) {
								indicator.innerHTML =
									'<i class="fa-solid fa-circle-notch fa-spin text-gray-400"></i>';
								indicator.classList.remove("opacity-0");
							}

							// Simulating API Call
							console.log(
								`[Admin Save] Saving ${field} for Transaction #${id}: ${element.value}`,
							);

							// Mock Delay
							setTimeout(() => {
								// 2. Show Success
								if (indicator) {
									indicator.innerHTML =
										'<i class="fa-solid fa-check text-green-500"></i>';

									// Hide after 2 seconds
									setTimeout(() => {
										indicator.classList.add("opacity-0");
									}, 2000);
								}

								// Special styling logic for selects
								if (field === "payment_type") {
									updateSelectStyle(element);
								}
							}, 800);
						}

						function updateSelectStyle(select) {
							// Remove old color classes
							select.className = select.className.replace(
								/bg-\w+-50 text-\w+-700 border-\w+-100/g,
								"",
							);

							// Add new based on value
							let color = "gray";
							switch (select.value) {
								case "card":
									color = "blue";
									break;
								case "cash":
									color = "green";
									break;
								case "transfer":
									color = "purple";
									break;
								case "pending":
									color = "yellow";
									break;
							}

							select.classList.add(
								`bg-${color}-50`,
								`text-${color}-700`,
								`border-${color}-100`,
							);
						}

						// Function to update the table
						window.updateTransactionTable = async (date) => {
							const tbody = document.getElementById(
								"transaction-table-body",
							);
							if (!tbody) return;

							tbody.innerHTML =
								'<tr><td colspan="8" class="p-4 text-center"><i class="fa-solid fa-circle-notch fa-spin text-2xl text-[#2F5D50]"></i></td></tr>';

							try {
								const res = await fetch(
									`/api/v1/DashboardAdmin/DetailAppointments?date=${date}`,
								);
								if (!res.ok)
									throw new Error(
										"Failed to fetch transactions",
									);
								const data = await res.json();

								tbody.innerHTML = "";

								if (data && data.length > 0) {
									// Calcular Total del Día
									const totalDay = data.reduce(
										(acc, item) =>
											acc + parseFloat(item.total || 0),
										0,
									);
									const totalDisplayEl =
										document.getElementById(
											"total-income-display",
										);
									if (totalDisplayEl)
										totalDisplayEl.textContent = `$${totalDay.toFixed(2)}`;

									data.forEach((item) => {
										const tr = document.createElement("tr");
										tr.className =
											"group hover:bg-gray-50 transition-colors";

										// Defaults requested by user
										const discountVal = "0.00";
										const paymentVal = "pending"; // Default pending
										// For Subtotal, usually Total = Subtotal - Discount.
										// Since Discount default is 0, Subtotal display = Total from API for now.
										const subtotalDisplay = item.total;
										const totalDisplay = item.total;

										tr.innerHTML = `
											<td class="p-3 font-bold text-gray-800">${item.patient_name}</td>
											<td class="p-3">${item.service_name}</td>
											<td class="p-3 text-xs">${item.additional_services || "-"}</td>
											<td class="p-3 text-[#2F5D50] font-medium">${item.physio_name}</td>
											<td class="p-3 text-right font-mono">$${subtotalDisplay}</td>
											<td class="p-3 text-right">
												<div class="relative w-24 ml-auto">
													<input
														type="text"
														value="${discountVal}"
														class="w-full text-right bg-gray-50 border border-gray-200 rounded-lg px-2 py-1 text-xs focus:ring-2 focus:ring-[#2F5D50]/20 focus:border-[#2F5D50] outline-none transition-all"
														onblur="saveTransaction(this, 'discount', '${item.appointment_id}')"
													/>
													<div class="save-indicator absolute -right-4 top-1/2 -translate-y-1/2 text-xs opacity-0 transition-opacity">
														<i class="fa-solid fa-check text-green-500"></i>
													</div>
												</div>
											</td>
											<td class="p-3 text-right font-bold text-gray-800 font-mono total-cell">$${totalDisplay}</td>
											<td class="p-3 text-center">
												<div class="relative w-32 mx-auto">
													<select
														class="w-full bg-yellow-50 text-yellow-700 border border-yellow-100 rounded-lg px-2 py-1 text-xs font-bold focus:ring-2 focus:ring-yellow-500/20 outline-none appearance-none text-center cursor-pointer transition-all hover:bg-yellow-100"
														onchange="saveTransaction(this, 'payment_type', '${item.appointment_id}')"
													>
														<option value="card">Tarjeta</option>
														<option value="cash">Efectivo</option>
														<option value="transfer">Transferencia</option>
														<option value="pending" selected>Pendiente</option>
													</select>
													<div class="save-indicator absolute -right-5 top-1/2 -translate-y-1/2 text-xs opacity-0 transition-opacity">
														<i class="fa-solid fa-check text-green-500"></i>
													</div>
												</div>
											</td>
										`;
										tbody.appendChild(tr);
									});
								} else {
									tbody.innerHTML =
										'<tr><td colspan="8" class="p-4 text-center text-gray-400">No hay movimientos registrados</td></tr>';
									// Reset total
									const totalDisplayEl =
										document.getElementById(
											"total-income-display",
										);
									if (totalDisplayEl)
										totalDisplayEl.textContent = `$0.00`;
								}
							} catch (error) {
								console.error(
									"Error loading transactions:",
									error,
								);
								tbody.innerHTML =
									'<tr><td colspan="8" class="p-4 text-center text-red-400">Error al cargar datos</td></tr>';
								const totalDisplayEl = document.getElementById(
									"total-income-display",
								);
								if (totalDisplayEl)
									totalDisplayEl.textContent = `$0.00`;
							}
						};
					</script>

					<!-- Columna Derecha: Citas en Curso (3 columnas) -->
					<div class="lg:col-span-3 h-full min-h-[600px]">
						<div
							class="glass-panel rounded-3xl flex flex-col h-full overflow-hidden border border-white/60 !bg-white shadow-xl"
						>
							<div
								class="p-6 border-b border-[#2F5D50]/10 bg-white/40 backdrop-blur-md sticky top-0 z-20"
							>
								<div
									class="flex justify-between items-center mb-6"
								>
									<h2
										class="text-xl font-bold text-[#2F5D50] flex items-center gap-2"
									>
										<i class="fa-regular fa-calendar-days"
										></i>
										Agenda del Día
									</h2>
									<button
										class="w-10 h-10 rounded-xl bg-white/50 hover:bg-[#2F5D50] hover:text-white flex items-center justify-center text-[#2F5D50] transition-all shadow-sm"
									>
										<i class="fa-solid fa-filter"></i>
									</button>
								</div>
								<div class="relative group flex-1">
									<input
										type="date"
										id="appointment-date-calendar"
										class="w-full glass-input rounded-xl px-4 py-3 text-sm font-bold text-gray-700 outline-none focus:ring-2 focus:ring-[#2F5D50]/20 transition-all"
									/>
									<div
										class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-[#2F5D50] group-hover:scale-110 transition-transform"
									>
										<i class="fa-regular fa-calendar"></i>
									</div>
								</div>
								<!-- Buscador de Pacientes -->
								<div class="relative group mt-3 flex-1">
									<input
										type="text"
										id="appointment-search-client"
										placeholder="Buscar paciente..."
										class="w-full glass-input rounded-xl px-4 py-3 text-sm font-bold text-gray-700 outline-none focus:ring-2 focus:ring-[#2F5D50]/20 transition-all"
									/>
									<div
										class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-[#2F5D50] group-hover:scale-110 transition-transform"
									>
										<i class="fa-solid fa-magnifying-glass"
										></i>
									</div>
								</div>
								<div
									id="appointment-search-results"
									class="absolute top-full left-0 right-0 bg-white rounded-xl shadow-lg mt-2 max-h-48 overflow-y-auto hidden z-50 border border-gray-100"
								>
								</div>
							</div>
							<div
								class="flex-1 overflow-y-auto custom-scrollbar p-6 relative"
							>
								<div
									id="loading-agenda"
									class="absolute inset-0 flex items-center justify-center bg-white/80 z-10 hidden"
								>
									<i
										class="fa-solid fa-circle-notch fa-spin text-3xl text-[#2F5D50]"
									></i>
								</div>
								<div
									id="agenda-list-container"
									class="space-y-4"
								>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
	</div>

	<!-- Este script se encarga de cargar el grafico de barras -->
	<script
		type="text/javascript"
		src="https://www.gstatic.com/charts/loader.js"></script>
	<script is:inline type="text/javascript">
		google.charts.load("current", { packages: ["corechart", "bar"] });
		google.charts.setOnLoadCallback(initChart);

		let cachedChartData = []; // Cache for resize events

		function initChart() {
			const startDateInput = document.getElementById("chart-date-start");
			const endDateInput = document.getElementById("chart-date-end");
			const additionalSelect = document.getElementById(
				"chart-additional-filter",
			);

			// Populate Select
			if (additionalSelect) {
				window.adicionalesData.forEach((add) => {
					const opt = document.createElement("option");
					opt.value = add.id;
					opt.textContent = add.name;
					additionalSelect.appendChild(opt);
				});
			}

			if (startDateInput && endDateInput) {
				const today = new Date(
					Date.now() - new Date().getTimezoneOffset() * 60000,
				)
					.toISOString()
					.split("T")[0];
				startDateInput.value = today;

				// Initial draw
				fetchAndDrawChart(today, today, "");

				// Add listeners
				startDateInput.addEventListener("change", () => {
					fetchAndDrawChart(
						startDateInput.value,
						endDateInput.value,
						additionalSelect?.value,
					);
				});

				endDateInput.addEventListener("change", () => {
					fetchAndDrawChart(
						startDateInput.value,
						endDateInput.value,
						additionalSelect?.value,
					);
				});

				additionalSelect?.addEventListener("change", () => {
					fetchAndDrawChart(
						startDateInput.value,
						endDateInput.value,
						additionalSelect.value,
					);
				});
			}
		}

		async function fetchAndDrawChart(
			startDate,
			endDate,
			idAdditional = "",
		) {
			try {
				let url = `/api/v1/AdditionalSales?start=${startDate}`;
				if (endDate) {
					url += `&end=${endDate}`;
				} else {
					url += `&end=${startDate}`;
				}

				if (idAdditional) {
					url += `&idAdditional=${idAdditional}`;
				}

				const res = await fetch(url);
				if (!res.ok) throw new Error("Failed to fetch chart data");
				const apiData = await res.json();
				cachedChartData = apiData; // Update cache
				drawChart(cachedChartData);
			} catch (error) {
				console.error("Error loading chart data:", error);
				cachedChartData = [];
				drawChart([]);
			}
		}

		const physioColorsChart = [];

		function getPhysioColor(name, id) {
			// Try to use ID first to match Cards
			if (id) {
				const numId = parseInt(id, 10);
				if (!isNaN(numId)) {
					return physioColorsChart[numId % physioColorsChart.length];
				}
			}

			// Fallback: Hash name if no ID
			if (!name) return "#9ca3af";
			let hash = 0;
			for (let i = 0; i < name.length; i++) {
				hash = name.charCodeAt(i) + ((hash << 5) - hash);
			}
			const index = Math.abs(hash) % physioColorsChart.length;
			return physioColorsChart[index];
		}

		function drawChart(apiData) {
			// Change format to: [Label, Value, Style]
			// This puts names on Axis and allows individual bar colors
			const dataArray = [["Fisioterapeuta", "Ventas", { role: "style" }]];

			if (apiData && apiData.length > 0) {
				apiData.forEach((item) => {
					const name = item.empleado_nombre || "Desconocido";
					const val = Number(item.total_adicionales) || 0;
					const color = getPhysioColor(name);
					dataArray.push([name, val, color]);
				});
			} else {
				dataArray.push(["Sin datos", 0, "#e5e7eb"]);
			}

			var data = google.visualization.arrayToDataTable(dataArray);

			var options = {
				title: "",
				bar: { groupWidth: "50%" },
				legend: { position: "none" },
				vAxis: {
					format: "decimal",
					textStyle: {
						color: "#6b7280",
						fontName: "Inter",
						fontSize: 12,
					},
					gridlines: { color: "#f3f4f6" },
				},
				hAxis: {
					textStyle: {
						color: "#374151",
						fontName: "Inter",
						fontSize: 12,
						bold: true,
					},
				},
				height: "100%",
				backgroundColor: "transparent",
				animation: {
					startup: true,
					duration: 800,
					easing: "out",
				},
				chartArea: { width: "90%", height: "80%", bottom: 40 },
			};

			var chart = new google.visualization.ColumnChart(
				document.getElementById("columnchart_material"),
			);

			chart.draw(data, options);
		}

		// Debounced Resize Listener that uses CACHE
		let resizeTimeout;
		window.addEventListener("resize", () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(() => {
				if (cachedChartData.length > 0) {
					drawChart(cachedChartData);
				}
			}, 200);
		});
	</script>

	<!-- Este script se encarga de actualizar el valor de ingresos acorde a la fecha seleccionada. -->
